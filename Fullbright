local plugin = {
    ["PluginName"] = "FullBright & NoFog";
    ["PluginDescription"] = "Membuat game terang benderang dan menghapus semua kabut.";
    ["Commands"] = {
        ["fullbright"] = {
            ["ListName"] = "fullbright",
            ["Description"] = "Menerangkan pencahayaan game dan menghapus kabut.",
            ["Aliases"] = {"fb", "nofog"},
            ["Function"] = function(args, speaker)
                local Lighting = game:GetService("Lighting")
                local RunService = game:GetService("RunService")

                -- Inisialisasi status global jika belum ada
                if _G.FBNoFogEnabled == nil then
                    _G.FBNoFogEnabled = false
                end

                -- Balikkan status (Toggle ON/OFF)
                _G.FBNoFogEnabled = not _G.FBNoFogEnabled

                if _G.FBNoFogEnabled then
                    -- Simpan settingan normal awal jika belum pernah disimpan
                    if not _G.NormalLightingSettings then
                        _G.NormalLightingSettings = {
                            Brightness = Lighting.Brightness,
                            ClockTime = Lighting.ClockTime,
                            FogEnd = Lighting.FogEnd,
                            FogStart = Lighting.FogStart,
                            GlobalShadows = Lighting.GlobalShadows,
                            Ambient = Lighting.Ambient
                        }
                    end

                    -- Jalankan loop penjaga agar settingan tidak bisa di-reset oleh map
                    if not _G.FBNoFogConnection then
                        _G.FBNoFogConnection = RunService.RenderStepped:Connect(function()
                            if _G.FBNoFogEnabled then
                                Lighting.Brightness = 2
                                Lighting.ClockTime = 14
                                Lighting.FogEnd = 999999 -- Membuat jarak kabut jadi sangat jauh (hilang)
                                Lighting.FogStart = 0
                                Lighting.GlobalShadows = false
                                Lighting.Ambient = Color3.fromRGB(200, 200, 200)
                            end
                        end)
                    end
                    print("[FullBright & NoFog] Diaktifkan!")
                else
                    -- Matikan loop penjaga
                    if _G.FBNoFogConnection then
                        _G.FBNoFogConnection:Disconnect()
                        _G.FBNoFogConnection = nil
                    end

                    -- Kembalikan ke settingan normal awal game
                    if _G.NormalLightingSettings then
                        Lighting.Brightness = _G.NormalLightingSettings.Brightness
                        Lighting.ClockTime = _G.NormalLightingSettings.ClockTime
                        Lighting.FogEnd = _G.NormalLightingSettings.FogEnd
                        Lighting.FogStart = _G.NormalLightingSettings.FogStart
                        Lighting.GlobalShadows = _G.NormalLightingSettings.GlobalShadows
                        Lighting.Ambient = _G.NormalLightingSettings.Ambient
                    end
                    print("[FullBright & NoFog] Dimatikan, kembali ke normal.")
                end
            end,
        },
    }
}

return plugin
