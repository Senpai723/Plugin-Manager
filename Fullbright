local Plugin = {
	["PluginName"] = "Full Bright",
	["PluginDescription"] = "Makes the game bright",
	["Commands"] = {
		["fullbright"] = {
			["Description"] = "Makes the game bright",
			["Aliases"] = {'fb', 'fullb'},
			["Function"] = function(args, speaker)
				local Lighting = game:GetService("Lighting")
				
				-- Inisialisasi status global jika belum ada
				if _G.FullBrightEnabled == nil then
					_G.FullBrightEnabled = false
				end

				-- Balikkan status (Toggle ON/OFF)
				_G.FullBrightEnabled = not _G.FullBrightEnabled

				if _G.FullBrightEnabled then
					-- Simpan settingan normal jika belum pernah disimpan
					if not _G.NormalLightingSettings then
						_G.NormalLightingSettings = {
							Brightness = Lighting.Brightness,
							ClockTime = Lighting.ClockTime,
							FogEnd = Lighting.FogEnd,
							GlobalShadows = Lighting.GlobalShadows,
							Ambient = Lighting.Ambient
						}
					end

					-- Nyalakan loop penjaga pencahayaan agar map tidak bisa meresetnya
					if not _G.FullBrightConnection then
						_G.FullBrightConnection = game:GetService("RunService").RenderStepped:Connect(function()
							if _G.FullBrightEnabled then
								Lighting.Brightness = 1
								Lighting.ClockTime = 12
								Lighting.FogEnd = 786543
								Lighting.GlobalShadows = false
								Lighting.Ambient = Color3.fromRGB(178, 178, 178)
							end
						end)
					end
					print("[FullBright] Diaktifkan!")
				else
					-- Matikan penjaga (Loop)
					if _G.FullBrightConnection then
						_G.FullBrightConnection:Disconnect()
						_G.FullBrightConnection = nil
					end

					-- Kembalikan ke settingan normal awal game
					if _G.NormalLightingSettings then
						Lighting.Brightness = _G.NormalLightingSettings.Brightness
						Lighting.ClockTime = _G.NormalLightingSettings.ClockTime
						Lighting.FogEnd = _G.NormalLightingSettings.FogEnd
						Lighting.GlobalShadows = _G.NormalLightingSettings.GlobalShadows
						Lighting.Ambient = _G.NormalLightingSettings.Ambient
					end
					print("[FullBright] Dimatikan!")
				end
			end,
		},
	},
}

return Plugin
