local Plugin = {
    ["PluginName"] = "MUSIC TIME",
    ["PluginDescription"] = "Plays audio by using ID from roblox store.",
    ["Commands"] = {
        ["playmusic"] = {
            ["ListName"] = "playmusic [id] (pitch) (volume)",
            ["Description"] = "Plays audio by using ID from roblox store",
            ["Aliases"] = {"mplay", "playm"},
            ["Function"] = function(args, speaker)
                -- Matikan dulu semua musik yang mungkin masih nyangkut
                for _, obj in ipairs(workspace:GetDescendants()) do
                    if obj:IsA("Sound") and (obj.SoundId:find("6729922069") or obj.IsPlaying) then
                        pcall(function() obj:Stop(); obj:Destroy() end)
                    end
                end

                local g = Instance.new("Sound")
                local Content = game:GetService("ContentProvider")
                g.Parent = workspace

                g.SoundId = args[1] and ("rbxassetid://" .. args[1]) or "rbxassetid://6729922069"
                g.Volume = tonumber(args[3]) or 1
                g.Pitch = tonumber(args[2]) or 1

                Content:PreloadAsync({g})
                g:Play()

                task.spawn(function()
                    task.wait(g.TimeLength + 1)
                    pcall(function() g:Destroy() end)
                end)
            end
        },
        ["stopmusic"] = {
            ["ListName"] = "stopmusic",
            ["Description"] = "Stops audio immediately",
            ["Aliases"] = {"mstopm", "mstopmusic"},
            ["Function"] = function(args, speaker)
                -- PERBAIKAN: Paksa sapu bersih semua Sound yang aktif di workspace agar tidak ada yang lolos!
                for _, obj in ipairs(workspace:GetDescendants()) do
                    if obj:IsA("Sound") then
                        pcall(function()
                            obj:Stop()
                            obj:Destroy()
                        end)
                    end
                end
            end
        }
    }
}

return Plugin
