local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local Workspace = game:GetService("Workspace")
local CoreGui = game:GetService("CoreGui")
local LocalPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera

-- GLOBAL STATE UNTUK SPECTATE & MUTE SOUND
_G.__SpectateState = _G.__SpectateState or {
    isSpectating = false,
    spectateTarget = nil,
    targetIndex = 1,
    conn = nil,
    uiGui = nil
}

_G.__VoiceSpyMuteState = _G.__VoiceSpyMuteState or {
    enabled = false,
    mutedSounds = {},
    connections = {},
    addedConn = nil
}

local state = _G.__SpectateState
local muteState = _G.__VoiceSpyMuteState

-- DAFTAR WHITELIST SUARA YANG BOLEH DIBUNYIKAN
local ALLOWED_KEYWORDS = {
    "checkpoint", "respawn", "cp", "pos", "pospemeriksaan", 
    "uuhh", "oof", "gettingup", "music", "radio", "boombox", 
    "jukebox", "song", "soundtrack", "bgm", "audio"
}

local function isAllowedSound(sound)
    if not sound or not sound:IsA("Sound") then return end
    local name = string.lower(sound.Name or "")
    for _, kw in ipairs(ALLOWED_KEYWORDS) do
        if string.find(name, kw, 1, true) then return true end
    end
    return false
end

local function applyMute(sound)
    if not muteState.enabled or not sound or not sound:IsA("Sound") then return end
    if isAllowedSound(sound) then return end

    if muteState.mutedSounds[sound] == nil then
        muteState.mutedSounds[sound] = sound.Volume
    end

    sound.Volume = 0

    if not muteState.connections[sound] then
        muteState.connections[sound] = sound:GetPropertyChangedSignal("Volume"):Connect(function()
            if muteState.enabled and sound.Parent and not isAllowedSound(sound) then
                sound.Volume = 0
            end
        end)
    end
end

-- FUNGSI UNTUK MEMBUAT UI TOMBOL PANAH KIRI KANAN & NAMA PLAYER
local nameLabelRef = nil

local function createSpectateUI(onPrev, onNext, onExit)
    if state.uiGui then
        state.uiGui:Destroy()
        state.uiGui = nil
    end

    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "SpectateOverlayUI"
    ScreenGui.ResetOnSpawn = false
    
    local parentOk = pcall(function()
        ScreenGui.Parent = CoreGui
    end)
    if not parentOk then
        ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
    end

    local MainContainer = Instance.new("Frame")
    MainContainer.Size = UDim2.new(0, 320, 0, 50)
    MainContainer.Position = UDim2.new(0.5, -160, 1, -80)
    MainContainer.BackgroundTransparency = 1
    MainContainer.Parent = ScreenGui

    -- Tombol Kiri (<)
    local PrevBtn = Instance.new("TextButton")
    PrevBtn.Size = UDim2.new(0, 50, 0, 40)
    PrevBtn.Position = UDim2.new(0, 0, 0, 5)
    PrevBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    PrevBtn.BackgroundTransparency = 0.3
    PrevBtn.BorderSizePixel = 0
    PrevBtn.Font = Enum.Font.GothamBold
    PrevBtn.Text = "<"
    PrevBtn.TextColor3 = Color3.fromRGB(0, 255, 150)
    PrevBtn.TextSize = 20
    PrevBtn.Parent = MainContainer
    Instance.new("UICorner", PrevBtn).CornerRadius = UDim.new(0, 8)

    -- Kotak Nama Player di Tengah
    local NameBox = Instance.new("Frame")
    NameBox.Size = UDim2.new(0, 190, 0, 40)
    NameBox.Position = UDim2.new(0, 55, 0, 5)
    NameBox.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    NameBox.BackgroundTransparency = 0.3
    NameBox.BorderSizePixel = 0
    NameBox.Parent = MainContainer
    Instance.new("UICorner", NameBox).CornerRadius = UDim.new(0, 8)

    local NameLabel = Instance.new("TextLabel")
    NameLabel.Size = UDim2.new(1, 0, 1, 0)
    NameLabel.BackgroundTransparency = 1
    NameLabel.Font = Enum.Font.GothamBold
    NameLabel.Text = "Menunggu Target..."
    NameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    NameLabel.TextSize = 14
    NameLabel.Parent = NameBox
    nameLabelRef = NameLabel

    -- Tombol Kanan (>)
    local NextBtn = Instance.new("TextButton")
    NextBtn.Size = UDim2.new(0, 50, 0, 40)
    NextBtn.Position = UDim2.new(1, -50, 0, 5)
    NextBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    NextBtn.BackgroundTransparency = 0.3
    NextBtn.BorderSizePixel = 0
    NextBtn.Font = Enum.Font.GothamBold
    NextBtn.Text = ">"
    NextBtn.TextColor3 = Color3.fromRGB(0, 255, 150)
    NextBtn.TextSize = 20
    NextBtn.Parent = MainContainer
    Instance.new("UICorner", NextBtn).CornerRadius = UDim.new(0, 8)

    PrevBtn.MouseButton1Click:Connect(onPrev)
    NextBtn.MouseButton1Click:Connect(onNext)

    state.uiGui = ScreenGui
end

local function updateSpectateUItext(text)
    if nameLabelRef and nameLabelRef.Parent then
        nameLabelRef.Text = text
    end
end

local function stopSpectate()
    state.isSpectating = false
    state.spectateTarget = nil

    if state.conn then
        state.conn:Disconnect()
        state.conn = nil
    end

    if state.uiGui then
        state.uiGui:Destroy()
        state.uiGui = nil
    end

    pcall(function()
        Camera.CameraType = Enum.CameraType.Custom
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
            Camera.CameraSubject = LocalPlayer.Character.Humanoid
        end
    end)
    print("[Spectate] Keluar dari mode spectate.")
end

local function startSpectate(targetPlayer)
    if not targetPlayer or not targetPlayer.Character then
        print("[Spectate] Target tidak valid!")
        return
    end

    state.spectateTarget = targetPlayer
    state.isSpectating = true

    updateSpectateUItext(targetPlayer.Name)

    if state.conn then
        state.conn:Disconnect()
    end

    -- Gunakan RenderStepped agar kamera mengikuti posisi target tapi bebas digeser 3D
    Camera.CameraType = Enum.CameraType.Custom
    state.conn = RunService.RenderStepped:Connect(function()
        if not state.isSpectating or not state.spectateTarget or not state.spectateTarget.Character then
            return
        end
        local char = state.spectateTarget.Character
        local head = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
        if head then
            -- Set CameraSubject ke Humanoid target supaya bebas diputar-putar
            local hum = char:FindFirstChild("Humanoid")
            if hum and Camera.CameraSubject ~= hum then
                Camera.CameraSubject = hum
            end
        end
    end)

    print("[Spectate] Sedang melihat: " .. targetPlayer.Name)
end

local function getOtherPlayers()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            table.insert(list, p)
        end
    end
    return list
end

local function cycleTarget(direction)
    local players = getOtherPlayers()
    if #players == 0 then return end

    -- Cari index target saat ini
    local currentIndex = 1
    for i, p in ipairs(players) do
        if p == state.spectateTarget then
            currentIndex = i
            break
        end
    end

    currentIndex = currentIndex + direction
    if currentIndex > #players then
        currentIndex = 1
    elseif currentIndex < 1 then
        currentIndex = #players
    end

    startSpectate(players[currentIndex])
end

local Plugin = {
    ["PluginName"] = "Spectate & MuteManager",
    ["PluginDescription"] = "Spectate player dengan UI tombol panah interaktif",
    ["Commands"] = {
        ["spectate"] = {
            ["ListName"] = "spectate [nama_player (opsional)]",
            ["Description"] = "Spectate target dengan tombol UI interaktif kiri/kanan",
            ["Aliases"] = {"spec", "view"},
            ["Function"] = function(args, speaker)
                local targetName = args[1]
                local players = getOtherPlayers()

                if #players == 0 then
                    print("[Spectate] Tidak ada player lain di server!")
                    return
                end

                local foundTarget = nil

                if not targetName or targetName == "" then
                    -- Kalau cuma ketik 'spectate', ambil player pertama atau lanjutkan yang aktif
                    if state.spectateTarget then
                        foundTarget = state.spectateTarget
                    else
                        foundTarget = players[1]
                    end
                else
                    local targetLower = string.lower(targetName)
                    for _, p in ipairs(players) do
                        if string.find(string.lower(p.Name), targetLower, 1, true) or string.find(string.lower(p.DisplayName or ""), targetLower, 1, true) then
                            foundTarget = p
                            break
                        end
                    end
                end

                if not foundTarget then
                    print("[Spectate] Player tidak ditemukan!")
                    return
                end

                -- Munculkan UI Overlay Tombol Kiri-Kanan
                createSpectateUI(
                    function() cycleTarget(-1) end, -- Tombol Kiri (Prev)
                    function() cycleTarget(1)  end, -- Tombol Kanan (Next)
                    function() stopSpectate()  end  -- Tombol Keluar (opsional)
                )

                startSpectate(foundTarget)
            end
        },
        ["unspectate"] = {
            ["ListName"] = "unspectate",
            ["Description"] = "Keluar dari mode spectate",
            ["Aliases"] = {"unspec", "backview"},
            ["Function"] = function(args, speaker)
                stopSpectate()
            end
        },
        ["mutesound"] = {
            ["ListName"] = "mutesound",
            ["Description"] = "Mutes map sounds while preserving whitelisted sounds.",
            ["Aliases"] = {"mutesound"},
            ["Function"] = function(args, speaker)
                muteState.enabled = true

                if muteState.addedConn then
                    muteState.addedConn:Disconnect()
                    muteState.addedConn = nil
                end

                for _, obj in ipairs(Workspace:GetDescendants()) do
                    if obj:IsA("Sound") then applyMute(obj) end
                end
                for _, obj in ipairs(SoundService:GetDescendants()) do
                    if obj:IsA("Sound") then applyMute(obj) end
                end

                muteState.addedConn = Workspace.DescendantAdded:Connect(function(obj)
                    if muteState.enabled and obj:IsA("Sound") then
                        task.defer(function() applyMute(obj) end)
                    end
                end)

                print("[MuteSound] Berhasil membisukan suara latar map.")
            end
        },
        ["unmutesound"] = {
            ["ListName"] = "unmutesound",
            ["Description"] = "Restores sounds muted by mutesound.",
            ["Aliases"] = {"unmutesound"},
            ["Function"] = function(args, speaker)
                muteState.enabled = false

                if muteState.addedConn then
                    muteState.addedConn:Disconnect()
                    muteState.addedConn = nil
                end

                for sound, origVol in pairs(muteState.mutedSounds) do
                    if sound and sound.Parent and sound:IsA("Sound") and origVol then
                        sound.Volume = origVol
                    end
                end

                for _, conn in pairs(muteState.connections) do
                    pcall(function() conn:Disconnect() end)
                end

                muteState.mutedSounds = {}
                muteState.connections = {}

                print("[MuteSound] Suara map dikembalikan normal.")
            end
        }
    }
}

return Plugin
