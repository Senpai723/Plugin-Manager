local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local Workspace = game:GetService("Workspace")
local CoreGui = game:GetService("CoreGui")
local LocalPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera

-- GLOBAL STATE UNTUK SPECTATE & MUTE SOUND
_G.__SpectateState = _G.__SpectateState or {
    isSpectating = false,
    spectateTarget = nil,
    targetIndex = 1,
    conn = nil,
    uiGui = nil,
    playerListVisible = false
}

_G.__VoiceSpyMuteState = _G.__VoiceSpyMuteState or {
    enabled = false,
    mutedSounds = {},
    connections = {},
    addedConn = nil
}

local state = _G.__SpectateState
local muteState = _G.__VoiceSpyMuteState

-- DAFTAR WHITELIST SUARA YANG BOLEH DIBUNYIKAN
local ALLOWED_KEYWORDS = {
    "checkpoint", "respawn", "cp", "pos", "pospemeriksaan", 
    "uuhh", "oof", "gettingup", "music", "radio", "boombox", 
    "jukebox", "song", "soundtrack", "bgm", "audio"
}

local function isAllowedSound(sound)
    if not sound or not sound:IsA("Sound") then return end
    local name = string.lower(sound.Name or "")
    for _, kw in ipairs(ALLOWED_KEYWORDS) do
        if string.find(name, kw, 1, true) then return true end
    end
    return false
end

local function applyMute(sound)
    if not muteState.enabled or not sound or not sound:IsA("Sound") then return end
    if isAllowedSound(sound) then return end

    if muteState.mutedSounds[sound] == nil then
        muteState.mutedSounds[sound] = sound.Volume
    end

    sound.Volume = 0

    if not muteState.connections[sound] then
        muteState.connections[sound] = sound:GetPropertyChangedSignal("Volume"):Connect(function()
            if muteState.enabled and sound.Parent and not isAllowedSound(sound) then
                sound.Volume = 0
            end
        end)
    end
end

-- FORWARD DECLARATION
local createSpectateUI, updatePlayerListUI
local nameLabelRef = nil
local playerListContainerRef = nil

local function getOtherPlayers()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            table.insert(list, p)
        end
    end
    return list
end

local function stopSpectate()
    state.isSpectating = false
    state.spectateTarget = nil
    state.playerListVisible = false

    if state.conn then
        state.conn:Disconnect()
        state.conn = nil
    end

    if state.uiGui then
        state.uiGui:Destroy()
        state.uiGui = nil
    end

    pcall(function()
        Camera.CameraType = Enum.CameraType.Custom
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
            Camera.CameraSubject = LocalPlayer.Character.Humanoid
        end
    end)
    print("[Spectate] Keluar dari mode spectate.")
end

local function startSpectate(targetPlayer)
    if not targetPlayer or not targetPlayer.Character then
        print("[Spectate] Target tidak valid!")
        return
    end

    state.spectateTarget = targetPlayer
    state.isSpectating = true

    if nameLabelRef and nameLabelRef.Parent then
        nameLabelRef.Text = targetPlayer.DisplayName .. " (@" .. targetPlayer.Name .. ")"
    end

    if state.conn then
        state.conn:Disconnect()
    end

    Camera.CameraType = Enum.CameraType.Custom
    state.conn = RunService.RenderStepped:Connect(function()
        if not state.isSpectating or not state.spectateTarget or not state.spectateTarget.Character then
            return
        end
        local char = state.spectateTarget.Character
        local hum = char:FindFirstChild("Humanoid")
        if hum and Camera.CameraSubject ~= hum then
            Camera.CameraSubject = hum
        end
    end)

    if playerListContainerRef and playerListContainerRef.Parent then
        updatePlayerListUI(playerListContainerRef)
    end

    print("[Spectate] Sedang melihat: " .. targetPlayer.Name)
end

local function cycleTarget(direction)
    local players = getOtherPlayers()
    if #players == 0 then return end

    local currentIndex = 1
    for i, p in ipairs(players) do
        if p == state.spectateTarget then
            currentIndex = i
            break
        end
    end

    currentIndex = currentIndex + direction
    if currentIndex > #players then
        currentIndex = 1
    elseif currentIndex < 1 then
        currentIndex = #players
    end

    startSpectate(players[currentIndex])
end

-- FUNGSI UNTUK MEMPERBARUI ISI LIST PLAYER
function updatePlayerListUI(container)
    for _, child in ipairs(container:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local players = getOtherPlayers()
    local yOffset = 5
    
    for _, p in ipairs(players) do
        local PlayerBtn = Instance.new("TextButton")
        PlayerBtn.Size = UDim2.new(1, -10, 0, 32)
        PlayerBtn.Position = UDim2.new(0, 5, 0, yOffset)
        
        if p == state.spectateTarget then
            PlayerBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 70)
        else
            PlayerBtn.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
        end
        
        PlayerBtn.BackgroundTransparency = 0.2
        PlayerBtn.BorderSizePixel = 0
        PlayerBtn.Font = Enum.Font.GothamSemibold
        PlayerBtn.Text = "  " .. p.DisplayName
        PlayerBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        PlayerBtn.TextSize = 13
        PlayerBtn.TextXAlignment = Enum.TextXAlignment.Left
        PlayerBtn.Parent = container
        
        Instance.new("UICorner", PlayerBtn).CornerRadius = UDim.new(0, 6)

        PlayerBtn.MouseButton1Click:Connect(function()
            startSpectate(p)
        end)

        yOffset = yOffset + 36
    end

    container.CanvasSize = UDim2.new(0, 0, 0, yOffset + 5)
end

