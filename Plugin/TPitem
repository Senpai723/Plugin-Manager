-- ================================================================
-- PRECISE GRABBER: ULTIMATE + ROBUST HELD ITEM DETECTION
-- ================================================================

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local VirtualInputManager = game:GetService("VirtualInputManager")
local LocalPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera

local function lower(val)
    return string.lower(tostring(val or ""))
end

-- 1. FUNGSI UTAMA: AMBIL ITEM DARI LANTAI (TP ITEM)
getgenv().ExecutePreciseGrab = function(keyword, maxLimitInput)
    local searchKeyword = lower(keyword)
    if searchKeyword == "" then
        print("[Grab] Keyword kosong!")
        return
    end

    local maxAllowed = tonumber(maxLimitInput) or 7

    local character = LocalPlayer.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    
    if not rootPart or not humanoid then
        print("[Grab] Karakter / Humanoid tidak ditemukan!")
        return
    end

    local originalCFrame = rootPart.CFrame
    local originalCameraCFrame = Camera.CFrame 
    
    local itemsFolder = Workspace:FindFirstChild("Items") or Workspace

    local validItems = {}
    local addedModels = {}

    for _, obj in ipairs(itemsFolder:GetDescendants()) do
        local fullName = lower(obj:GetFullName())
        
        if not string.find(fullName, "placezone") and not string.find(fullName, "tempinvis") and not string.find(fullName, "display") then
            local rootModel = obj
            if obj:IsA("BasePart") then
                local p = obj.Parent
                while p and p ~= itemsFolder and p ~= Workspace do
                    if p:IsA("Model") then
                        rootModel = p
                        break
                    end
                    p = p.Parent
                end
            end

            if not addedModels[rootModel] then
                local searchTexts = {}
                table.insert(searchTexts, lower(rootModel.Name))
                for _, desc in ipairs(rootModel:GetDescendants()) do
                    table.insert(searchTexts, lower(desc.Name))
                end
                
                pcall(function()
                    for _, attrVal in pairs(rootModel:GetAttributes()) do
                        table.insert(searchTexts, lower(tostring(attrVal)))
                    end
                    for _, child in ipairs(rootModel:GetChildren()) do
                        if child:IsA("StringValue") or child:IsA("ValueBase") then
                            table.insert(searchTexts, lower(tostring(child.Value)))
                        end
                    end
                end)

                local combinedSearchString = table.concat(searchTexts, " ")

                if string.find(combinedSearchString, searchKeyword, 1, true) then
                    local targetPart = nil
                    if rootModel:IsA("Model") then
                        targetPart = rootModel.PrimaryPart or rootModel:FindFirstChildWhichIsA("BasePart")
                    elseif rootModel:IsA("BasePart") then
                        if rootModel.Size.Magnitude < 15 and rootModel.Transparency < 1 then
                            targetPart = rootModel
                        end
                    end

                    if targetPart and targetPart:IsDescendantOf(Workspace) then
                        addedModels[rootModel] = true
                        local dist = (targetPart.Position - rootPart.Position).Magnitude
                        table.insert(validItems, {Part = targetPart, Distance = dist})
                    end
                end
            end
        end
    end

    table.sort(validItems, function(a, b)
        return a.Distance < b.Distance
    end)

    if #validItems == 0 then
        print("[Grab] Item atau Kategori '" .. keyword .. "' tidak ditemukan!")
        return
    end

    local targetLimit = math.min(#validItems, maxAllowed)
    print("[Grab] Ditemukan " .. #validItems .. " item unik. Memproses " .. targetLimit .. " item terdekat...")

    local collected = 0

    for i = 1, targetLimit do
        local itemData = validItems[i]
        if not itemData then break end
        local targetPart = itemData.Part

        if targetPart and targetPart:IsDescendantOf(Workspace) then
            pcall(function()
                local itemPos = targetPart.Position
                
                rootPart.CFrame = CFrame.lookAt(itemPos + Vector3.new(0, 0.3, 1.2), itemPos)
                
                Camera.CameraType = Enum.CameraType.Scriptable
                Camera.CFrame = CFrame.lookAt(itemPos + Vector3.new(0, 2, 2), itemPos)
                task.wait(0.06)

                local vp = Camera.ViewportSize
                VirtualInputManager:SendMouseButtonEvent(vp.X/2, vp.Y/2, 0, true, game, 0)
                task.wait(0.03)
                VirtualInputManager:SendMouseButtonEvent(vp.X/2, vp.Y/2, 0, false, game, 0)

                if targetPart:IsA("BasePart") then
                    firetouchinterest(rootPart, targetPart, 0)
                    task.wait(0.03)
                    firetouchinterest(rootPart, targetPart, 1)
                end

                collected += 1
            end)
            task.wait(0.35)
        end
    end

    -- PEMULIHAN AKHIR
    pcall(function()
        if rootPart and rootPart.Parent then
            rootPart.AssemblyLinearVelocity = Vector3.zero
            rootPart.AssemblyAngularVelocity = Vector3.zero
            rootPart.CFrame = originalCFrame
        end
    end)

    pcall(function()
        Camera = Workspace.CurrentCamera
        Camera.CameraType = Enum.CameraType.Scriptable
        Camera.CFrame = originalCameraCFrame
        task.wait(0.05)
        Camera.CameraType = Enum.CameraType.Custom
        Camera.CameraSubject = humanoid
    end)

    pcall(function()
        humanoid.PlatformStand = false
        humanoid.Sit = false
        humanoid.AutoRotate = true
        humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
        humanoid:ChangeState(Enum.HumanoidStateType.Running)
    end)

    task.spawn(function()
        task.wait(0.1)
        pcall(function()
            local playerScripts = LocalPlayer:FindFirstChild("PlayerScripts")
            local playerModuleScript = playerScripts and playerScripts:FindFirstChild("PlayerModule")
            if playerModuleScript then
                local playerModule = require(playerModuleScript)
                local controls = playerModule:GetControls()
                if controls then
                    controls:Enable()
                end
            end
        end)
    end)

    print("[Grab] Selesai! Berhasil mengambil " .. collected .. " item.")
end

-- 2. FUNGSI PUT: DETEKSI ITEM DI TANGAN DENGAN SYSTEM ROBUST + TELEPORT KE RAK
getgenv().ExecutePutItem = function()
    local character = LocalPlayer.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    if not character or not rootPart then
        print("[PutItem] Karakter tidak ditemukan!")
        return
    end

    -- PENCETAKAN DETEKSI ITEM YANG LEBIH LUAS (MENGAMBIL DARI TANGAN, TOOL, BACKPACK, ATAU ATRIBUT)
    local heldItemName = ""
    
    -- Cek langsung di karakter (Tool atau Model)
    for _, obj in ipairs(character:GetChildren()) do
        if obj:IsA("Tool") or obj:IsA("Model") then
            heldItemName = obj.Name
            break
        end
    end

    -- Cek lewat RightHand / Right Arm (biasanya game nempelang item pake Motor6D / Grip)
    if heldItemName == "" then
        local rightHand = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
        if rightHand then
            for _, child in ipairs(rightHand:GetChildren()) do
                if child:IsA("Weld") or child:IsA("Motor6D") then
                    if child.Part1 and child.Part1.Parent then
                        heldItemName = child.Part1.Parent.Name
                        break
                    end
                end
            end
        end
    end

    -- Cek lewat Backpack player
    if heldItemName == "" and LocalPlayer:FindFirstChild("Backpack") then
        for _, obj in ipairs(LocalPlayer.Backpack:GetChildren()) do
            if obj:IsA("Tool") then
                heldItemName = obj.Name
                break
            end
        end
    end

    if heldItemName == "" then
        print("[PutItem] Pegang barang dulu di tangan!")
        return
    end

    local rawLower = lower(heldItemName)
    local searchKey = string.match(rawLower, "^%s*([%w]+)") or rawLower
    print("[PutItem] Item terdeteksi di tangan: [" .. heldItemName .. "] -> Keyword: " .. searchKey)

    local targetPart = nil

    -- Cari nametag rak di map
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("TextLabel") or obj:IsA("TextButton") then
            local txt = lower(obj.Text)
            if txt ~= "" and (string.find(searchKey, txt, 1, true) or string.find(txt, searchKey, 1, true)) then
                local parent = obj.Parent
                while parent and parent ~= Workspace do
                    if parent:IsA("BasePart") then
                        targetPart = parent
                        break
                    elseif parent:IsA("Model") then
                        targetPart = parent.PrimaryPart or parent:FindFirstChildWhichIsA("BasePart")
                        if targetPart then break end
                    end
                    parent = parent.Parent
                end
                if targetPart then break end
            end
        end
    end

    -- Fallback cari lewat objek Workspace
    if not targetPart then
        for _, obj in ipairs(Workspace:GetDescendants()) do
            local pName = lower(obj.Name)
            if string.find(pName, searchKey, 1, true) and not string.find(lower(obj.GetFullName()), "items") then
                if obj:IsA("BasePart") then
                    targetPart = obj
                    break
                elseif obj:IsA("Model") then
                    targetPart = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                    if targetPart then break end
                end
            end
        end
    end

    if targetPart then
        pcall(function()
            local rackPos = targetPart.Position
            rootPart.CFrame = CFrame.lookAt(rackPos + Vector3.new(0, 0.5, 2.5), rackPos)
            print("[PutItem] Berhasil teleport ke depan rak " .. searchKey .. "!")
        end)
    else
        print("[PutItem] Rak untuk item '" .. heldItemName .."' (Keyword: " .. searchKey .. ") tidak ditemukan di map!")
    end
end

