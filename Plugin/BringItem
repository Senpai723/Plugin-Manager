-- ================================================================
-- PRECISE GRABBER FIX: NEAREST SORT & CAMERA UNLOCK
-- ================================================================

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local CoreGui = game:GetService("CoreGui")
local VirtualInputManager = game:GetService("VirtualInputManager")
local LocalPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera

local TRANSLATION_MAP = {
    ["telur"] = "egg",
    ["egg"] = "telur",
    ["cangkir"] = "cup",
    ["cup"] = "cangkir",
    ["roti"] = "bread",
    ["bread"] = "roti",
    ["kue"] = "cake",
    ["cake"] = "kue",
    ["susu"] = "milk",
    ["milk"] = "susu",
    ["keju"] = "cheese",
    ["cheese"] = "keju",
    ["kopi"] = "coffee",
    ["coffee"] = "kopi",
    ["teh"] = "tea",
    ["tea"] = "teh"
}

local function lower(val)
    return string.lower(tostring(val or ""))
end

getgenv().ExecutePreciseGrab = function(keyword)
    local searchKeyword = lower(keyword)
    if searchKeyword == "" then
        print("[Grab] Keyword kosong!")
        return
    end

    local character = LocalPlayer.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    if not rootPart then
        print("[Grab] Karakter tidak ditemukan!")
        return
    end

    local originalCFrame = rootPart.CFrame
    local originalCamType = Camera.CameraType
    local translatedKeyword = TRANSLATION_MAP[searchKeyword]
    local collected = 0
    local maxCount = 10 
    local itemsFolder = Workspace:FindFirstChild("Items") or Workspace

    -- 1. KUMPULKAN DAN URUTKAN ITEM BERDASARKAN JARAK TERDEKAT (NEAREST FIRST)
    local validItems = {}

    for _, obj in ipairs(itemsFolder:GetDescendants()) do
        local fullName = lower(obj:GetFullName())
        if not string.find(fullName, "placezone") and not string.find(fullName, "tempinvis") then
            local name = lower(obj.Name)

            if string.find(name, searchKeyword, 1, true) or (translatedKeyword and string.find(name, translatedKeyword, 1, true)) then
                local targetPart = nil
                if obj:IsA("BasePart") then
                    targetPart = obj
                elseif obj:IsA("Model") then
                    targetPart = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)
                end

                if targetPart and targetPart:IsDescendantOf(Workspace) then
                    local dist = (targetPart.Position - rootPart.Position).Magnitude
                    table.insert(validItems, {Part = targetPart, Distance = dist})
                end
            end
        end
    end

    -- Urutkan dari item yang paling dekat dengan player biar nggak loncat-loncat jauh
    table.sort(validItems, function(a, b)
        return a.Distance < b.Distance
    end)

    print("[Grab] Total item ditemukan: " .. #validItems .. ". Memulai pengambilan...")

    -- 2. EKSEKUSI PENGAMBILAN BERURUTAN
    for _, itemData in ipairs(validItems) do
        if collected >= maxCount then break end
        local targetPart = itemData.Part

        if targetPart and targetPart:IsDescendantOf(Workspace) then
            pcall(function()
                local itemPos = targetPart.Position
                
                -- Teleport pas di sebelah item
                rootPart.CFrame = CFrame.new(itemPos + Vector3.new(0, 0.5, 1.5), itemPos)
                
                -- Alihkan kamera nunduk ke bawah menghadap item
                Camera.CameraType = Enum.CameraType.Scriptable
                Camera.CFrame = CFrame.lookAt(itemPos + Vector3.new(0, 4, 2), itemPos)
                task.wait(0.12)

                -- Simulasi Tap layar di tengah
                local vp = Camera.ViewportSize
                VirtualInputManager:SendMouseButtonEvent(vp.X/2, vp.Y/2, 0, true, game, 0)
                task.wait(0.04)
                VirtualInputManager:SendMouseButtonEvent(vp.X/2, vp.Y/2, 0, false, game, 0)

                if targetPart:IsA("BasePart") then
                    firetouchinterest(rootPart, targetPart, 0)
                    task.wait(0.04)
                    firetouchinterest(rootPart, targetPart, 1)
                end

                collected += 1
            end)
            task.wait(0.3)
        end
    end

    -- 3. WAJIB: KEMBALIKAN KAMERA & POSISI PLAYER KE SEMULA SECARA AMAN
    pcall(function()
        Camera.CameraType = Enum.CameraType.Custom -- Membuka kunci kamera agar bisa digerakkan normal lagi!
        Camera.CameraSubject = character:FindFirstChildOfClass("Humanoid")
        rootPart.CFrame = originalCFrame
    end)

    print("[Grab] Selesai! Berhasil mengambil " .. collected .. " item. Kamera dipulihkan.")
end

