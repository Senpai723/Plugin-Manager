local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local CoreGui = game:GetService("CoreGui")
local LocalPlayer = Players.LocalPlayer

-- Kamus terjemahan bilingual (Indo <-> Eng)
local TRANSLATION_MAP = {
    ["telur"] = "egg",
    ["egg"] = "telur",
    ["cangkir"] = "cup",
    ["cup"] = "cangkir",
    ["roti"] = "bread",
    ["bread"] = "roti",
    ["kue"] = "cake",
    ["cake"] = "kue",
    ["susu"] = "milk",
    ["milk"] = "susu",
    ["keju"] = "cheese",
    ["cheese"] = "keju",
    ["kopi"] = "coffee",
    ["coffee"] = "kopi",
    ["teh"] = "tea",
    ["tea"] = "teh"
}

local function lower(val)
    return string.lower(tostring(val or ""))
end

-- ----------------------------------------------------------------
-- LOGIKA UTAMA BRING ITEM (DENGAN FILTER ANCHOR & STRUKTUR MAP)
-- ----------------------------------------------------------------
getgenv().BringItems = function(keyword)
    local character = LocalPlayer.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    
    if not rootPart then
        warn("[Bring Item] Karakter tidak ditemukan!")
        return 0
    end

    local searchKeyword = lower(keyword)
    if searchKeyword == "" then
        warn("[Bring Item] Keyword kosong!")
        return 0
    end

    local translatedKeyword = TRANSLATION_MAP[searchKeyword]
    local count = 0

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") or obj:IsA("BasePart") then
            -- 1. Abaikan player
            local isPlayer = false
            for _, player in ipairs(Players:GetPlayers()) do
                if player.Character and obj:IsDescendantOf(player.Character) then
                    isPlayer = true
                    break
                end
            end

            if not isPlayer then
                local name = lower(obj.Name)
                local fullName = lower(obj:GetFullName())

                -- 2. Abaikan struktur map/tempat taruh seperti PlaceZone, TempInvisPart, dll.
                if not string.find(fullName, "placezone") and not string.find(fullName, "tempinvis") and not string.find(fullName, "shelves") then
                    
                    -- 3. Cocokkan nama item atau terjemahannya
                    if string.find(name, searchKeyword, 1, true) or (translatedKeyword and string.find(name, translatedKeyword, 1, true)) then
                        local targetPart = nil
                        
                        if obj:IsA("BasePart") then
                            targetPart = obj
                        elseif obj:IsA("Model") then
                            targetPart = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)
                        end

                        -- 4. SYARAT UTAMA: Harus di Workspace dan TIDAK ANCHORED (artinya item fisik/loot asli)
                        if targetPart and targetPart:IsDescendantOf(Workspace) and not targetPart.Anchored then
                            pcall(function()
                                -- Pindahkan tepat di depan bawah kaki player agar tidak melayang tinggi
                                targetPart.CFrame = rootPart.CFrame * CFrame.new(0, -2, -3)
                                count += 1
                            end)
                        end
                    end
                end
            end
        end
    end

    print("[Bring Item] Berhasil menarik " .. count .. " item fisik dengan keyword: '" .. keyword .. "'")
    return count
end

