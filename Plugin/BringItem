-- ================================================================
-- INFINITE YIELD PLUGIN: REMOTE GRABBER (INTEGRATED)
-- ================================================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local LocalPlayer = Players.LocalPlayer

-- Ambil jalur remote asli game
local StoreRemotes = ReplicatedStorage:WaitForChild("StoreRemotes", 5)
local GrabRequest = StoreRemotes and StoreRemotes:WaitForChild("GrabRequest", 5)

-- Kamus terjemahan bilingual (Indo <-> Eng)
local TRANSLATION_MAP = {
    ["telur"] = "egg",
    ["egg"] = "telur",
    ["cangkir"] = "cup",
    ["cup"] = "cangkir",
    ["roti"] = "bread",
    ["bread"] = "roti",
    ["kue"] = "cake",
    ["cake"] = "kue",
    ["susu"] = "milk",
    ["milk"] = "susu",
    ["keju"] = "cheese",
    ["cheese"] = "keju",
    ["kopi"] = "coffee",
    ["coffee"] = "kopi",
    ["teh"] = "tea",
    ["tea"] = "teh"
}

local function lower(val)
    return string.lower(tostring(val or ""))
end

local function executeRemoteGrab(keyword)
    local searchKeyword = lower(keyword)
    if searchKeyword == "" then
        warn("[Remote Grab] Keyword kosong!")
        return 0
    end

    if not GrabRequest then
        warn("[Remote Grab] Remote GrabRequest tidak ditemukan!")
        return 0
    end

    local translatedKeyword = TRANSLATION_MAP[searchKeyword]
    local count = 0
    local triggeredNames = {}

    for _, obj in ipairs(Workspace:GetDescendants()) do
        local fullName = lower(obj:GetFullName())
        
        if string.find(fullName, "items") and not string.find(fullName, "placezone") and not string.find(fullName, "tempinvis") then
            local name = lower(obj.Name)
            
            if string.find(name, searchKeyword, 1, true) or (translatedKeyword and string.find(name, translatedKeyword, 1, true)) then
                if not triggeredNames[obj.Name] then
                    triggeredNames[obj.Name] = true
                    
                    pcall(function()
                        GrabRequest:FireServer(obj.Name, 1, math.random(10000, 99999))
                        count += 1
                    end)
                end
            end
        end
    end

    print("[Remote Grab] Berhasil mengambil " .. count .. " item untuk keyword: '" .. keyword .. "'")
    return count
end

-- Struktur Plugin Infinite Yield
local Plugin = {
    ["PluginName"] = "Remote Grabber",
    ["PluginDescription"] = "Mengambil item jarak jauh via RemoteEvent asli game tanpa bug gacha",
    ["Commands"] = {
        ["rgrab"] = {
            ["ListName"] = "Remote Grab / rgrab",
            ["Description"] = "Tarik item ke tangan via remote. Contoh: ;rgrab telur",
            ["Aliases"] = {"remotegrab", "grabitem"},
            ["Function"] = function(args, speaker)
                local keyword = table.concat(args, " ")
                if keyword == "" then
                    print("Masukkan nama itemnya, bro! Contoh: ;rgrab telur atau ;rgrab kue")
                    return
                end
                executeRemoteGrab(keyword)
            end
        }
    }
}

return Plugin
