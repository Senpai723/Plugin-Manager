-- ================================================================
-- INFINITE YIELD PLUGIN: INSTANT TELEPORT + REMOTE GRABBER
-- ================================================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local LocalPlayer = Players.LocalPlayer

local StoreRemotes = ReplicatedStorage:WaitForChild("StoreRemotes", 5)
local GrabRequest = StoreRemotes and StoreRemotes:WaitForChild("GrabRequest", 5)

-- Kamus terjemahan bilingual (Indo <-> Eng)
local TRANSLATION_MAP = {
    ["telur"] = "egg",
    ["egg"] = "telur",
    ["cangkir"] = "cup",
    ["cup"] = "cangkir",
    ["roti"] = "bread",
    ["bread"] = "roti",
    ["kue"] = "cake",
    ["cake"] = "kue",
    ["susu"] = "milk",
    ["milk"] = "susu",
    ["keju"] = "cheese",
    ["cheese"] = "keju",
    ["kopi"] = "coffee",
    ["coffee"] = "kopi",
    ["teh"] = "tea",
    ["tea"] = "teh"
}

local function lower(val)
    return string.lower(tostring(val or ""))
end

local function executeTeleportGrab(keyword)
    local searchKeyword = lower(keyword)
    if searchKeyword == "" then
        print("[Grab] Masukkan keyword item!")
        return
    end

    if not GrabRequest then
        print("[Grab] Remote GrabRequest tidak ditemukan!")
        return
    end

    local character = LocalPlayer.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    if not rootPart then
        print("[Grab] Karakter tidak ditemukan!")
        return
    end

    -- Simpan posisi awal player biar bisa balik lagi setelah selesai
    local originalCFrame = rootPart.CFrame

    local translatedKeyword = TRANSLATION_MAP[searchKeyword]
    local count = 0
    local itemsFolder = Workspace:FindFirstChild("Items") or Workspace

    for _, obj in ipairs(itemsFolder:GetDescendants()) do
        local fullName = lower(obj:GetFullName())
        
        if not string.find(fullName, "placezone") and not string.find(fullName, "tempinvis") then
            local name = lower(obj.Name)
            
            if string.find(name, searchKeyword, 1, true) or (translatedKeyword and string.find(name, translatedKeyword, 1, true)) then
                
                local targetPart = nil
                local targetName = obj.Name

                if obj:IsA("BasePart") then
                    targetPart = obj
                elseif obj:IsA("Model") then
                    targetPart = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)
                    targetName = obj.Name
                end

                if targetPart and targetPart:IsDescendantOf(Workspace) then
                    pcall(function()
                        -- 1. Teleport player sesaat ke atas item untuk mengelabui validasi jarak server
                        rootPart.CFrame = targetPart.CFrame + Vector3.new(0, 3, 0)
                        task.wait(0.04) -- Jeda mikro agar server merekam posisi

                        -- 2. Tembak remote GrabRequest sesuai format Remote Spy
                        local randomToken = math.random(100000, 999999)
                        GrabRequest:FireServer(targetName, 1, randomToken)
                        count += 1
                    end)
                    task.wait(0.06)
                end
            end
        end
    end

    -- Kembalikan posisi player ke tempat semula dengan mulus
    pcall(function()
        rootPart.CFrame = originalCFrame
    end)

    print("[Remote Grab] Selesai! Berhasil memproses " .. count .. " item untuk keyword: " .. keyword)
end

-- Plugin Struct Infinite Yield
local Plugin = {
    ["PluginName"] = "Instant Teleport Remote Grabber",
    ["PluginDescription"] = "Teleport kilat ke item lalu tembak GrabRequest untuk bypass validasi jarak server",
    ["Commands"] = {
        ["rgrab"] = {
            ["ListName"] = "rgrab <item>",
            ["Description"] = "Tarik item instan (Contoh: ;rgrab telur)",
            ["Aliases"] = {"grabitem"},
            ["Function"] = function(args, speaker)
                local keyword = table.concat(args, " ")
                executeTeleportGrab(keyword)
            end
        }
    }
}

return Plugin
