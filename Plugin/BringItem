local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local CoreGui = game:GetService("CoreGui")
local LocalPlayer = Players.LocalPlayer

-- Kamus terjemahan bilingual (Indo <-> Eng)
local TRANSLATION_MAP = {
    ["telur"] = "egg",
    ["egg"] = "telur",
    ["cangkir"] = "cup",
    ["cup"] = "cangkir",
    ["roti"] = "bread",
    ["bread"] = "roti",
    ["kue"] = "cake",
    ["cake"] = "kue",
    ["susu"] = "milk",
    ["milk"] = "susu",
    ["keju"] = "cheese",
    ["cheese"] = "keju",
    ["kopi"] = "coffee",
    ["coffee"] = "kopi",
    ["teh"] = "tea",
    ["tea"] = "teh"
}

local function lower(val)
    return string.lower(tostring(val or ""))
end

-- ----------------------------------------------------------------
-- LOGIKA UTAMA AUTO-COLLECT (TRIGGER PROMPT/CLICK DARI JAUH)
-- ----------------------------------------------------------------
getgenv().AutoCollectItems = function(keyword)
    local searchKeyword = lower(keyword)
    if searchKeyword == "" then
        warn("[Auto Collect] Keyword kosong!")
        return 0
    end

    local translatedKeyword = TRANSLATION_MAP[searchKeyword]
    local count = 0

    -- Scan semua objek di dalam Workspace
    for _, obj in ipairs(Workspace:GetDescendants()) do
        local fullName = lower(obj:GetFullName())
        
        -- Pastikan hanya mengambil dari dalam folder Items dan bukan struktur map
        if string.find(fullName, "items") and not string.find(fullName, "placezone") and not string.find(fullName, "tempinvis") then
            
            -- Cari ProximityPrompt atau ClickDetector di dalam objek/model item tersebut
            local prompt = obj:FindFirstChildOfClass("ProximityPrompt") or obj:FindFirstChildWhichIsA("ProximityPrompt", true)
            local detector = obj:FindFirstChildOfClass("ClickDetector") or obj:FindFirstChildWhichIsA("ClickDetector", true)
            
            if prompt or detector then
                local targetName = lower(obj.Name)
                local promptText = prompt and (lower(prompt.ObjectText) .. " " .. lower(prompt.ActionText)) or ""
                
                -- Cek kecocokan nama item atau teks pada prompt
                if string.find(targetName, searchKeyword, 1, true) or 
                   (translatedKeyword and string.find(targetName, translatedKeyword, 1, true)) or
                   string.find(promptText, searchKeyword, 1, true) or
                   (translatedKeyword and string.find(promptText, translatedKeyword, 1, true)) then
                    
                    pcall(function()
                        if prompt then
                            -- Men-trigger ProximityPrompt game secara otomatis dari jauh
                            fireproximityprompt(prompt)
                            count += 1
                        elseif detector then
                            -- Men-trigger ClickDetector game secara otomatis dari jauh
                            fireclickdetector(detector)
                            count += 1
                        end
                    end)
                end
            end
        end
    end

    print("[Auto Collect] Berhasil mentrigger " .. count .. " item dengan keyword: '" .. keyword .. "'")
    return count
end

