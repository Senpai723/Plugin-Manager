-- ================================================================
-- INFINITE YIELD PLUGIN: TELEPORT & CUSTOM CLICK GRABBER
-- ================================================================

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local LocalPlayer = Players.LocalPlayer

-- Kamus terjemahan bilingual
local TRANSLATION_MAP = {
    ["telur"] = "egg",
    ["egg"] = "telur",
    ["cangkir"] = "cup",
    ["cup"] = "cangkir",
    ["roti"] = "bread",
    ["bread"] = "roti",
    ["kue"] = "cake",
    ["cake"] = "kue",
    ["susu"] = "milk",
    ["milk"] = "susu",
    ["keju"] = "cheese",
    ["cheese"] = "keju",
    ["kopi"] = "coffee",
    ["coffee"] = "kopi",
    ["teh"] = "tea",
    ["tea"] = "teh"
}

local function lower(val)
    return string.lower(tostring(val or ""))
end

local function executeTeleportAndClickGrab(keyword, maxCount)
    local searchKeyword = lower(keyword)
    if searchKeyword == "" then
        print("[Grab] Masukkan nama itemnya, bro!")
        return
    end

    maxCount = tonumber(maxCount) or 5 -- Default ambil 5 item kalau jumlah tidak diisi
    local character = LocalPlayer.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    
    if not rootPart then
        print("[Grab] Karakter tidak ditemukan!")
        return
    end

    local originalCFrame = rootPart.CFrame
    local translatedKeyword = TRANSLATION_MAP[searchKeyword]
    local collected = 0
    local itemsFolder = Workspace:FindFirstChild("Items") or Workspace

    print(sprintf("[Grab] Memulai pengambilan '%s' sebanyak maksimal %d item...", searchKeyword, maxCount))

    for _, obj in ipairs(itemsFolder:GetDescendants()) do
        if collected >= maxCount then 
            break 
        end

        local fullName = lower(obj:GetFullName())
        if not string.find(fullName, "placezone") and not string.find(fullName, "tempinvis") then
            local name = lower(obj.Name)

            if string.find(name, searchKeyword, 1, true) or (translatedKeyword and string.find(name, translatedKeyword, 1, true)) then
                local targetPart = nil

                if obj:IsA("BasePart") then
                    targetPart = obj
                elseif obj:IsA("Model") then
                    targetPart = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)
                end

                if targetPart and targetPart:IsDescendantOf(Workspace) then
                    pcall(function()
                        -- 1. Teleport pas ke atas objek itemnya
                        rootPart.CFrame = targetPart.CFrame + Vector3.new(0, 2, 0)
                        
                        -- 2. Simulasi menyentuh / klik objek (memicu event custom game)
                        if targetPart:IsA("BasePart") then
                            firetouchinterest(rootPart, targetPart, 0)
                            task.wait(0.1)
                            firetouchinterest(rootPart, targetPart, 1)
                        end

                        collected += 1
                        print(sprintf("[Grab] Berhasil mengambil item ke-%d", collected))
                    end)

                    -- 3. Jeda 1 detik sesuai permintaan bro agar aman & tidak terlalu cepat
                    task.wait(1.0)
                end
            end
        end
    end

    -- Kembalikan posisi player ke tempat asal dengan mulus setelah selesai
    pcall(function()
        rootPart.CFrame = originalCFrame
    end)

    print(sprintf("[Grab] Selesai! Total %d item berhasil diproses.", collected))
end

-- Helper kecil untuk format print string
function sprintf(str, ...)
    return string.format(str, ...)
end

-- Plugin Struct Infinite Yield
local Plugin = {
    ["PluginName"] = "Teleport Touch Grabber",
    ["PluginDescription"] = "Teleport berjedanya 1 detik per item sambil mentrigger sentuhan custom.",
    ["Commands"] = {
        ["rgrab"] = {
            ["ListName"] = "rgrab <item> <jumlah>",
            ["Description"] = "Contoh: ;rgrab telur 5 (Teleport & ambil berjedanya 1 detik)",
            ["Aliases"] = {"grabitems"},
            ["Function"] = function(args, speaker)
                local keyword = args[1] or ""
                local count = args[2] or 5
                executeTeleportAndClickGrab(keyword, count)
            end
        }
    }
}

return Plugin
