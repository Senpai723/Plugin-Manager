-- ================================================================
-- INFINITE YIELD PLUGIN: LIMITED ITEM BRINGER (MAX 10 ITEMS)
-- ================================================================

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local LocalPlayer = Players.LocalPlayer

-- Kamus terjemahan bilingual (Indo <-> Eng)
local TRANSLATION_MAP = {
    ["telur"] = "egg",
    ["egg"] = "telur",
    ["cangkir"] = "cup",
    ["cup"] = "cangkir",
    ["roti"] = "bread",
    ["bread"] = "roti",
    ["kue"] = "cake",
    ["cake"] = "kue",
    ["susu"] = "milk",
    ["milk"] = "susu",
    ["keju"] = "cheese",
    ["cheese"] = "keju",
    ["kopi"] = "coffee",
    ["coffee"] = "kopi",
    ["teh"] = "tea",
    ["tea"] = "teh"
}

local function lower(val)
    return string.lower(tostring(val or ""))
end

-- ----------------------------------------------------------------
-- LOGIKA BRING ITEM (DIBATASI MAKSIMAL 10 ITEM)
-- ----------------------------------------------------------------
local function executeBringLimit(keyword)
    local character = LocalPlayer.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    
    if not rootPart then
        print("[Bring Item] Karakter tidak ditemukan!")
        return 0
    end

    local searchKeyword = lower(keyword)
    if searchKeyword == "" then
        print("[Bring Item] Keyword kosong! Contoh: ;rgrab telur")
        return 0
    end

    local translatedKeyword = TRANSLATION_MAP[searchKeyword]
    local count = 0
    local maxLimit = 10 -- Batas maksimal 10 item agar server tidak bug/kewalahan

    for _, obj in ipairs(Workspace:GetDescendants()) do
        -- Hentikan pencarian jika sudah mencapai batas 10 item
        if count >= maxLimit then
            break
        end

        if obj:IsA("Model") or obj:IsA("BasePart") then
            local fullName = lower(obj:GetFullName())
            if string.find(fullName, "items") then
                if not string.find(fullName, "placezone") and not string.find(fullName, "tempinvis") then
                    local name = lower(obj.Name)

                    if string.find(name, searchKeyword, 1, true) or (translatedKeyword and string.find(name, translatedKeyword, 1, true)) then
                        local targetPart = nil
                        
                        if obj:IsA("BasePart") then
                            targetPart = obj
                        elseif obj:IsA("Model") then
                            targetPart = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)
                        end

                        if targetPart and targetPart:IsDescendantOf(Workspace) then
                            pcall(function()
                                -- Penyebaran posisi (spread) di depan player
                                local randomX = math.random(-3, 3)
                                local randomZ = math.random(-4, -1)
                                
                                targetPart.CFrame = rootPart.CFrame * CFrame.new(randomX, -2, randomZ)
                                count += 1
                            end)
                        end
                    end
                end
            end
        end
    end

    print(string.format("[Bring Item] Berhasil menarik %d item (max 10) dengan keyword: '%s'", count, keyword))
    return count
end

-- ----------------------------------------------------------------
-- STRUKTUR PLUGIN INFINITE YIELD
-- ----------------------------------------------------------------
local Plugin = {
    ["PluginName"] = "Bring Item Spread (Max 10)",
    ["PluginDescription"] = "Menarik item ke depan player maksimal 10 buah dengan efek sebar",
    ["Commands"] = {
        ["rgrab"] = {
            ["ListName"] = "rgrab <namaitem>",
            ["Description"] = "Tarik maksimal 10 item (Contoh: ;rgrab telur)",
            ["Aliases"] = {"bringitem", "grab"},
            ["Function"] = function(args, speaker)
                local keyword = table.concat(args, " ")
                executeBringLimit(keyword)
            end
        }
    }
}

return Plugin
