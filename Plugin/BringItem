-- ================================================================
-- PRECISE GRABBER: MAX 10 ITEMS + INSTANT MOVE UNLOCK
-- ================================================================

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local CoreGui = game:GetService("CoreGui")
local VirtualInputManager = game:GetService("VirtualInputManager")
local LocalPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera

local function lower(val)
    return string.lower(tostring(val or ""))
end

getgenv().ExecutePreciseGrab = function(keyword)
    local searchKeyword = lower(keyword)
    if searchKeyword == "" then
        print("[Grab] Keyword kosong!")
        return
    end

    local character = LocalPlayer.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    
    if not rootPart or not humanoid then
        print("[Grab] Karakter / Humanoid tidak ditemukan!")
        return
    end

    local originalCFrame = rootPart.CFrame
    local itemsFolder = Workspace:FindFirstChild("Items") or Workspace

    -- KUMPULKAN ITEM LANGSUNG DARI WORKSPACE (MENDUKUNG SPASI PENUH)
    local validItems = {}

    for _, obj in ipairs(itemsFolder:GetDescendants()) do
        local fullName = lower(obj:GetFullName())
        if not string.find(fullName, "placezone") and not string.find(fullName, "tempinvis") and not string.find(fullName, "display") then
            local objName = lower(obj.Name)
            local parentName = obj.Parent and lower(obj.Parent.Name) or ""

            if string.find(objName, searchKeyword, 1, true) or string.find(parentName, searchKeyword, 1, true) then
                local targetPart = nil
                if obj:IsA("BasePart") then
                    if obj.Size.Magnitude < 15 and obj.Transparency < 1 then
                        targetPart = obj
                    end
                elseif obj:IsA("Model") then
                    targetPart = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                end

                if targetPart and targetPart:IsDescendantOf(Workspace) then
                    local dist = (targetPart.Position - rootPart.Position).Magnitude
                    table.insert(validItems, {Part = targetPart, Distance = dist})
                end
            end
        end
    end

    -- Urutkan dari item yang paling dekat dengan player
    table.sort(validItems, function(a, b)
        return a.Distance < b.Distance
    end)

    if #validItems == 0 then
        print("[Grab] Item dengan nama '" .. keyword .. "' tidak ditemukan di map!")
        return
    end

    -- Batas maksimal dinaikkan menjadi 10 item
    local targetLimit = math.min(#validItems, 10)
    print("[Grab] Ditemukan item, memproses hingga " .. targetLimit .. " buah...")

    local collected = 0

    -- EKSEKUSI TELEPORT & TOUCH ITEM
    for i = 1, targetLimit do
        local itemData = validItems[i]
        if not itemData then break end
        local targetPart = itemData.Part

        if targetPart and targetPart:IsDescendantOf(Workspace) then
            pcall(function()
                local itemPos = targetPart.Position
                
                -- Teleport pas di sebelah item
                rootPart.CFrame = CFrame.lookAt(itemPos + Vector3.new(0, 0.5, 1.5), itemPos)
                
                Camera.CameraType = Enum.CameraType.Scriptable
                Camera.CFrame = CFrame.lookAt(itemPos + Vector3.new(0, 3, 2), itemPos)
                task.wait(0.08)

                local vp = Camera.ViewportSize
                VirtualInputManager:SendMouseButtonEvent(vp.X/2, vp.Y/2, 0, true, game, 0)
                task.wait(0.03)
                VirtualInputManager:SendMouseButtonEvent(vp.X/2, vp.Y/2, 0, false, game, 0)

                if targetPart:IsA("BasePart") then
                    firetouchinterest(rootPart, targetPart, 0)
                    task.wait(0.03)
                    firetouchinterest(rootPart, targetPart, 1)
                end

                collected += 1
            end)
            task.wait(0.2)
        end
    end

    -- PEMULIHAN TOTAL: BERSIHKAN MOMENTUM & UNLOCK KONTROL SEKETIKA
    pcall(function()
        -- Hentikan seluruh kecepatan/momentum fisik agar karakter tidak 'licin' atau 'nyangkut'
        rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        
        -- Kembalikan posisi awal
        rootPart.CFrame = originalCFrame
        
        -- Reset total kamera dan status gerak karakter
        Camera.CameraType = Enum.CameraType.Custom
        Camera.CameraSubject = humanoid
        humanoid.PlatformStand = false
        humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
    end)

    print("[Grab] Selesai! Berhasil mengambil " .. collected .. " item. Kontrol langsung normal.")
end

