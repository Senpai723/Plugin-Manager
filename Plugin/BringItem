local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local StoreRemotes = ReplicatedStorage:WaitForChild("StoreRemotes", 5)
local GrabRequest = StoreRemotes and StoreRemotes:WaitForChild("GrabRequest", 5)

-- Kamus terjemahan bilingual (Indo <-> Eng)
local TRANSLATION_MAP = {
    ["telur"] = "egg",
    ["egg"] = "telur",
    ["cangkir"] = "cup",
    ["cup"] = "cangkir",
    ["roti"] = "bread",
    ["bread"] = "roti",
    ["kue"] = "cake",
    ["cake"] = "kue",
    ["susu"] = "milk",
    ["milk"] = "susu",
    ["keju"] = "cheese",
    ["cheese"] = "keju",
    ["kopi"] = "coffee",
    ["coffee"] = "kopi",
    ["teh"] = "tea",
    ["tea"] = "teh"
}

local function lower(val)
    return string.lower(tostring(val or ""))
end

local function executeExactGrab(keyword)
    local searchKeyword = lower(keyword)
    if searchKeyword == "" then
        print("[Grab] Masukkan keyword item!")
        return
    end

    if not GrabRequest then
        print("[Grab] Remote GrabRequest tidak ditemukan!")
        return
    end

    local translatedKeyword = TRANSLATION_MAP[searchKeyword]
    local count = 0
    local itemsFolder = Workspace:FindFirstChild("Items") or Workspace

    for _, obj in ipairs(itemsFolder:GetDescendants()) do
        local fullName = lower(obj:GetFullName())
        
        if not string.find(fullName, "placezone") and not string.find(fullName, "tempinvis") then
            local name = lower(obj.Name)
            
            if string.find(name, searchKeyword, 1, true) or (translatedKeyword and string.find(name, translatedKeyword, 1, true)) then
                
                -- Ambil nama asli objek (Model atau Part utama)
                local targetName = obj.Name
                if obj:IsA("BasePart") and obj.Parent and obj.Parent ~= itemsFolder and obj.Parent:IsA("Model") then
                    targetName = obj.Parent.Name
                end

                pcall(function()
                    -- Sesuai persis dengan format Remote Spy lu: (NamaItem, 1, AngkaAcak)
                    local randomToken = math.random(100000, 999999)
                    GrabRequest:FireServer(targetName, 1, randomToken)
                    count += 1
                end)
                
                -- Beri jeda sikit atau batasi agar tidak spam berlebih
                task.wait(0.05)
                break -- Ambil satu per satu dulu biar stabil
            end
        end
    end

    print("[Remote Grab] Berhasil mengirim request grab untuk: " .. keyword)
end

-- Plugin Struct Infinite Yield
local Plugin = {
    ["PluginName"] = "Exact Remote Grabber",
    ["PluginDescription"] = "Grab item menggunakan format argumen asli dari Remote Spy",
    ["Commands"] = {
        ["rgrab"] = {
            ["ListName"] = "rgrab <item>",
            ["Description"] = "Tarik item sesuai remote spy (Contoh: ;rgrab telur)",
            ["Aliases"] = {"grabitem"},
            ["Function"] = function(args, speaker)
                local keyword = table.concat(args, " ")
                executeExactGrab(keyword)
            end
        }
    }
}

return Plugin
