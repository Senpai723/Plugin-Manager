local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- STORAGE GLOBAL UNTUK MENYIMPAN STATE ASLI PART
_G.AntiGoyang_OriginalStates = _G.AntiGoyang_OriginalStates or {}
_G.AntiGoyang_DisabledConstraints = _G.AntiGoyang_DisabledConstraints or {}
_G.AntiGoyang_Connection = _G.AntiGoyang_Connection or nil

local function notify(text)
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "Anti-Goyang Stabilizer",
            Text = text,
            Duration = 3
        })
    end)
end

-- ==========================================
-- 🔄 REAL-TIME LOOP UNTUK MENGUNCI PART
-- ==========================================
local function startStabilizerLoop()
    if _G.AntiGoyang_Connection then return end
    _G.AntiGoyang_Connection = RunService.RenderStepped:Connect(function()
        for obj, data in pairs(_G.AntiGoyang_OriginalStates) do
            if obj and obj.Parent then
                obj.Anchored = true
                obj.CFrame = data.CFrame -- Paksa diam di posisi pas di-freeze
                obj.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                obj.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            else
                _G.AntiGoyang_OriginalStates[obj] = nil
            end
        end
    end)
end

local function stopStabilizerLoop()
    -- Matikan loop terlebih dahulu
    if _G.AntiGoyang_Connection then
        _G.AntiGoyang_Connection:Disconnect()
        _G.AntiGoyang_Connection = nil
    end

    -- Kembalikan part ke status Anchored dan posisi CFrame asli mereka sebelum di-freeze
    for obj, data in pairs(_G.AntiGoyang_OriginalStates) do
        if obj and obj.Parent then
            obj.Anchored = data.Anchored
            obj.CFrame = data.CFrame -- Kembalikan ke posisi awal supaya tidak jatuh/ambruk
        end
    end
    
    -- Nyalakan kembali tali / constraint seperti semula
    for constraint, _ in pairs(_G.AntiGoyang_DisabledConstraints) do
        if constraint and constraint.Parent then
            constraint.Enabled = true
        end
    end
    
    table.clear(_G.AntiGoyang_OriginalStates)
    table.clear(_G.AntiGoyang_DisabledConstraints)
end

-- ==========================================
-- 🔍 FUNGSI UTAMA FREEZE & UNFREEZE
-- ==========================================
local function freezeNearbyParts(radiusVal)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then
        notify("Karakter / HumanoidRootPart tidak ditemukan!")
        return
    end

    local rootPos = char.HumanoidRootPart.Position
    local count = 0

    for _, obj in ipairs(game:GetService("Workspace"):GetDescendants()) do
        if obj:IsA("BasePart") and not obj:IsDescendantOf(char) then
            if (obj.Position - rootPos).Magnitude <= radiusVal then
                -- Rekam status asli part sebelum di-lock (termasuk status anchored & posisinya)
                if not _G.AntiGoyang_OriginalStates[obj] then
                    _G.AntiGoyang_OriginalStates[obj] = {
                        Anchored = obj.Anchored,
                        CFrame = obj.CFrame
                    }
                end

                obj.Anchored = true
                
                -- Matikan tali/constraint sementara tanpa menghapusnya
                for _, child in ipairs(obj:GetChildren()) do
                    if child:IsA("Constraint") or child:IsA("JointInstance") then
                        if child.Enabled then
                            child.Enabled = false
                            _G.AntiGoyang_DisabledConstraints[child] = true
                        end
                    elseif child:IsA("Script") or child:IsA("LocalScript") or child:IsA("BodyMover") then
                        child:Destroy()
                    end
                end

                count = count + 1
            end
        end
    end

    startStabilizerLoop()
    notify("Berhasil mengunci " .. count .. " part dengan aman!")
end

local function unfreezeAllParts()
    stopStabilizerLoop()
    notify("Semua part dikembalikan ke posisi & kondisi normal!")
end

-- ==========================================
-- 📦 RETURN PLUGIN INFINITE YIELD
-- ==========================================
return {
    ["PluginName"] = "Anti-Goyang Stabilizer",
    ["Commands"] = {
        ["freeze"] = {
            ["ListName"] = "freeze / diam [radius]",
            ["Description"] = "Kunci mati part/tangga bergoyang di sekitar kamu",
            ["Aliases"] = {"diam", "antigoyang"},
            ["Function"] = function(args, speaker)
                local radius = tonumber(args[1]) or 150
                freezeNearbyParts(radius)
            end
        },
        ["unfreeze"] = {
            ["ListName"] = "unfreeze / nyala",
            ["Description"] = "Kembalikan part dan tali ke kondisi semula tanpa jatuh",
            ["Aliases"] = {"nyala", "bergerak", "unbound"},
            ["Function"] = function(args, speaker)
                unfreezeAllParts()
            end
        }
    }
}
