local Plugin = {
    ["PluginName"] = "Anti-Goyang Stabilizer",
    ["PluginDescription"] = "Membekukan part goyang/ngacak dan mematikan physics constraint di sekitar player.",
    ["Commands"] = {
        ["freeze"] = {
            ["ListName"] = "freeze / diam [radius]",
            ["Description"] = "Kunci & diamkan part/tangga/papan bergoyang di sekitar kamu (Default radius: 100).",
            ["Aliases"] = {"diam", "unsway", "antigoyang"},
            ["Function"] = function(args, speaker)
                local radius = tonumber(args[1]) or 100
                local char = speaker.Character or speaker.CharacterAdded:Wait()
                
                if not char or not char:FindFirstChild("HumanoidRootPart") then
                    notify("Anti-Goyang", "Karakter / HumanoidRootPart tidak ditemukan!")
                    return
                end

                local rootPos = char.HumanoidRootPart.Position
                local affectedCount = 0

                -- Iterasi semua part di Workspace
                for _, obj in ipairs(game:GetService("Workspace"):GetDescendants()) do
                    if obj:IsA("BasePart") and not obj:IsDescendantOf(char) then
                        -- Cek apakah part berada dalam radius dari player
                        if (obj.Position - rootPos).Magnitude <= radius then
                            -- 1. Kunci posisi (Anchored) & hapus sisa kecepatan physics
                            obj.Anchored = true
                            obj.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                            obj.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                            
                            -- 2. Hapus Joint/Constraint penyulut goyang (seperti HingeConstraint, RopeConstraint, BodyMover, dll)
                            for _, child in ipairs(obj:GetChildren()) do
                                if child:IsA("Constraint") or child:IsA("JointInstance") or child:IsA("BodyMover") then
                                    child:Destroy()
                                end
                            end

                            affectedCount = affectedCount + 1
                        end
                    end
                end

                notify("Anti-Goyang", "Berhasil mengunci " .. affectedCount .. " part dalam radius " .. radius .. " studs!")
            end
        }
    }
}

return Plugin
