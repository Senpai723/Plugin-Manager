local RunService = game:GetService("RunService")
local lockedParts = {}
local connection = nil

-- Loop yang berjalan tiap frame untuk memastikan part tetap terkunci di tempatnya
local function startLoop()
    if connection then return end
    connection = RunService.RenderStepped:Connect(function()
        for obj, savedCFrame in pairs(lockedParts) do
            if obj and obj.Parent then
                obj.Anchored = true
                obj.CFrame = savedCFrame -- Paksa posisi dan rotasinya agar tidak bergerak/goyang
                obj.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                obj.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            else
                lockedParts[obj] = nil
            end
        end
    end)
end

local Plugin = {
    ["PluginName"] = "Anti-Goyang Ultimate",
    ["PluginDescription"] = "Mengunci part bergoyang secara permanen menggunakan real-time loop.",
    ["Commands"] = {
        ["freeze"] = {
            ["ListName"] = "freeze / diam [radius]",
            ["Description"] = "Kunci mati part/tangga bergoyang secara real-time di sekitar kamu.",
            ["Aliases"] = {"diam", "unsway", "antigoyang"},
            ["Function"] = function(args, speaker)
                local radius = tonumber(args[1]) or 100
                local char = speaker.Character or speaker.CharacterAdded:Wait()
                
                if not char or not char:FindFirstChild("HumanoidRootPart") then
                    notify("Anti-Goyang", "Karakter tidak ditemukan!")
                    return
                end

                local rootPos = char.HumanoidRootPart.Position
                local count = 0

                for _, obj in ipairs(game:GetService("Workspace"):GetDescendants()) do
                    if obj:IsA("BasePart") and not obj:IsDescendantOf(char) then
                        if (obj.Position - rootPos).Magnitude <= radius then
                            -- Simpan posisi diamnya, lalu masukkan ke daftar koki (lockedParts)
                            lockedParts[obj] = obj.CFrame
                            obj.Anchored = true
                            
                            -- Hapus constraint/joint pengganggu
                            for _, child in ipairs(obj:GetChildren()) do
                                if child:IsA("Constraint") or child:IsA("JointInstance") or child:IsA("BodyMover") then
                                    child:Destroy()
                                end
                            end

                            count = count + 1
                        end
                    end
                end

                startLoop()
                notify("Anti-Goyang", "Berhasil mengunci mati " .. count .. " part secara permanen!")
            end
        },
        ["unfreeze"] = {
            ["ListName"] = "unfreeze / nyala",
            ["Description"] = "Matikan pengunci real-time dan lepaskan semua part.",
            ["Aliases"] = {"nyala", "bergerak"},
            ["Function"] = function(args, speaker)
                -- Bersihkan daftar dan matikan loop
                table.clear(lockedParts)
                if connection then
                    connection:Disconnect()
                    connection = nil
                end
                notify("Anti-Goyang", "Semua kunci dilepas dan loop dihentikan!")
            end
        }
    }
}

return Plugin
