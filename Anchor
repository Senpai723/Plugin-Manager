local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- STORAGE GLOBAL & RESET MEMORI UNTUK ANTI-GOYANG
_G.AntiGoyang_LockedParts = _G.AntiGoyang_LockedParts or {}
_G.AntiGoyang_Connection = _G.AntiGoyang_Connection or nil

local function notify(text)
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "Anti-Goyang Stabilizer",
            Text = text,
            Duration = 3
        })
    end)
end

-- ==========================================
-- 🔄 REAL-TIME LOOP UNTUK MENGUNCI PART
-- ==========================================
local function startStabilizerLoop()
    if _G.AntiGoyang_Connection then return end
    _G.AntiGoyang_Connection = RunService.RenderStepped:Connect(function()
        for obj, savedCFrame in pairs(_G.AntiGoyang_LockedParts) do
            if obj and obj.Parent then
                obj.Anchored = true
                obj.CFrame = savedCFrame
                obj.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                obj.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            else
                _G.AntiGoyang_LockedParts[obj] = nil
            end
        end
    end)
end

local function stopStabilizerLoop()
    -- Kembalikan status part ke tidak anchored (atau dilepas kuncinya)
    for obj, _ in pairs(_G.AntiGoyang_LockedParts) do
        if obj and obj.Parent then
            obj.Anchored = false
        end
    end
    
    table.clear(_G.AntiGoyang_LockedParts)
    
    if _G.AntiGoyang_Connection then
        _G.AntiGoyang_Connection:Disconnect()
        _G.AntiGoyang_Connection = nil
    end
end

-- ==========================================
-- 🔍 FUNGSI UTAMA FREEZE & UNFREEZE
-- ==========================================
local function freezeNearbyParts(radiusVal)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then
        notify("Karakter / HumanoidRootPart tidak ditemukan!")
        return
    end

    local rootPos = char.HumanoidRootPart.Position
    local count = 0

    for _, obj in ipairs(game:GetService("Workspace"):GetDescendants()) do
        if obj:IsA("BasePart") and not obj:IsDescendantOf(char) then
            if (obj.Position - rootPos).Magnitude <= radiusVal then
                _G.AntiGoyang_LockedParts[obj] = obj.CFrame
                obj.Anchored = true
                
                -- Hancurkan script penggerak atau constraint di dalam part
                for _, child in ipairs(obj:GetChildren()) do
                    if child:IsA("Script") or child:IsA("LocalScript") or child:IsA("Constraint") or child:IsA("JointInstance") or child:IsA("BodyMover") then
                        child:Destroy()
                    end
                end

                count = count + 1
            end
        end
    end

    startStabilizerLoop()
    notify("Berhasil mengunci mati " .. count .. " part dalam radius " .. radiusVal .. " studs!")
end

local function unfreezeAllParts()
    stopStabilizerLoop()
    notify("Semua kunci part dilepas dan loop dihentikan!")
end

-- ==========================================
-- 📦 RETURN PLUGIN INFINITE YIELD
-- ==========================================
return {
    ["PluginName"] = "Anti-Goyang Stabilizer",
    ["Commands"] = {
        ["freeze"] = {
            ["ListName"] = "freeze / diam [radius]",
            ["Description"] = "Kunci mati part/tangga bergoyang di sekitar kamu",
            ["Aliases"] = {"diam", "antigoyang"},
            ["Function"] = function(args, speaker)
                local radius = tonumber(args[1]) or 150
                freezeNearbyParts(radius)
            end
        },
        ["unfreeze"] = {
            ["ListName"] = "unfreeze / nyala",
            ["Description"] = "Matikan pengunci dan lepaskan part",
            ["Aliases"] = {"nyala", "bergerak", "unbound"},
            ["Function"] = function(args, speaker)
                unfreezeAllParts()
            end
        }
    }
}
