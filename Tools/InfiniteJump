local plugin = {
    ["PluginName"] = "infinite_jump";
    ["PluginDescription"] = "Memungkinkan karakter melompat terus-menerus di udara.";
    ["Commands"] = {
        ["infjump"] = {
            ["ListName"] = "infjump",
            ["Description"] = "Mengaktifkan Infinite Jump.",
            ["Aliases"] = {"ijump"},
            ["Function"] = function(args, speaker)
                local UserInputService = game:GetService("UserInputService")
                local RunService = game:GetService("RunService")

                if _G.InfiniteJumpConnection then
                    _G.InfiniteJumpConnection:Disconnect()
                    _G.InfiniteJumpConnection = nil
                end

                _G.InfiniteJumpConnection = UserInputService.JumpRequest:Connect(function()
                    local char = speaker.Character
                    if char then
                        local hum = char:FindFirstChildOfClass("Humanoid")
                        if hum then
                            hum:ChangeState(Enum.HumanoidStateType.Jumping)
                        end
                    end
                end)
                
                print("[Infinite Jump] Berhasil diaktifkan!")
            end
        },
        ["uninfjump"] = {
            ["ListName"] = "uninfjump",
            ["Description"] = "Menonaktifkan Infinite Jump.",
            ["Aliases"] = {"unijump"},
            ["Function"] = function(args, speaker)
                if _G.InfiniteJumpConnection then
                    _G.InfiniteJumpConnection:Disconnect()
                    _G.InfiniteJumpConnection = nil
                end
                
                print("[Infinite Jump] Berhasil dimatikan!")
            end
        }
    }
}

return plugin
