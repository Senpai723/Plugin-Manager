-- Mobile Click Inspector & JSON Exporter (Optimized for Mobile)
local Plugin = {
    PluginName = 'Mobile Click Inspector',
    PluginDescription = 'Simple touch inspector & JSON exporter optimized for mobile devices.',
    Commands = {},
}

local Players = game:GetService('Players')
local Workspace = game:GetService('Workspace')
local UserInputService = game:GetService('UserInputService')
local HttpService = game:GetService('HttpService')
local CoreGui = game:GetService('CoreGui')
local LocalPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera

local SINGLETON_KEY = '__IY_MOBILE_INSPECTOR'
if _G[SINGLETON_KEY] then
    pcall(function() _G[SINGLETON_KEY]:Destroy() end)
    _G[SINGLETON_KEY] = nil
end

local Controller = {}
Controller.__index = Controller

local function make(class, properties, parent)
    local obj = Instance.new(class)
    for k, v in pairs(properties or {}) do
        obj[k] = v
    end
    obj.Parent = parent
    return obj
end

local function getFullPath(object)
    local ok, path = pcall(function() return object:GetFullName() end)
    return ok and path or (object.Name or "Unknown")
end

-- Fungsi sederhana untuk serialize instance ke tabel/JSON
local function serializeInstance(object)
    if not object or typeof(object) ~= "Instance" then return nil end
    local data = {
        Name = object.Name,
        ClassName = object.ClassName,
        Path = getFullPath(object),
        Properties = {},
        Children = {}
    }

    -- Ambil beberapa properti penting jika ada
    pcall(function()
        if object:IsA("BasePart") then
            data.Properties.Position = {object.Position.X, object.Position.Y, object.Position.Z}
            data.Properties.Size = {object.Size.X, object.Size.Y, object.Size.Z}
            data.Properties.Anchored = object.Anchored
            data.Properties.CanCollide = object.CanCollide
        elseif object:IsA("Model") then
            data.Properties.PrimaryPart = object.PrimaryPart and object.PrimaryPart.Name or nil
        end
    end)

    -- Ambil children (anak/komponen di dalam seperti TouchInterest, BillboardGui, dll)
    local ok, children = pcall(function() return object:GetChildren() end)
    if ok then
        for _, child in ipairs(children) do
            table.insert(data.Children, {
                Name = child.Name,
                ClassName = child.ClassName
            })
        end
    end

    return data
end

function Controller.new()
    local self = setmetatable({
        Connections = {},
        Active = true,
        SelectedObject = nil,
    }, Controller)

    _G[SINGLETON_KEY] = self

    -- UI Utama
    local gui = make('ScreenGui', {
        Name = 'MobileInspectorGui',
        IgnoreGuiInset = true,
        ResetOnSpawn = false,
        DisplayOrder = 999999,
    })
    
    local parentOk = pcall(function() gui.Parent = CoreGui end)
    if not parentOk then
        gui.Parent = LocalPlayer:WaitForChild("PlayerGui")
    end
    self.Gui = gui

    -- Main Frame
    local frame = make('Frame', {
        Size = UDim2.new(0, 300, 0, 360),
        Position = UDim2.new(0.5, -150, 0.4, -180),
        BackgroundColor3 = Color3.fromRGB(30, 30, 30),
        BorderSizePixel = 0,
        Active = true,
        Draggable = true,
    }, gui)
    make('UICorner', {CornerRadius = UDim.new(0, 8)}, frame)
    self.Window = frame

    -- TopBar
    local topBar = make('Frame', {
        Size = UDim2.new(1, 0, 0, 30),
        BackgroundColor3 = Color3.fromRGB(45, 45, 45),
        BorderSizePixel = 0,
    }, frame)
    make('UICorner', {CornerRadius = UDim.new(0, 8)}, topBar)

    make('TextLabel', {
        Size = UDim2.new(1, -60, 1, 0),
        Position = UDim2.new(0, 8, 0, 0),
        BackgroundTransparency = 1,
        Text = "Mobile Inspector",
        TextColor3 = Color3.fromRGB(255, 255, 255),
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, topBar)

    -- Tombol Minimize (-)
    local minBtn = make('TextButton', {
        Size = UDim2.new(0, 22, 0, 22),
        Position = UDim2.new(1, -52, 0, 4),
        BackgroundColor3 = Color3.fromRGB(70, 70, 70),
        Text = "-",
        TextColor3 = Color3.fromRGB(255, 255, 255),
        Font = Enum.Font.GothamBold,
        TextSize = 12,
    }, topBar)
    make('UICorner', {CornerRadius = UDim.new(0, 4)}, minBtn)

    -- Tombol Close (X)
    local closeBtn = make('TextButton', {
        Size = UDim2.new(0, 22, 0, 22),
        Position = UDim2.new(1, -26, 0, 4),
        BackgroundColor3 = Color3.fromRGB(200, 50, 50),
        Text = "X",
        TextColor3 = Color3.fromRGB(255, 255, 255),
        Font = Enum.Font.GothamBold,
        TextSize = 10,
    }, topBar)
    make('UICorner', {CornerRadius = UDim.new(0, 4)}, closeBtn)

    -- Content Area
    local content = make('ScrollingFrame', {
        Size = UDim2.new(1, -16, 1, -40),
        Position = UDim2.new(0, 8, 0, 35),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 4,
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        CanvasSize = UDim2.new(0,0,0,0),
    }, frame)
    make('UIListLayout', {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6)}, content)

    -- Label Status Instruksi
    make('TextLabel', {
        Size = UDim2.new(1, 0, 0, 24),
        BackgroundTransparency = 1,
        Text = "Status: Tap Part di layar game!",
        TextColor3 = Color3.fromRGB(0, 220, 255),
        Font = Enum.Font.GothamBold,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, content)

    -- Kotak Info Nama & Kelas
    local infoBox = make('TextBox', {
        Size = UDim2.new(1, 0, 0, 60),
        BackgroundColor3 = Color3.fromRGB(20, 20, 20),
        TextColor3 = Color3.fromRGB(255, 255, 255),
        Font = Enum.Font.Gotham,
        TextSize = 11,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        ClearTextOnFocus = false,
        TextEditable = false,
        Text = "Belum ada objek yang dipilih...",
    }, content)
    make('UICorner', {CornerRadius = UDim.new(0, 4)}, infoBox)
    make('UIPadding', {PaddingLeft = UDim.new(0,5), PaddingRight = UDim.new(0,5), PaddingTop = UDim.new(0,5)}, infoBox)

    -- Kotak Path Lengkap
    local pathBox = make('TextBox', {
        Size = UDim2.new(1, 0, 0, 70),
        BackgroundColor3 = Color3.fromRGB(20, 20, 20),
        TextColor3 = Color3.fromRGB(0, 255, 150),
        Font = Enum.Font.Gotham,
        TextSize = 11,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        ClearTextOnFocus = false,
        TextEditable = false,
        Text = "Path: -",
    }, content)
    make('UICorner', {CornerRadius = UDim.new(0, 4)}, pathBox)
    make('UIPadding', {PaddingLeft = UDim.new(0,5), PaddingRight = UDim.new(0,5), PaddingTop = UDim.new(0,5)}, pathBox)

    -- Tombol Copy Path
    local copyBtn = make('TextButton', {
        Size = UDim2.new(1, 0, 0, 28),
        BackgroundColor3 = Color3.fromRGB(50, 120, 220),
        Text = "COPY FULL PATH",
        TextColor3 = Color3.fromRGB(255, 255, 255),
        Font = Enum.Font.GothamBold,
        TextSize = 11,
    }, content)
    make('UICorner', {CornerRadius = UDim.new(0, 4)}, copyBtn)

    -- Tombol Export JSON
    local exportBtn = make('TextButton', {
        Size = UDim2.new(1, 0, 0, 28),
        BackgroundColor3 = Color3.fromRGB(0, 150, 90),
        Text = "EXPORT TO JSON FILE",
        TextColor3 = Color3.fromRGB(255, 255, 255),
        Font = Enum.Font.GothamBold,
        TextSize = 11,
    }, content)
    make('UICorner', {CornerRadius = UDim.new(0, 4)}, exportBtn)

    -- Status Export
    local exportStatus = make('TextLabel', {
        Size = UDim2.new(1, 0, 0, 40),
        BackgroundTransparency = 1,
        Text = "",
        TextColor3 = Color3.fromRGB(200, 200, 200),
        Font = Enum.Font.Gotham,
        TextSize = 10,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
    }, content)

    -- Logika Tap/Sentuh Layar HP (Mobile Raycast)
    table.insert(self.Connections, UserInputService.TouchTapInWorld:Connect(function(position, processed)
        if processed or not self.Active then return end
        
        local ray = Camera:ViewportPointToRay(position.X, position.Y)
        local raycastParams = RaycastParams.new()
        raycastParams.FilterType = Enum.RaycastFilterType.Exclude
        if LocalPlayer.Character then
            raycastParams.FilterDescendantsInstances = {LocalPlayer.Character}
        end

        local result = Workspace:Raycast(ray.Origin, ray.Direction * 500, raycastParams)
        if result and result.Instance then
            local hitPart = result.Instance
            self.SelectedObject = hitPart

            local p = getFullPath(hitPart)
            pathBox.Text = "Path: " .. p

            -- Scan children di dalamnya
            local childList = {}
            for _, child in ipairs(hitPart:GetChildren()) do
                table.insert(childList, child.Name .. " (" .. child.ClassName .. ")")
            end

            infoBox.Text = string.format("Name: %s\nClass: %s\nChildren: %s", 
                hitPart.Name, 
                hitPart.ClassName, 
                #childList > 0 and table.concat(childList, ", ") or "None"
            )
            exportStatus.Text = "Objek berhasil dipilih! Siap di-export atau copy path."
        end
    end))

    -- Tombol Copy Action
    copyBtn.MouseButton1Click:Connect(function()
        if self.SelectedObject then
            local p = getFullPath(self.SelectedObject)
            pcall(function() setclipboard(p) end)
            exportStatus.Text = "Berhasil copy path ke clipboard!"
        else
            exportStatus.Text = "Pilih part terlebih dahulu dengan tap di layar!"
        end
    end)

    -- Tombol Export JSON Action
    exportBtn.MouseButton1Click:Connect(function()
        if not self.SelectedObject then
            exportStatus.Text = "Error: Belum ada objek yang dipilih!"
            return
        end

        local success, err = pcall(function()
            local folderName = "MobileInspectorExports"
            if not isfolder(folderName) then
                makefolder(folderName)
            end

            local data = serializeInstance(self.SelectedObject)
            local jsonStr = HttpService:JSONEncode(data)
            
            local fileName = folderName .. "/" .. self.SelectedObject.Name .. "_" .. os.time() .. ".json"
            writefile(fileName, jsonStr)
            exportStatus.Text = "Saved to: " .. fileName
        end)

        if not success then
            exportStatus.Text = "Export Gagal: " .. tostring(err)
        end
    end)

    -- Minimize Toggle Logic
    local minimized = false
    minBtn.MouseButton1Click:Connect(function()
        minimized = not minimized
        if minimized then
            frame.Size = UDim2.new(0, 300, 0, 30)
            content.Visible = false
            minBtn.Text = "+"
        else
            frame.Size = UDim2.new(0, 300, 0, 360)
            content.Visible = true
            minBtn.Text = "-"
        end
    end)

    -- Close Logic
    closeBtn.MouseButton1Click:Connect(function()
        self:Destroy()
    end)

    return self
end

function Controller:Destroy()
    self.Active = false
    for _, conn in ipairs(self.Connections) do
        pcall(function() conn:Disconnect() end)
    end
    if self.Gui then
        self.Gui:Destroy()
    end
    _G[SINGLETON_KEY] = nil
end

Plugin.Commands.mobileinspector = {
    ListName = 'mobileinspector / mobinsp',
    Description = 'Open mobile-friendly click inspector and JSON exporter.',
    Aliases = {'mobinsp'},
    Function = function()
        Controller.new()
    end,
}

Plugin.Commands.unmobileinspector = {
    ListName = 'unmobileinspector',
    Description = 'Close mobile click inspector.',
    Aliases = {},
    Function = function()
        if _G[SINGLETON_KEY] then
            _G[SINGLETON_KEY]:Destroy()
        end
    end,
}

return Plugin
