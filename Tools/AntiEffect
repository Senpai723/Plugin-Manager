        },
        ["unwind"] = {
            ["ListName"] = "unwind / normalangin",
            ["Description"] = "Nyalakan kembali efek angin seperti semula",
            ["Aliases"] = {"normalangin"},
            ["Function"] = function(args, speaker)
                restoreWindForces()
            end
        },
        ["antishake"] = {
            ["ListName"] = "antishake / noshake",
            ["Description"] = "Kunci mutlak getaran kamera (Absolute Camera Stabilization)",
            ["Aliases"] = {"noshake"},
            ["Function"] = function(args, speaker)
                _G.AntiShake_Active = true
                notify("Anti-Camera Shake: AKTIF 🟢 (Kamera dikunci stabil)")
            end
        },
        ["unshake"] = {
            ["ListName"] = "unshake / normalshake",
            ["Description"] = "Kembalikan getaran kamera seperti semula",
            ["Aliases"] = {"normalshake", "ameshake"},
            ["Function"] = function(args, speaker)
                _G.AntiShake_Active = false
                notify("Anti-Camera Shake: MATI 🔴")
            end
        },
        ["antitrigger"] = {
            ["ListName"] = "antitrigger / notrigger [radius]",
            ["Description"] = "Nonaktifkan BridgeTrigger di sekitar kamu",
            ["Aliases"] = {"notrigger", "matitrigger"},
            ["Function"] = function(args, speaker)
                local radius = tonumber(args[1]) or 150
                disableTriggers(radius)
            end
        },
        ["untrigger"] = {
            ["ListName"] = "untrigger / normaltrigger",
            ["Description"] = "Kembalikan BridgeTrigger seperti semula",
            ["Aliases"] = {"normaltrigger", "nyalatrigger"},
            ["Function"] = function(args, speaker)
                restoreTriggers()
            end
        }
    }
}
