local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local LocalPlayer = Players.LocalPlayer

-- STORAGE GLOBAL UNTUK MEMORY STATE
_G.AntiWind_DisabledForces = _G.AntiWind_DisabledForces or {}
_G.AntiTrigger_DisabledTriggers = _G.AntiTrigger_DisabledTriggers or {}
_G.AntiShake_Active = _G.AntiShake_Active or false

local function notify(text)
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "Anti-Disturb Shield Complete",
            Text = text,
            Duration = 3
        })
    end)
end

-- ==========================================
-- 🛡️ 1. FITUR ANTI-WIND & RESTORE
-- ==========================================
local function disableWindForces(radiusVal)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then
        notify("Karakter tidak ditemukan!")
        return
    end

    local rootPos = char.HumanoidRootPart.Position
    local count = 0

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BodyForce") or obj:IsA("VectorForce") or obj:IsA("LinearVelocity") or (obj.Name:lower():find("wind") and obj:IsA("BasePart")) then
            local pos = obj:IsA("BasePart") and obj.Position or (obj.Parent and obj.Parent:IsA("BasePart") and obj.Parent.Position)
            if pos and (pos - rootPos).Magnitude <= radiusVal then
                if not _G.AntiWind_DisabledForces[obj] then
                    _G.AntiWind_DisabledForces[obj] = {
                        Enabled = obj.Enabled or true
                    }
                end
                
                if obj:IsA("BodyForce") then
                    obj.Force = Vector3.new(0, 0, 0)
                elseif obj.Enabled ~= nil then
                    obj.Enabled = false
                end
                count = count + 1
            end
        end
    end

    if Workspace:FindFirstChildOfClass("Wind") then
        Workspace:FindFirstChildOfClass("Wind").Enabled = false
    end

    notify("Berhasil meredam " .. count .. " efek angin/dorongan!")
end

local function restoreWindForces()
    local count = 0
    for obj, data in pairs(_G.AntiWind_DisabledForces) do
        if obj and obj.Parent then
            if obj:IsA("BodyForce") then
                obj.Force = Vector3.new(0, 0, 0)
            elseif obj.Enabled ~= nil then
                obj.Enabled = data.Enabled
            end
            count = count + 1
        end
    end
    
    if Workspace:FindFirstChildOfClass("Wind") then
        Workspace:FindFirstChildOfClass("Wind").Enabled = true
    end

    table.clear(_G.AntiWind_DisabledForces)
    notify("Efek angin dikembalikan normal (" .. count .. " dipulihkan)!")
end

-- ==========================================
-- 🛑 2. FITUR ANTI-TRIGGER & RESTORE
-- ==========================================
local function disableTriggers(radiusVal)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then
        notify("Karakter tidak ditemukan!")
        return
    end

    local rootPos = char.HumanoidRootPart.Position
    local count = 0

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj.Name:lower():find("trigger") or obj.Name:lower():find("shake") or obj.Name:lower():find("sensor") then
            local pos = nil
            if obj:IsA("BasePart") then
                pos = obj.Position
            elseif obj:IsA("Model") and obj.PrimaryPart then
                pos = obj.PrimaryPart.Position
            end

            if pos and (pos - rootPos).Magnitude <= radiusVal then
                -- Simpan state asli
                if not _G.AntiTrigger_DisabledTriggers[obj] then
                    _G.AntiTrigger_DisabledTriggers[obj] = {
                        CanTouch = obj:IsA("BasePart") and obj.CanTouch or nil
                    }
                end

                -- Matikan fungsi sensor sentuh tanpa menghapus objeknya
                if obj:IsA("BasePart") then
                    obj.CanTouch = false
                end

                -- Matikan script/TouchInterest di dalamnya
                for _, child in ipairs(obj:GetChildren()) do
                    if child:IsA("TouchTransmitter") or child:IsA("Script") or child:IsA("LocalScript") then
                        if not _G.AntiTrigger_DisabledTriggers[child] then
                            _G.AntiTrigger_DisabledTriggers[child] = {
                                Enabled = child:IsA("Script") or child:IsA("LocalScript") and child.Disabled or nil
                            }
                        end
                        if child:IsA("Script") or child:IsA("LocalScript") then
                            child.Disabled = true
                        end
                    end
                end

                count = count + 1
            end
        end
    end

    notify("Berhasil mematikan " .. count .. " BridgeTrigger/Pemicu!")
end

local function restoreTriggers()
    local count = 0
    for obj, data in pairs(_G.AntiTrigger_DisabledTriggers) do
        if obj and obj.Parent then
            if obj:IsA("BasePart") and data.CanTouch ~= nil then
                obj.CanTouch = data.CanTouch
            elseif (obj:IsA("Script") or obj:IsA("LocalScript")) and data.Enabled ~= nil then
                obj.Disabled = data.Enabled
            end
            count = count + 1
        end
    end

    table.clear(_G.AntiTrigger_DisabledTriggers)
    notify("Semua BridgeTrigger/Pemicu dikembalikan normal!")
end

-- ==========================================
-- 📷 3. FITUR ANTI-CAMERA SHAKE LOOP
-- ==========================================
RunService.RenderStepped:Connect(function()
    if _G.AntiShake_Active then
        pcall(function()
            for _, scriptObj in ipairs(LocalPlayer:GetDescendants()) do
                if scriptObj:IsA("LocalScript") and (scriptObj.Name:lower():find("shake") or scriptObj.Name:lower():find("camera") or scriptObj.Name:lower():find("bobble")) then
                    scriptObj.Disabled = true
                end
            end
        end)
    end
end)

-- ==========================================
-- 📦 RETURN PLUGIN INFINITE YIELD
-- ==========================================
return {
    ["PluginName"] = "Anti-Disturb Shield Complete",
    ["Commands"] = {
        ["antiwind"] = {
            ["ListName"] = "antiwind / nowind [radius]",
            ["Description"] = "Matikan efek angin/dorongan yang bikin karakter geser",
            ["Aliases"] = {"nowind", "tahanangin"},
            ["Function"] = function(args, speaker)
                local radius = tonumber(args[1]) or 150
                disableWindForces(radius)
            end
        },
        ["unwind"] = {
            ["ListName"] = "unwind / normalangin",
            ["Description"] = "Nyalakan kembali efek angin seperti semula",
            ["Aliases"] = {"normalangin"},
            ["Function"] = function(args, speaker)
                restoreWindForces()
            end
        },
        ["antishake"] = {
            ["ListName"] = "antishake / noshake",
            ["Description"] = "Matikan getaran kamera (camera shake)",
            ["Aliases"] = {"noshake"},
            ["Function"] = function(args, speaker)
                _G.AntiShake_Active = true
                notify("Anti-Camera Shake: AKTIF 🟢")
            end
        },
        ["unshake"] = {
            ["ListName"] = "unshake / normalshake",
            ["Description"] = "Kembalikan getaran kamera seperti semula",
            ["Aliases"] = {"normalshake", "ameshake"},
            ["Function"] = function(args, speaker)
                _G.AntiShake_Active = false
                notify("Anti-Camera Shake: MATI 🔴")
            end
        },
        ["antitrigger"] = {
            ["ListName"] = "antitrigger / notrigger [radius]",
            ["Description"] = "Matikan pemicu getaran / BridgeTrigger di sekitar kamu",
            ["Aliases"] = {"notrigger", "matitrigger"},
            ["Function"] = function(args, speaker)
                local radius = tonumber(args[1]) or 150
                disableTriggers(radius)
            end
        },
        ["untrigger"] = {
            ["ListName"] = "untrigger / normaltrigger",
            ["Description"] = "Kembalikan fungsi pemicu getaran / BridgeTrigger seperti semula",
            ["Aliases"] = {"normaltrigger", "nyalatrigger"},
            ["Function"] = function(args, speaker)
                restoreTriggers()
            end
        }
    }
}
