local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local LocalPlayer = Players.LocalPlayer

-- STORAGE GLOBAL UNTUK MEMORY STATE
_G.AntiAnchor_FrozenParts = _G.AntiAnchor_FrozenParts or {}
_G.AntiWind_DisabledForces = _G.AntiWind_DisabledForces or {}
_G.AntiTrigger_DisabledTriggers = _G.AntiTrigger_DisabledTriggers or {}
_G.AntiShake_Active = _G.AntiShake_Active or false

local function notify(title, text)
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = title,
            Text = text,
            Duration = 4
        })
    end)
end

-- ==========================================
-- ⚓ 1. FITUR ANCHOR & UNANCHOR
-- ==========================================
local function freezeNearbyParts(radiusVal)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then
        notify("Anchor", "Karakter tidak ditemukan!")
        return
    end

    local rootPos = char.HumanoidRootPart.Position
    local count = 0

    for _, part in ipairs(Workspace:GetDescendants()) do
        if part:IsA("BasePart") and not part.Anchored and not part:IsDescendantOf(char) then
            if (part.Position - rootPos).Magnitude <= radiusVal then
                if not _G.AntiAnchor_FrozenParts[part] then
                    _G.AntiAnchor_FrozenParts[part] = {
                        CanCollide = part.CanCollide,
                        Color = part.Color
                    }
                end
                part.Anchored = true
                part.CanCollide = true
                part.Color = Color3.fromRGB(255, 255, 0) -- Berubah jadi kuning sebagai tanda di-anchor
                count = count + 1
            end
        end
    end

    notify("⚓ ANCHOR: AKTIF 🟢", "Berhasil mengunci " .. count .. " part di sekitar!")
end

local function unfreezeParts()
    local count = 0
    for part, data in pairs(_G.AntiAnchor_FrozenParts) do
        if part and part.Parent then
            part.Anchored = false
            part.CanCollide = data.CanCollide
            part.Color = data.Color
            count = count + 1
        end
    end

    table.clear(_G.AntiAnchor_FrozenParts)
    notify("⚓ ANCHOR: MATI 🔴", "Semua part (" .. count .. ") dikembalikan normal!")
end

-- ==========================================
-- 🛡️ 2. FITUR ANTI-WIND & UNWIND
-- ==========================================
local function disableWindForces(radiusVal)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then
        notify("Anti-Wind", "Karakter tidak ditemukan!")
        return
    end

    local rootPos = char.HumanoidRootPart.Position
    local count = 0

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BodyForce") or obj:IsA("VectorForce") or obj:IsA("LinearVelocity") or (obj.Name:lower():find("wind") and obj:IsA("BasePart")) then
            local pos = obj:IsA("BasePart") and obj.Position or (obj.Parent and obj.Parent:IsA("BasePart") and obj.Parent.Position)
            if pos and (pos - rootPos).Magnitude <= radiusVal then
                if not _G.AntiWind_DisabledForces[obj] then
                    _G.AntiWind_DisabledForces[obj] = {
                        Enabled = obj.Enabled or true
                    }
                end
                
                if obj:IsA("BodyForce") then
                    obj.Force = Vector3.new(0, 0, 0)
                elseif obj.Enabled ~= nil then
                    obj.Enabled = false
                end
                count = count + 1
            end
        end
    end

    if Workspace:FindFirstChildOfClass("Wind") then
        Workspace:FindFirstChildOfClass("Wind").Enabled = false
    end

    notify("🛡️ ANTI-WIND: AKTIF 🟢", "Berhasil meredam " .. count .. " efek angin!")
end

local function restoreWindForces()
    local count = 0
    for obj, data in pairs(_G.AntiWind_DisabledForces) do
        if obj and obj.Parent then
            if obj:IsA("BodyForce") then
                obj.Force = Vector3.new(0, 0, 0)
            elseif obj.Enabled ~= nil then
                obj.Enabled = data.Enabled
            end
            count = count + 1
        end
    end
    
    if Workspace:FindFirstChildOfClass("Wind") then
        Workspace:FindFirstChildOfClass("Wind").Enabled = true
    end

    table.clear(_G.AntiWind_DisabledForces)
    notify("🛡️ ANTI-WIND: MATI 🔴", "Efek angin dikembalikan normal!")
end

-- ==========================================
-- 🛑 3. FITUR ANTI-TRIGGER & UNTRIGGER
-- ==========================================
local function disableTriggers(radiusVal)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then
        notify("Anti-Trigger", "Karakter tidak ditemukan!")
        return
    end

    local rootPos = char.HumanoidRootPart.Position
    local count = 0

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj.Name:lower():find("trigger") or obj.Name:lower():find("shake") or obj.Name:lower():find("sensor") then
            local pos = nil
            if obj:IsA("BasePart") then
                pos = obj.Position
            elseif obj:IsA("Model") and obj.PrimaryPart then
                pos = obj.PrimaryPart.Position
            end

            if pos and (pos - rootPos).Magnitude <= radiusVal then
                if not _G.AntiTrigger_DisabledTriggers[obj] then
                    _G.AntiTrigger_DisabledTriggers[obj] = {
                        CanTouch = obj:IsA("BasePart") and obj.CanTouch or nil,
                        Transparency = obj:IsA("BasePart") and obj.Transparency or nil
                    }
                end

                if obj:IsA("BasePart") then
                    obj.CanTouch = false
                    obj.Transparency = 0.8
                end

                count = count + 1
            end
        end
    end

    notify("🛑 ANTI-TRIGGER: AKTIF 🟢", "Menonaktifkan " .. count .. " trigger!")
end

local function restoreTriggers()
    local count = 0
    for obj, data in pairs(_G.AntiTrigger_DisabledTriggers) do
        if obj and obj.Parent then
            if obj:IsA("BasePart") then
                if data.CanTouch ~= nil then obj.CanTouch = data.CanTouch end
                if data.Transparency ~= nil then obj.Transparency = data.Transparency end
            end
            count = count + 1
        end
    end

    table.clear(_G.AntiTrigger_DisabledTriggers)
    notify("🛑 ANTI-TRIGGER: MATI 🔴", "Trigger dikembalikan normal!")
end

-- ==========================================
-- 📷 4. ANTI-CAMERA SHAKE LOOP
-- ==========================================
