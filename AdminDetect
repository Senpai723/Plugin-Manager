-- ==========================================
-- 💬 CHAT PREFIX & TAG SCANNER
-- ==========================================
local function validatePrefixText(prefixStr)
    local lowerPrefix = string.lower(prefixStr or "")
    if string.find(lowerPrefix, "kekasih") or string.find(lowerPrefix, "abang") or string.find(lowerPrefix, "king") or string.find(lowerPrefix, "princess") or string.find(lowerPrefix, "pendaki") or string.find(lowerPrefix, "looking for more games") or string.find(lowerPrefix, "kohl's admin") or string.find(lowerPrefix, "vip") or string.find(lowerPrefix, "biduan") or string.find(lowerPrefix, "member") or string.find(lowerPrefix, "blonde") then
        return false, ""
    end

    local isCrownOwner = string.find(prefixStr, "👑") and (string.find(lowerPrefix, "pemilik") or string.find(lowerPrefix, "owner") or string.find(lowerPrefix, "founder") or string.find(lowerPrefix, "admin") or string.find(lowerPrefix, "dev"))
    if string.find(prefixStr, "🛡️") or string.find(prefixStr, "🔨") or isCrownOwner or string.match(lowerPrefix, "%f[%a]admin%f[%A]") or string.match(lowerPrefix, "%f[%a]dev%f[%A]") or string.match(lowerPrefix, "%f[%a]mod%f[%A]") or string.match(lowerPrefix, "%f[%a]staff%f[%A]") or lowerPrefix == "pemilik" then
        return true, prefixStr ~= "" and prefixStr or "Chat Admin Tag"
    end
    return false, ""
end

pcall(function()
    local DefaultChatSystem = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
    if DefaultChatSystem and DefaultChatSystem:FindFirstChild("OnMessageDoneFiltering") then
        DefaultChatSystem.OnMessageDoneFiltering.OnClientEvent:Connect(function(messageData)
            local speakerName = messageData.FromSpeaker
            local player = Players:FindFirstChild(speakerName)
            if not player or player == LocalPlayer then return end

            local extraData = messageData.ExtraData or {}
            local prefixText = extraData.PrefixText or ""
            local isValid, roleName = validatePrefixText(prefixText)

            if not isValid and extraData.Tags then
                for _, tag in ipairs(extraData.Tags) do
                    local tTxt = tag.TagText or ""
                    local tValid, tRole = validatePrefixText(tTxt)
                    if tValid then
                        isValid = true
                        roleName = "[" .. tTxt .. "] Chat Tag"
                        break
                    end
                end
            end

            if isValid and not _G.AdminDetector_LockedAdmins[player.UserId] then
                _G.AdminDetector_LockedAdmins[player.UserId] = { Name = player.DisplayName, Username = player.Name, Role = roleName }
                scanServerAdmins(false, true)
            end
        end)
    end
end)

pcall(function()
    TextChatService.OnIncomingMessage = function(message)
        if message.TextSource then
            local player = Players:GetPlayerByUserId(message.TextSource.UserId)
            if player and player ~= LocalPlayer then
                local prefix = message.PrefixText or ""
                local isValid, roleName = validatePrefixText(prefix)
                if isValid and not _G.AdminDetector_LockedAdmins[player.UserId] then
                    _G.AdminDetector_LockedAdmins[player.UserId] = { Name = player.DisplayName, Username = player.Name, Role = roleName }
                    scanServerAdmins(false, true)
                end
            end
        end
    end
end)

local function checkPlayerTools(player)
    if not player.Character then return nil end
    local containers = {player.Backpack, player.Character}
    for _, container in ipairs(containers) do
        if container then
            for _, item in ipairs(container:GetChildren()) do
                if item:IsA("Tool") then
                    local toolName = string.lower(item.Name)
                    if (string.find(toolName, "admin") or string.find(toolName, "ban hammer") or string.find(toolName, "mod wand")) and not string.find(toolName, "vip") then
                        return "Stealth Admin 🕵️ (Tool: " .. item.Name .. ")"
                    end
                end
            end
        end
    end
    return nil
end

