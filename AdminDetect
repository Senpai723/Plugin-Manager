-- ==========================================
-- 🔍 MAIN SCANNER (LOGIKA LENGKAP ASLI)
-- ==========================================
local isScanning = false
function scanServerAdmins(isManual, isStateChange)
    if isScanning then return end
    isScanning = true

    task.spawn(function()
        local rawCreatorId = game.CreatorId
        local creatorId = tonumber(rawCreatorId) or 0
        local creatorType = game.CreatorType
        local currentTime = os.time()

        for userId, _ in pairs(_G.AdminDetector_LockedAdmins) do
            local isStillInServer = false
            for _, p in ipairs(Players:GetPlayers()) do
                if p.UserId == userId then isStillInServer = true break end
            end
            if not isStillInServer then _G.AdminDetector_LockedAdmins[userId] = nil end
        end

        local activeAdminsList = {}
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                local isTarget = false
                local detectedRole = ""

                if _G.AdminDetector_LockedAdmins[player.UserId] then
                    isTarget = true
                    detectedRole = _G.AdminDetector_LockedAdmins[player.UserId].Role
                else
                    if creatorId > 1000 then
                        local isUserType = (creatorType == Enum.CreatorType.User) or (tostring(creatorType) == "Enum.CreatorType.User") or (creatorType == 0)
                        if isUserType and player.UserId == creatorId then
                            isTarget = true
                            detectedRole = "Game Owner 🔨"
                        end
                    end

                    local isGroupType = (creatorType == Enum.CreatorType.Group) or (tostring(creatorType) == "Enum.CreatorType.Group") or (creatorType == 1)
                    local playerGroupRank = 0
                    local playerGroupRole = ""

                    if not isTarget and creatorId > 0 and isGroupType then
                        local successRank, rank = pcall(function() return player:GetRankInGroup(creatorId) end)
                        local successRole, roleName = pcall(function() return player:GetRoleInGroup(creatorId) end)
                        if successRank and type(rank) == "number" then playerGroupRank = rank end
                        if successRole and type(roleName) == "string" then playerGroupRole = roleName end

                        if playerGroupRole ~= "" then
                            local lowerRole = string.lower(playerGroupRole)
                            local isErrorMsg = string.find(lowerRole, "error") or string.find(lowerRole, "datamodel") or string.find(lowerRole, "not in")
                            if not isErrorMsg then
                                local isDevRole = string.find(lowerRole, "dev") or string.find(lowerRole, "creator") or string.find(lowerRole, "owner") or string.find(lowerRole, "admin") or string.find(lowerRole, "staff") or string.find(lowerRole, "mod") or string.find(lowerRole, "collaborator") or string.find(lowerRole, "builder") or string.find(lowerRole, "scripter") or string.find(lowerRole, "helper") or string.find(lowerRole, "manager")
                                if (playerGroupRank >= 2) or isDevRole then
                                    isTarget = true
                                    if playerGroupRank == 255 then
                                        detectedRole = "Group Owner 🔨"
                                    else
                                        detectedRole = (playerGroupRole ~= "" and playerGroupRole) or ("Group Rank " .. tostring(playerGroupRank))
                                    end
                                end
                            end
                        end
                    end

                    if not isTarget and player.Character then
                        for _, obj in ipairs(player.Character:GetDescendants()) do
                            if obj:IsA("TextLabel") or obj:IsA("TextBox") then
                                local rawText = obj.Text or ""
                                local lowerText = string.lower(rawText)
                                local isJunk = string.find(lowerText, "kekasih") or string.find(lowerText, "abang") or string.find(lowerText, "king") or string.find(lowerText, "princess") or string.find(lowerText, "pendaki") or string.find(lowerText, "dhontol") or string.find(lowerText, "patung") or string.find(lowerText, "statue") or string.find(lowerText, "hdadmin") or string.find(lowerText, "founderadmin") or string.find(lowerText, "looking for more games") or string.find(lowerText, "kohl's admin") or string.find(lowerText, "vip") or string.find(lowerText, "biduan") or string.find(lowerText, "member") or string.find(lowerText, "blonde")
                                
                                if not isJunk and rawText ~= "" then
                                    local pName = string.lower(player.Name)
                                    local pDisplayName = string.lower(player.DisplayName)
                                    local isJustPlayerName = (lowerText == pName) or (lowerText == pDisplayName) or string.find(lowerText, pName) or string.find(lowerText, pDisplayName)

                                    if not isJustPlayerName then
                                        local isPurePemilik = (lowerText == "pemilik") or (lowerText == "owner") or (string.find(lowerText, "👑") and (string.find(lowerText, "pemilik") or string.find(lowerText, "owner") or string.find(lowerText, "founder")))
                                        local isCustomPemilikName = string.find(lowerText, "pemilik ") or string.find(lowerText, "pemilik_") or string.find(lowerText, "owner ") or string.find(lowerText, "owner_")

                                        local isVerifiedTag = false
                                        local containsStaffKeyword = isPurePemilik or string.find(lowerText, "founder") or string.find(lowerText, "head admin") or string.find(lowerText, "headadmin") or string.find(lowerText, "super admin") or string.find(lowerText, "admin") or string.find(lowerText, "dev") or string.find(lowerText, "mod") or string.find(playerGroupRole ~= "" and string.lower(playerGroupRole) or "", "staff")

                                        if containsStaffKeyword and not isCustomPemilikName then
                                            if creatorId > 0 and isGroupType then
                                                if playerGroupRank >= 2 or player.UserId == creatorId then isVerifiedTag = true end
                                            else
                                                local hasAdminTool = checkPlayerTools(player)
                                                if hasAdminTool or player.UserId == creatorId then isVerifiedTag = true end
                                            end
                                        end

                                        local hasSpecialTag = string.find(rawText, "🛡️") or string.find(rawText, "🔨") or isVerifiedTag or string.find(lowerText, "pathfinder") or string.find(lowerText, "prioritas") or string.find(lowerText, "apprentice") or string.find(lowerText, "builder") or string.find(lowerText, "scripter") or string.match(lowerText, "%[%s*admin%s*%]") or string.match(lowerText, "%[%s*dev%s*%]")
                                        
                                        if hasSpecialTag then
                                            isTarget = true
                                            detectedRole = rawText
                                            break
                                        end
                                    end
                                end
                            end
                        end
                    end

                    if not isTarget and LocalPlayer.PlayerGui then
                        pcall(function()
                            for _, gui in ipairs(LocalPlayer.PlayerGui:GetDescendants()) do
                                if gui:IsA("TextLabel") then
                                    local txt = gui.Text or ""
                                    if string.find(txt, player.Name) or string.find(txt, player.DisplayName) then
                                        local parentFrame = gui.Parent
                                        if parentFrame then
                                            for _, subObj in ipairs(parentFrame:GetDescendants()) do
                                                if subObj:IsA("TextLabel") and subObj ~= gui then
                                                    local subText = subObj.Text or ""
                                                    local subTxt = string.lower(subText)
                                                    local isAdOrJunk = string.find(subTxt, "looking for more games") or string.find(subTxt, "kohl's admin") or string.find(subTxt, "summit") or string.find(subTxt, "checkpoint") or string.find(subTxt, "open up studio") or string.find(subTxt, "update your loader") or string.find(subTxt, "toolbox") or string.find(subTxt, "vip") or string.find(subTxt, "biduan") or string.find(subTxt, "member") or string.find(subTxt, "blonde")
                                                    
                                                    if not isAdOrJunk and (string.find(subText, "🛡️") or string.find(subText, "🔨") or subTxt == "pemilik" or string.find(subTxt, "admin") or string.find(subTxt, "dev") or string.find(subTxt, "staff") or string.find(subTxt, "%f[%a]mod%f[%A]") or string.find(subText, "builder")) then
                                                        isTarget = true
                                                        detectedRole = subText
                                                        break
                                                    end
                                                end
                                            end
                                        end
                                    end
                                end
                                if isTarget then break end
                            end
                        end)
                    end

                    if not isTarget then
                        local stealthRole = checkPlayerTools(player)
                        if stealthRole then
                            isTarget = true
                            detectedRole = stealthRole
                        end
                    end

                    if isTarget then
                        _G.AdminDetector_LockedAdmins[player.UserId] = { Name = player.DisplayName, Username = player.Name, Role = detectedRole }
                    end
                end

                if isTarget then
                    table.insert(activeAdminsList, { Name = player.DisplayName, Username = player.Name, Role = detectedRole, UserId = player.UserId })
                end
            end
            task.wait()
        end

        table.sort(activeAdminsList, function(a, b) return a.UserId < b.UserId end)
        local currentHash = ""
        for _, item in ipairs(activeAdminsList) do
            currentHash = currentHash .. tostring(item.UserId) .. "_" .. item.Role .. "|"
        end

        local listChanged = (currentHash ~= _G.AdminDetector_LastHash)
        _G.AdminDetector_LastHash = currentHash

                if #activeAdminsList > 0 then
            _G.AdminDetector_HadAdminsBefore = true
            _G.AdminDetector_NoAdminNotified = false
            -- Jika dipanggil manual (isManual), paksa tampilkan UI tanpa menunggu cooldown / perubahan list!
            if listChanged or isManual or (currentTime - _G.AdminDetector_LastNotifyTime) >= 300 then
                _G.AdminDetector_LastNotifyTime = currentTime
                playBeep()
                showScrollableNotify("🚨 ADMIN/DEV DETECTED (" .. #activeAdminsList .. ")", activeAdminsList)
            end
        else
            local isStillLoading = (currentTime - _G.AdminDetector_StartupTime) < 8
            if isStillLoading then isScanning = false return end

            -- Jika dipanggil manual DAN tidak ada admin, berikan feedback teks/notif jelas bahwa kondisi bersih
            if isManual then
                playBeep()
                notify("🛡️ AMAN | Pengecekan Manual: Tidak ada Admin terdeteksi.")
            end

            if _G.AdminDetector_HadAdminsBefore then
                _G.AdminDetector_HadAdminsBefore = false
                _G.AdminDetector_NoAdminNotified = true
                _G.AdminDetector_LastHash = ""
                pcall(function()
                    local oldUI = CoreGui:FindFirstChild("AdminDetectorUI") or (LocalPlayer and LocalPlayer:FindFirstChild("PlayerGui") and LocalPlayer.PlayerGui:FindFirstChild("AdminDetectorUI"))
                    if oldUI then oldUI:Destroy() end
                end)
                playBeep()
                notify("✅ KONDISI AMAN | Semua Admin/Owner telah keluar server!")
            elseif not _G.AdminDetector_NoAdminNotified then
                _G.AdminDetector_NoAdminNotified = true
                notify("🛡️ AMAN | Tidak ada Admin/Owner terdeteksi di server ini.")
            end
        end
        isScanning = false
    end)
end

-- Event Triggers
local function setupPlayerEvents(player)
    player.CharacterAdded:Connect(function(char)
        task.delay(0.5, function() scanServerAdmins(false, false) end)
    end)
    if player.Backpack then
        player.Backpack.ChildAdded:Connect(function() scanServerAdmins(false, false) end)
    end
end

Players.PlayerRemoving:Connect(function(player)
    if _G.AdminDetector_LockedAdmins[player.UserId] then
        _G.AdminDetector_LockedAdmins[player.UserId] = nil
        task.delay(0.3, function() scanServerAdmins(false, true) end)
    end
end)

Players.PlayerAdded:Connect(function(player)
    setupPlayerEvents(player)
    task.delay(1.5, function() scanServerAdmins(false, false) end)
end)

for _, p in ipairs(Players:GetPlayers()) do
    if p ~= LocalPlayer then setupPlayerEvents(p) end
end

-- Periodic Loop
task.spawn(function()
    while true do
        scanServerAdmins(false, false)
        task.wait(30)
    end
end)

-- Pindaian Startup Wajib Auto-Run
task.spawn(function()
    task.wait(2)
    scanServerAdmins(false, true)
    task.wait(2)
    scanServerAdmins(false, true)
end)

return {
    ["PluginName"] = "Admin Detector",
    ["Commands"] = {
        ["cad"] = {
            ["ListName"] = "cad",
            ["Description"] = "Cek manual daftar admin",
            ["Function"] = function(args, speaker)
                scanServerAdmins(true, true)
            end
        }
    }
}
