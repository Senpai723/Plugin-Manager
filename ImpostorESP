local function startImpostorESP()
    local Players = game:GetService("Players")
    local Workspace = game:GetService("Workspace")
    local RunService = game:GetService("RunService")
    local LocalPlayer = Players.LocalPlayer

    if not LocalPlayer then return end

    if LocalPlayer:FindFirstChild("IMPOSTOR_ESP_RUNNING") then
        print("ImpostorESP sudah aktif!")
        return
    end

    local marker = Instance.new("BoolValue")
    marker.Name = "IMPOSTOR_ESP_RUNNING"
    marker.Parent = LocalPlayer

    print("Loading ImpostorESP v3 (Bot Folder & Status Scanner)...")

    local CREW_COLOR = Color3.fromRGB(0, 255, 0)      -- Hijau (Crew / Warga)
    local IMPOSTOR_COLOR = Color3.fromRGB(255, 0, 0)   -- Merah (Impostor / Killer)

    local function checkIsImpostor(targetObject, player)
        -- 1. Cek jika Player
        if player then
            if player.Team then
                local tName = player.Team.Name:lower()
                if string.find(tName, "impostor") or string.find(tName, "murderer") or string.find(tName, "traitor") or string.find(tName, "killer") then
                    return true
                end
            end
            local roleAttr = player:GetAttribute("Role") or player:GetAttribute("Team") or player:GetAttribute("Status")
            if typeof(roleAttr) == "string" and (string.find(roleAttr:lower(), "impostor") or string.find(roleAttr:lower(), "murderer") or string.find(roleAttr:lower(), "killer")) then
                return true
            end
        end

        -- 2. Cek Model Bot (Berdasarkan struktur Dex: Workspace -> Bots -> Bot_Name -> Humanoid -> Status)
        if targetObject and targetObject:IsA("Model") then
            local humanoid = targetObject:FindFirstChildOfClass("Humanoid")
            if humanoid then
                -- Cek Objek "Status" di dalam Humanoid (bisa Value object atau Attribute)
                local statusObj = humanoid:FindFirstChild("Status")
                if statusObj then
                    local valText = ""
                    if statusObj:IsA("StringValue") or statusObj:IsA("ValueBase") then
                        valText = tostring(statusObj.Value):lower()
                    end
                    if string.find(valText, "impostor") or string.find(valText, "murderer") or string.find(valText, "killer") or string.find(valText, "traitor") then
                        return true
                    end
                end

                -- Cek Attribute Status/Role di Humanoid atau Model
                local attrStatus = humanoid:GetAttribute("Status") or humanoid:GetAttribute("Role") or targetObject:GetAttribute("Status") or targetObject:GetAttribute("Role")
                if typeof(attrStatus) == "string" then
                    local s = attrStatus:lower()
                    if string.find(s, "impostor") or string.find(s, "murderer") or string.find(s, "killer") then
                        return true
                    end
                end
            end

            -- Cek Nama Model Bot
            local mName = targetObject.Name:lower()
            if string.find(mName, "impostor") or string.find(mName, "murderer") or string.find(mName, "killer") then
                return true
            end
        end

        return false
    end

    local function applyESP(character, player)
        if not character or not character.Parent then return end
        if LocalPlayer.Character and character == LocalPlayer.Character then return end

        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then
            local hl = character:FindFirstChild("Imp_HL")
            if hl then hl:Destroy() end
            local bg = character:FindFirstChild("Imp_Name")
            if bg then bg:Destroy() end
            return
        end

        local isImpo = checkIsImpostor(character, player)
        local color = isImpo and IMPOSTOR_COLOR or CREW_COLOR

        -- Highlight Badan
        local hl = character:FindFirstChild("Imp_HL")
        if not hl then
            hl = Instance.new("Highlight")
            hl.Name = "Imp_HL"
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.FillTransparency = 0.65
            hl.OutlineTransparency = 0
            hl.Parent = character
        end
        hl.Adornee = character
        hl.FillColor = color
        hl.OutlineColor = color
        hl.Enabled = true

        -- Name ESP (Infinite Distance)
        local head = character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
        local bg = character:FindFirstChild("Imp_Name")
        if not bg and head then
            bg = Instance.new("BillboardGui")
            bg.Name = "Imp_Name"
            bg.Size = UDim2.new(0, 220, 0, 35)
            bg.StudsOffset = Vector3.new(0, 3, 0)
            bg.AlwaysOnTop = true
            bg.MaxDistance = math.huge
            bg.Adornee = head
            bg.Parent = character

            local label = Instance.new("TextLabel")
            label.Name = "NameLabel"
            label.BackgroundTransparency = 1
            label.Size = UDim2.new(1, 0, 1, 0)
            label.Font = Enum.Font.SourceSansBold
            label.TextSize = 14
            label.TextStrokeTransparency = 0
            label.TextStrokeColor3 = Color3.new(0, 0, 0)
            label.Parent = bg
        end

        if bg then
            bg.Enabled = true
            local label = bg:FindFirstChild("NameLabel")
            if label then
                local displayName = player and (player.DisplayName or player.Name) or character.Name
                label.Text = displayName
                label.TextColor3 = color
            end
        end
    end

    local heartbeatConn
    heartbeatConn = RunService.Heartbeat:Connect(function()
        if not marker.Parent then
            if heartbeatConn then heartbeatConn:Disconnect() end
            return
        end

        -- 1. Scan Player biasa
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                applyESP(player.Character, player)
            end
        end

        -- 2. Scan Folder "Bots" di Workspace (Sesuai penampakan Dex lu)
        local botsFolder = Workspace:FindFirstChild("Bots")
        if botsFolder then
            for _, botModel in ipairs(botsFolder:GetChildren()) do
                if botModel:IsA("Model") then
                    applyESP(botModel, nil)
                end
            end
        end

        -- Backup: Scan umum kalau bot ada di luar folder Bots tapi punya Humanoid
        for _, obj in ipairs(Workspace:GetChildren()) do
            if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") then
                if not Players:GetPlayerFromCharacter(obj) and obj.Name ~= "Bots" then
                    applyESP(obj, nil)
                end
            end
        end
    end)
end

local function stopImpostorESP()
    local Players = game:GetService("Players")
    local Workspace = game:GetService("Workspace")
    local LocalPlayer = Players.LocalPlayer

    if LocalPlayer then
        local marker = LocalPlayer:FindFirstChild("IMPOSTOR_ESP_RUNNING")
        if marker then marker:Destroy() end
    end

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") then
            local hl = obj:FindFirstChild("Imp_HL")
            if hl then hl:Destroy() end
            local bg = obj:FindFirstChild("Imp_Name")
            if bg then bg:Destroy() end
        end
    end
    print("ImpostorESP dimatikan.")
end

local Plugin = {
    ["PluginName"] = "ImpostorESP v3",
    ["PluginDescription"] = "Among Us Role ESP for Players and Workspace.Bots folder.",
    ["Commands"] = {
        ["imposon"] = {
            ["ListName"] = "imposon",
            ["Description"] = "Menyalakan Role ESP (Support Bots Folder & Status).",
            ["Aliases"] = {"imposon"},
            ["Function"] = function(args, speaker)
                startImpostorESP()
            end
        },
        ["imposoff"] = {
            ["ListName"] = "imposoff",
            ["Description"] = "Mematikan Role ESP.",
            ["Aliases"] = {"imposoff"},
            ["Function"] = function(args, speaker)
                stopImpostorESP()
            end
        }
    }
}

return Plugin
