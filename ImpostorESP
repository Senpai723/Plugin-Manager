local function startImpostorESP()
    local Players = game:GetService("Players")
    local Workspace = game:GetService("Workspace")
    local RunService = game:GetService("RunService")
    local LocalPlayer = Players.LocalPlayer

    if not LocalPlayer then return end

    -- Cek apakah sudah berjalan sebelumnya
    if LocalPlayer:FindFirstChild("IMPOSTOR_ESP_RUNNING") then
        print("ImpostorESP sudah aktif!")
        return
    end

    local marker = Instance.new("BoolValue")
    marker.Name = "IMPOSTOR_ESP_RUNNING"
    marker.Parent = LocalPlayer

    print("Loading ImpostorESP (With Bot & NPC Support)...")

    local CREW_COLOR = Color3.fromRGB(0, 255, 0)      -- Hijau (Crew / Warga / Bot Biasa)
    local IMPOSTOR_COLOR = Color3.fromRGB(255, 0, 0)   -- Merah (Impostor / Killer / Bot Impostor)

    -- Logika Penentuan Role (Support Player & Bot/NPC)
    local function getRoleColor(model, player)
        -- 1. Jika ini Player Sungguhan
        if player then
            if player.Team then
                local tName = player.Team.Name:lower()
                if string.find(tName, "impostor") 
                    or string.find(tName, "murderer") 
                    or string.find(tName, "traitor") 
                    or string.find(tName, "killer") then
                    return IMPOSTOR_COLOR
                end
            end

            local roleAttr = player:GetAttribute("Role") or player:GetAttribute("Team") or player:GetAttribute("Status")
            if typeof(roleAttr) == "string" then
                local r = roleAttr:lower()
                if string.find(r, "impostor") or string.find(r, "murderer") or string.find(r, "traitor") or string.find(r, "killer") then
                    return IMPOSTOR_COLOR
                end
            end

            if player:GetAttribute("IsImpostor") == true 
                or player:GetAttribute("Impostor") == true 
                or player:GetAttribute("IsMurderer") == true then
                return IMPOSTOR_COLOR
            end
        end

        -- 2. Jika ini Bot / NPC Model di Workspace
        if model then
            -- Cek Attribute bawaan Model Bot
            local botRole = model:GetAttribute("Role") or model:GetAttribute("Team") or model:GetAttribute("Status")
            if typeof(botRole) == "string" then
                local r = botRole:lower()
                if string.find(r, "impostor") or string.find(r, "murderer") or string.find(r, "traitor") or string.find(r, "killer") then
                    return IMPOSTOR_COLOR
                end
            end

            if model:GetAttribute("IsImpostor") == true 
                or model:GetAttribute("Impostor") == true 
                or model:GetAttribute("IsMurderer") == true then
                return IMPOSTOR_COLOR
            end

            -- Cek Nama Model Bot (misal: "Bot_Impostor" atau "ImpostorBot")
            local modelName = model.Name:lower()
            if string.find(modelName, "impostor") 
                or string.find(modelName, "murderer") 
                or string.find(modelName, "traitor") 
                or string.find(modelName, "killer") then
                return IMPOSTOR_COLOR
            end
        end

        return CREW_COLOR
    end

    local function applyESP(character, player)
        if not character or not character.Parent then return end

        -- Skip karakter milik player sendiri
        if LocalPlayer.Character and character == LocalPlayer.Character then return end

        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then
            local hl = character:FindFirstChild("Imp_HL")
            if hl then hl:Destroy() end
            local bg = character:FindFirstChild("Imp_Name")
            if bg then bg:Destroy() end
            return
        end

        local color = getRoleColor(character, player)

        -- Highlight Badan
        local hl = character:FindFirstChild("Imp_HL")
        if not hl then
            hl = Instance.new("Highlight")
            hl.Name = "Imp_HL"
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.FillTransparency = 0.65
            hl.OutlineTransparency = 0
            hl.Parent = character
        end
        hl.Adornee = character
        hl.FillColor = color
        hl.OutlineColor = color
        hl.Enabled = true

        -- Name ESP (Infinite Distance)
        local head = character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
        local bg = character:FindFirstChild("Imp_Name")
        if not bg and head then
            bg = Instance.new("BillboardGui")
            bg.Name = "Imp_Name"
            bg.Size = UDim2.new(0, 220, 0, 35)
            bg.StudsOffset = Vector3.new(0, 3, 0)
            bg.AlwaysOnTop = true
            bg.MaxDistance = math.huge
            bg.Adornee = head
            bg.Parent = character

            local label = Instance.new("TextLabel")
            label.Name = "NameLabel"
            label.BackgroundTransparency = 1
            label.Size = UDim2.new(1, 0, 1, 0)
            label.Font = Enum.Font.SourceSansBold
            label.TextSize = 14
            label.TextStrokeTransparency = 0
            label.TextStrokeColor3 = Color3.new(0, 0, 0)
            label.Parent = bg
        end

        if bg then
            bg.Enabled = true
            local label = bg:FindFirstChild("NameLabel")
            if label then
                label.Text = player and (player.DisplayName or player.Name) or character.Name
                label.TextColor3 = color
            end
        end
    end

    -- Loop Scanner untuk Player & Bot/NPC
    local heartbeatConn
    heartbeatConn = RunService.Heartbeat:Connect(function()
        if not marker.Parent then
            if heartbeatConn then heartbeatConn:Disconnect() end
            return
        end

        -- 1. Scan Players
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                applyESP(player.Character, player)
            end
        end

        -- 2. Scan Workspace for Bots / NPCs
        for _, obj in ipairs(Workspace:GetChildren()) do
            if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") then
                local player = Players:GetPlayerFromCharacter(obj)
                if not player then
                    -- Ini adalah Bot / NPC
                    applyESP(obj, nil)
                end
            end
        end
    end)
end

local function stopImpostorESP()
    local Players = game:GetService("Players")
    local Workspace = game:GetService("Workspace")
    local LocalPlayer = Players.LocalPlayer

    if LocalPlayer then
        local marker = LocalPlayer:FindFirstChild("IMPOSTOR_ESP_RUNNING")
        if marker then
            marker:Destroy()
        end
    end

    -- Clear ESP Player & Bot
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") then
            local hl = obj:FindFirstChild("Imp_HL")
            if hl then hl:Destroy() end
            local bg = obj:FindFirstChild("Imp_Name")
            if bg then bg:Destroy() end
        end
    end

    print("ImpostorESP dimatikan.")
end

local Plugin = {
    ["PluginName"] = "ImpostorESP v2",
    ["PluginDescription"] = "Among Us Role ESP for Players and Bots (Green for Crew, Red for Impostor).",
    ["Commands"] = {
        ["imposon"] = {
            ["ListName"] = "imposon",
            ["Description"] = "Menyalakan Role ESP Player + Bot (Impostor Merah, Crew Hijau).",
            ["Aliases"] = {"imposon"},
            ["Function"] = function(args, speaker)
                startImpostorESP()
            end
        },
        ["imposoff"] = {
            ["ListName"] = "imposoff",
            ["Description"] = "Mematikan Role ESP.",
            ["Aliases"] = {"imposoff"},
            ["Function"] = function(args, speaker)
                stopImpostorESP()
            end
        }
    }
}

return Plugin
