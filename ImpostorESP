local function startImpostorESP()
    local Players = game:GetService("Players")
    local Workspace = game:GetService("Workspace")
    local RunService = game:GetService("RunService")
    local LocalPlayer = Players.LocalPlayer

    if not LocalPlayer then return end

    if LocalPlayer:FindFirstChild("IMPOSTOR_ESP_RUNNING") then
        print("ImpostorESP sudah aktif!")
        return
    end

    local marker = Instance.new("BoolValue")
    marker.Name = "IMPOSTOR_ESP_RUNNING"
    marker.Parent = LocalPlayer

    print("Loading ImpostorESP v4 (Strict Local Exclusion & Deep Bot Scan)...")

    local CREW_COLOR = Color3.fromRGB(0, 255, 0)      -- Hijau (Crew / Warga)
    local IMPOSTOR_COLOR = Color3.fromRGB(255, 0, 0)   -- Merah (Impostor / Killer)

    local function checkIsImpostor(targetObject, player)
        -- Jangan pernah anggap LocalPlayer sebagai Impostor untuk ESP musuh
        if player and player == LocalPlayer then return false end

        -- 1. Cek jika Player
        if player then
            if player.Team then
                local tName = player.Team.Name:lower()
                if string.find(tName, "impostor") or string.find(tName, "murderer") or string.find(tName, "traitor") or string.find(tName, "killer") then
                    return true
                end
            end
            local roleAttr = player:GetAttribute("Role") or player:GetAttribute("Team") or player:GetAttribute("Status")
            if typeof(roleAttr) == "string" and (string.find(roleAttr:lower(), "impostor") or string.find(roleAttr:lower(), "murderer") or string.find(roleAttr:lower(), "killer")) then
                return true
            end
        end

        -- 2. Cek Model Bot (Scan menyeluruh ke semua anak objek & attribute di dalam model bot)
        if targetObject and targetObject:IsA("Model") then
            -- Pastikan bukan karakter LocalPlayer
            if LocalPlayer.Character and targetObject == LocalPlayer.Character then
                return false
            end

            -- Scan semua Attributes di model bot
            for _, attrVal in pairs(targetObject:GetAttributes()) do
                if typeof(attrVal) == "string" then
                    local val = attrVal:lower()
                    if string.find(val, "impostor") or string.find(val, "murderer") or string.find(val, "killer") then
                        return true
                    end
                end
            end

            -- Scan semua objek Value (StringValue, BoolValue, dll) di dalam model bot
            for _, desc in ipairs(targetObject:GetDescendants()) do
                if desc:IsA("StringValue") or desc:IsA("TextValue") or desc:IsA("ValueBase") then
                    local textVal = tostring(desc.Value):lower()
                    if string.find(textVal, "impostor") or string.find(textVal, "murderer") or string.find(textVal, "killer") then
                        return true
                    end
                elseif desc:IsA("TextLabel") or desc:IsA("TextButton") then
                    local tText = desc.Text:lower()
                    if string.find(tText, "impostor") or string.find(tText, "murderer") then
                        return true
                    end
                end
            end

            -- Cek Nama Model Bot
            local mName = targetObject.Name:lower()
            if string.find(mName, "impostor") or string.find(mName, "murderer") or string.find(mName, "killer") then
                return true
            end
        end

        return false
    end

    local function removeESP(character)
        if not character then return end
        local hl = character:FindFirstChild("Imp_HL")
        if hl then hl:Destroy() end
        local bg = character:FindFirstChild("Imp_Name")
        if bg then bg:Destroy() end
    end

    local function applyESP(character, player)
        if not character or not character.Parent then return end

        -- JAMINAN: Karakter LocalPlayer (lu sendiri) dibersihkan total dari ESP
        if (player and player == LocalPlayer) or (LocalPlayer.Character and character == LocalPlayer.Character) then
            removeESP(character)
            return
        end

        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then
            removeESP(character)
            return
        end

        local isImpo = checkIsImpostor(character, player)
        local color = isImpo and IMPOSTOR_COLOR or CREW_COLOR

        -- Highlight Badan
        local hl = character:FindFirstChild("Imp_HL")
        if not hl then
            hl = Instance.new("Highlight")
            hl.Name = "Imp_HL"
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.FillTransparency = 0.65
            hl.OutlineTransparency = 0
            hl.Parent = character
        end
        hl.Adornee = character
        hl.FillColor = color
        hl.OutlineColor = color
        hl.Enabled = true

        -- Name ESP (Infinite Distance)
        local head = character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
        local bg = character:FindFirstChild("Imp_Name")
        if not bg and head then
            bg = Instance.new("BillboardGui")
            bg.Name = "Imp_Name"
            bg.Size = UDim2.new(0, 220, 0, 35)
            bg.StudsOffset = Vector3.new(0, 3, 0)
            bg.AlwaysOnTop = true
            bg.MaxDistance = math.huge
            bg.Adornee = head
            bg.Parent = character

            local label = Instance.new("TextLabel")
            label.Name = "NameLabel"
            label.BackgroundTransparency = 1
            label.Size = UDim2.new(1, 0, 1, 0)
            label.Font = Enum.Font.SourceSansBold
            label.TextSize = 14
            label.TextStrokeTransparency = 0
            label.TextStrokeColor3 = Color3.new(0, 0, 0)
            label.Parent = bg
        end

        if bg then
            bg.Enabled = true
            local label = bg:FindFirstChild("NameLabel")
            if label then
                local displayName = player and (player.DisplayName or player.Name) or character.Name
                label.Text = displayName
                label.TextColor3 = color
            end
        end
    end

    local heartbeatConn
    heartbeatConn = RunService.Heartbeat:Connect(function()
        if not marker.Parent then
            if heartbeatConn then heartbeatConn:Disconnect() end
            return
        end

        -- Pastikan LocalPlayer bersih dari ESP
        if LocalPlayer.Character then
            removeESP(LocalPlayer.Character)
        end

        -- 1. Scan Player lain
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                applyESP(player.Character, player)
            end
        end

        -- 2. Scan Folder "Bots" di Workspace
        local botsFolder = Workspace:FindFirstChild("Bots")
        if botsFolder then
            for _, botModel in ipairs(botsFolder:GetChildren()) do
                if botModel:IsA("Model") then
                    applyESP(botModel, nil)
                end
            end
        end

        -- 3. Scan umum model lain di Workspace
        for _, obj in ipairs(Workspace:GetChildren()) do
            if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") then
                if not Players:GetPlayerFromCharacter(obj) and obj.Name ~= "Bots" then
                    applyESP(obj, nil)
                end
            end
        end
    end)
end

local function stopImpostorESP()
    local Players = game:GetService("Players")
    local Workspace = game:GetService("Workspace")
    local LocalPlayer = Players.LocalPlayer

    if LocalPlayer then
        local marker = LocalPlayer:FindFirstChild("IMPOSTOR_ESP_RUNNING")
        if marker then marker:Destroy() end
    end

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") then
            local hl = obj:FindFirstChild("Imp_HL")
            if hl then hl:Destroy() end
            local bg = obj:FindFirstChild("Imp_Name")
            if bg then bg:Destroy() end
        end
    end
    print("ImpostorESP dimatikan.")
end

local Plugin = {
    ["PluginName"] = "ImpostorESP v4",
    ["PluginDescription"] = "Among Us Role ESP with LocalPlayer Exclusion & Deep Bot Scan.",
    ["Commands"] = {
        ["imposon"] = {
            ["ListName"] = "imposon",
            ["Description"] = "Menyalakan Role ESP (Karakter Sendiri Bersih, Bot & Player Lain Ter-scan).",
            ["Aliases"] = {"imposon"},
            ["Function"] = function(args, speaker)
                startImpostorESP()
            end
        },
        ["imposoff"] = {
            ["ListName"] = "imposoff",
            ["Description"] = "Mematikan Role ESP.",
            ["Aliases"] = {"imposoff"},
            ["Function"] = function(args, speaker)
                stopImpostorESP()
            end
        }
    }
}

return Plugin
