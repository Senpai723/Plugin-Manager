local Plugin = {
    ["PluginName"] = "CodeFinder",
    ["PluginDescription"] = "Find possible pure numeric and pure alphabetic puzzle codes from client-visible data.",
    ["Commands"] = {
        ["code"] = {
            ["ListName"] = "code",
            ["Description"] = "Scans client-visible data for pure numeric or pure alphabetic puzzle codes and shows them in a popup.",
            ["Aliases"] = {},
            ["Function"] = function(args, speaker)

                local Players = game:GetService("Players")
                local ReplicatedStorage = game:GetService("ReplicatedStorage")
                local ReplicatedFirst = game:GetService("ReplicatedFirst")
                local CoreGui = game:GetService("CoreGui")

                speaker = speaker or Players.LocalPlayer

                -- Player names/display names are never treated as codes.
                local playerNames = {}
                for _, plr in ipairs(Players:GetPlayers()) do
                    playerNames[string.lower(plr.Name)] = true
                    if plr.DisplayName then
                        playerNames[string.lower(plr.DisplayName)] = true
                    end
                end

                local MIN_LENGTH = 3
                local MAX_LENGTH = 12
                local MAX_RESULTS = 80

                local results = {}
                local seenCodes = {}
                local seenPaths = {}

                local function notifySafe(title, message)
                    pcall(function()
                        notify(title, message)
                    end)
                end

                local function getPath(instance)
                    local ok, result = pcall(function()
                        return instance:GetFullName()
                    end)

                    return ok and result or instance.Name
                end

                local function isProbablyIrrelevantPath(path)
                    local p = string.lower(path)

                    -- Do not scan player identity / account related numbers.
                    local blocked = {
                        "playergui",
                        "players.",
                        "leaderstats",
                        "userinputservice",
                        "userid",
                        "user_id",
                        "userid",
                        "account",
                        "backpack",
                        "character",
                    }

                    for _, word in ipairs(blocked) do
                        if string.find(p, word, 1, true) then
                            return true
                        end
                    end

                    return false
                end

                local function hasCodeKeyword(text)
                    if type(text) ~= "string" then
                        return false
                    end

                    local s = string.lower(text)

                    local keywords = {
                        "code",
                        "kode",
                        "pin",
                        "password",
                        "passcode",
                        "combination",
                        "combo",
                        "vault",
                        "safe",
                        "brankas",
                        "keypad",
                        "door",
                        "puzzle",
                        "clue",
                        "hint",
                        "lock",
                        "security",
                        "secret",
                        "number",
                        "digit",
                    }

                    for _, keyword in ipairs(keywords) do
                        if string.find(s, keyword, 1, true) then
                            return true
                        end
                    end

                    return false
                end

                local function addResult(value, path, source, priority, context)
                    if value == nil then
                        return
                    end

                    value = tostring(value)

                    -- Only accept PURE numeric OR PURE alphabetic codes.
                    -- Examples accepted: 1234 / 48291 / ABCD / SECRET
                    -- Examples rejected: Room13 / A12 / 12AB / PIN-123 / A_B
                    local isPureNumber = value:match("^%d+$") ~= nil
                    local isPureLetter = value:match("^[%a]+$") ~= nil

                    if not isPureNumber and not isPureLetter then
                        return
                    end

                    if #value < MIN_LENGTH or #value > MAX_LENGTH then
                        return
                    end

                    if isProbablyIrrelevantPath(path) then
                        return
                    end

                    -- Never surface a player's username/display name as a code.
                    local normalized = string.lower(value)
                    if playerNames[normalized] then
                        return
                    end

                    -- Never treat the keyword itself as a code.
                    local codeWords = {
                        code=true, kode=true, pin=true, password=true, passcode=true,
                        combination=true, combo=true, vault=true, safe=true,
                        brankas=true, keypad=true, door=true, puzzle=true, clue=true,
                        hint=true, lock=true, security=true, secret=true,
                        number=true, digit=true
                    }
                    if codeWords[normalized] then
                        return
                    end

                    -- A pure word needs meaningful puzzle context. This avoids
                    -- treating ordinary UI words such as PLAY/SHOP as codes.
                    local hasDigit = value:match("%d") ~= nil
                    local hasLetter = value:match("%a") ~= nil
                    local looksMixed = hasDigit and hasLetter
                    local hasSeparator = value:match("[-_]" ) ~= nil
                    local contextIsCode = hasCodeKeyword(path) or hasCodeKeyword(context or "")

                    if hasLetter and not hasDigit and not hasSeparator
                        and not contextIsCode then
                        -- Pure alphabetic candidates are accepted when they look
                        -- deliberately code-like (e.g. uppercase ABCD).
                        if value ~= string.upper(value) or #value < 4 then
                            return
                        end
                    end

                    -- Ignore very common non-code values.
                    if value == "100"
                        or value == "101"
                        or value == "111"
                        or value == "123"
                        or value == "321"
                        or value == "1234"
                        or value == "0000"
                        or value == "1111"
                        or value == "9999" then
                        -- Keep them only when their source/context strongly
                        -- indicates a code.
                        if not priority or priority < 3 then
                            return
                        end
                    end

                    -- Same code should appear only once in the popup.
                    if seenCodes[value] then
                        return
                    end

                    seenCodes[value] = true

                    table.insert(results, {
                        code = value,
                        path = path,
                        source = source,
                        priority = priority or 1,
                        context = context or ""
                    })
                end

                local function scanText(text, path, source)
                    if type(text) ~= "string" or text == "" then
                        return
                    end

                    local keyword = hasCodeKeyword(text) or hasCodeKeyword(path)

                    -- Only extract standalone pure-number or pure-letter tokens.
                    -- This intentionally prevents names such as Room13, A12, etc.
                    for token in text:gmatch("[^%s%p]+") do
                        if #token >= MIN_LENGTH and #token <= MAX_LENGTH then
                            local isPureNumber = token:match("^%d+$") ~= nil
                            local isPureLetter = token:match("^[%a]+$") ~= nil

                            if isPureNumber then
                                local priority = keyword and 3 or 1

                                addResult(
                                    token,
                                    path,
                                    source,
                                    priority,
                                    text
                                )

                            elseif isPureLetter then
                                -- Pure alphabetic candidates still need meaningful
                                -- code context or an obvious uppercase code style.
                                local priority = keyword and 3 or 1

                                if keyword then
                                    priority = 3
                                elseif token == string.upper(token) and #token >= 4 then
                                    priority = 2
                                else
                                    priority = 0
                                end

                                if priority > 0 then
                                    addResult(
                                        token,
                                        path,
                                        source,
                                        priority,
                                        text
                                    )
                                end
                            end
                        end
                    end
                end

                local function scanAttributes(instance, path)
                    local ok, attributes = pcall(function()
                        return instance:GetAttributes()
                    end)

                    if not ok or not attributes then
                        return
                    end

                    for name, value in pairs(attributes) do
                        local attrName = tostring(name)
                        local attrPath = path .. " [Attribute: " .. attrName .. "]"
                        local priority = hasCodeKeyword(attrName) and 3 or 1

                        if type(value) == "string" then
                            scanText(value, attrPath, "Attribute")

                        elseif type(value) == "number" then
                            local text = tostring(value)

                            if text:match("^%d+$") then
                                addResult(
                                    text,
                                    attrPath,
                                    "Attribute",
                                    priority,
                                    attrName
                                )
                            end
                        end
                    end
                end

                local function scanInstance(instance)
                    local class = instance.ClassName
                    local path = getPath(instance)

                    if isProbablyIrrelevantPath(path) then
                        return
                    end

                    scanAttributes(instance, path)

                    -- Remotes are client-visible when replicated. We cannot read
                    -- server-only arguments or invoke them here; however, their
                    -- replicated name/attributes can still contain useful code
                    -- hints, so scan those safely.
                    if class == "RemoteEvent" or class == "RemoteFunction" then
                        local remoteName = tostring(instance.Name)
                        local remotePriority = hasCodeKeyword(remoteName) and 3 or 1

                        if hasCodeKeyword(remoteName) then
                            scanText(remoteName, path, class .. "Name")
                        end

                        local okRemoteAttrs, remoteAttrs = pcall(function()
                            return instance:GetAttributes()
                        end)

                        if okRemoteAttrs and remoteAttrs then
                            for attrName, attrValue in pairs(remoteAttrs) do
                                if type(attrValue) == "string" then
                                    scanText(
                                        attrValue,
                                        path .. " [Remote Attribute: " .. tostring(attrName) .. "]",
                                        class .. "Attribute"
                                    )
                                elseif type(attrValue) == "number" then
                                    local attrText = tostring(attrValue)
                                    if attrText:match("^%d+$") then
                                        addResult(
                                            attrText,
                                            path .. " [Remote Attribute: " .. tostring(attrName) .. "]",
                                            class .. "Attribute",
                                            hasCodeKeyword(tostring(attrName)) and 3 or remotePriority,
                                            tostring(attrName)
                                        )
                                    end
                                end
                            end
                        end
                    end

                    -- StringValue
                    if class == "StringValue" then
                        pcall(function()
                            scanText(instance.Value, path, "StringValue")
                        end)

                    -- Numeric Value objects
                    elseif class == "IntValue" then
                        pcall(function()
                            local value = tostring(instance.Value)
                            local priority =
                                hasCodeKeyword(instance.Name) and 3 or 1

                            addResult(
                                value,
                                path,
                                "IntValue",
                                priority,
                                instance.Name
                            )
                        end)

                    elseif class == "NumberValue" then
                        pcall(function()
                            local value = tostring(instance.Value)

                            if value:match("^%d+$") then
                                local priority =
                                    hasCodeKeyword(instance.Name) and 3 or 1

                                addResult(
                                    value,
                                    path,
                                    "NumberValue",
                                    priority,
                                    instance.Name
                                )
                            end
                        end)

                    -- Visible GUI text
                    elseif class == "TextLabel"
                        or class == "TextButton"
                        or class == "TextBox"
                        or class == "Hint"
                        or class == "Message" then

                        pcall(function()
                            scanText(instance.Text, path, class)
                        end)
                    end

                    -- Instance names are scanned ONLY when their name itself
                    -- suggests puzzle/code information.
                    if hasCodeKeyword(instance.Name) then
                        scanText(instance.Name, path, "InstanceName")
                    end
                end

                local function scanContainer(container)
                    if not container then
                        return
                    end

                    local descendants

                    local ok = pcall(function()
                        descendants = container:GetDescendants()
                    end)

                    if not ok or not descendants then
                        return
                    end

                    for _, instance in ipairs(descendants) do
                        if #results >= MAX_RESULTS then
                            break
                        end

                        pcall(function()
                            scanInstance(instance)
                        end)
                    end

                    pcall(function()
                        scanInstance(container)
                    end)
                end

                ----------------------------------------------------------------
                -- Scan
                ----------------------------------------------------------------

                notifySafe(
                    "Code Finder",
                    "Scanning Workspace + replicated client data..."
                )

                -- Workspace is the most important source for puzzle maps.
                scanContainer(workspace)

                -- Replicated containers are fully client-visible and often hold
                -- puzzle state, code values, remotes, attributes and ValueObjects.
                scanContainer(ReplicatedStorage)
                scanContainer(ReplicatedFirst)

                -- Intentionally DO NOT scan Player/PlayerGui/CoreGui.
                -- Those commonly contain usernames, user IDs and UI numbers,
                -- producing false positives such as the old "723" result.
                ----------------------------------------------------------------

                table.sort(results, function(a, b)
                    if a.priority ~= b.priority then
                        return a.priority > b.priority
                    end

                    if #a.code ~= #b.code then
                        return #a.code > #b.code
                    end

                    return a.code < b.code
                end)

                ----------------------------------------------------------------
                -- Popup UI
                ----------------------------------------------------------------

                local oldGui = nil

                pcall(function()
                    oldGui = CoreGui:FindFirstChild("TryoCodeFinder")
                end)

                if oldGui then
                    pcall(function()
                        oldGui:Destroy()
                    end)
                end

                local gui = Instance.new("ScreenGui")
                gui.Name = "TryoCodeFinder"
                gui.ResetOnSpawn = false
                gui.IgnoreGuiInset = true

                pcall(function()
                    gui.Parent = CoreGui
                end)

                if not gui.Parent then
                    gui.Parent = speaker:WaitForChild("PlayerGui")
                end

                local frame = Instance.new("Frame")
                frame.Name = "Main"
                frame.Size = UDim2.new(0, 430, 0, 390)
                frame.Position = UDim2.new(0.5, -215, 0.5, -195)
                frame.BackgroundColor3 = Color3.fromRGB(25, 25, 28)
                frame.BorderSizePixel = 0
                frame.Parent = gui

               local corner = Instance.new("UICorner")
                corner.CornerRadius = UDim.new(0, 10)
                corner.Parent = frame

                local title = Instance.new("TextLabel")
                title.Size = UDim2.new(1, -55, 0, 42)
                title.Position = UDim2.new(0, 15, 0, 0)
                title.BackgroundTransparency = 1
                title.Text = "CODE FINDER"
                title.TextColor3 = Color3.fromRGB(255, 255, 255)
                title.TextSize = 18
                title.Font = Enum.Font.GothamBold
                title.TextXAlignment = Enum.TextXAlignment.Left
                title.Parent = frame

                local minimized = false
                local normalFrameSize = UDim2.new(0, 430, 0, 390)

                local minimize = Instance.new("TextButton")
                minimize.Size = UDim2.new(0, 38, 0, 32)
                minimize.Position = UDim2.new(1, -87, 0, 5)
                minimize.BackgroundTransparency = 1
                minimize.Text = "−"
                minimize.TextColor3 = Color3.fromRGB(220, 220, 225)
                minimize.TextSize = 23
                minimize.Font = Enum.Font.GothamBold
                minimize.Parent = frame

                local close = Instance.new("TextButton")
                close.Size = UDim2.new(0, 38, 0, 32)
                close.Position = UDim2.new(1, -45, 0, 5)
                close.BackgroundTransparency = 1
                close.Text = "×"
                close.TextColor3 = Color3.fromRGB(255, 90, 90)
                close.TextSize = 25
                close.Font = Enum.Font.GothamBold
                close.Parent = frame

                close.MouseButton1Click:Connect(function()
                    gui:Destroy()
                end)

                local info = Instance.new("TextLabel")
                info.Size = UDim2.new(1, -30, 0, 28)
                info.Position = UDim2.new(0, 15, 0, 42)
                info.BackgroundTransparency = 1
                info.TextColor3 = Color3.fromRGB(180, 180, 185)
                info.TextSize = 13
                info.Font = Enum.Font.Gotham
                info.TextXAlignment = Enum.TextXAlignment.Left
                info.Text = "Possible codes: " .. tostring(#results)
                info.Parent = frame

                local scroll = Instance.new("ScrollingFrame")
                scroll.Name = "Results"
                scroll.Size = UDim2.new(1, -20, 1, -82)
                scroll.Position = UDim2.new(0, 10, 0, 75)
                scroll.BackgroundColor3 = Color3.fromRGB(18, 18, 20)
                scroll.BorderSizePixel = 0
                scroll.ScrollBarThickness = 5
                scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
                scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
                scroll.Parent = frame

                local scrollCorner = Instance.new("UICorner")
                scrollCorner.CornerRadius = UDim.new(0, 7)
                scrollCorner.Parent = scroll

                local layout = Instance.new("UIListLayout")
                layout.Padding = UDim.new(0, 6)
                layout.SortOrder = Enum.SortOrder.LayoutOrder
                layout.Parent = scroll

                local padding = Instance.new("UIPadding")
                padding.PaddingTop = UDim.new(0, 8)
                padding.PaddingBottom = UDim.new(0, 8)
                padding.PaddingLeft = UDim.new(0, 8)
                padding.PaddingRight = UDim.new(0, 8)
                padding.Parent = scroll

                if #results == 0 then
                    local empty = Instance.new("TextLabel")
                    empty.Size = UDim2.new(1, -10, 0, 70)
                    empty.BackgroundTransparency = 1
                    empty.Text = "No likely code found.\nTry scanning after opening the clue/puzzle."
                    empty.TextColor3 = Color3.fromRGB(190, 190, 195)
                    empty.TextSize = 14
                    empty.Font = Enum.Font.Gotham
                    empty.TextWrapped = true
                    empty.Parent = scroll
                else
                    for index, result in ipairs(results) do
                        local item = Instance.new("Frame")
                        item.Size = UDim2.new(1, -4, 0, 68)
                        item.BackgroundColor3 =
                            result.priority >= 3
                            and Color3.fromRGB(45, 45, 34)
                            or Color3.fromRGB(32, 32, 36)
                        item.BorderSizePixel = 0
                        item.LayoutOrder = index
                        item.Parent = scroll

                        local itemCorner = Instance.new("UICorner")
                        itemCorner.CornerRadius = UDim.new(0, 6)
                        itemCorner.Parent = item

                        local codeLabel = Instance.new("TextLabel")
                        codeLabel.Size = UDim2.new(0, 105, 0, 32)
                        codeLabel.Position = UDim2.new(0, 10, 0, 7)
                        codeLabel.BackgroundTransparency = 1
                        codeLabel.Text = result.code
                        codeLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                        codeLabel.TextSize = 20
                        codeLabel.Font = Enum.Font.GothamBold
                        codeLabel.TextXAlignment = Enum.TextXAlignment.Left
                        codeLabel.Parent = item

                        local sourceLabel = Instance.new("TextLabel")
                        sourceLabel.Size = UDim2.new(1, -125, 0, 23)
                        sourceLabel.Position = UDim2.new(0, 115, 0, 4)
                        sourceLabel.BackgroundTransparency = 1
                        sourceLabel.Text =
                            result.priority >= 3
                            and "LIKELY CODE"
                            or result.source
                        sourceLabel.TextColor3 =
                            result.priority >= 3
                            and Color3.fromRGB(255, 220, 100)
                            or Color3.fromRGB(170, 170, 175)
                        sourceLabel.TextSize = 11
                        sourceLabel.Font = Enum.Font.GothamBold
                        sourceLabel.TextXAlignment = Enum.TextXAlignment.Left
                        sourceLabel.Parent = item

                        local pathLabel = Instance.new("TextLabel")
                        pathLabel.Size = UDim2.new(1, -125, 0, 32)
                        pathLabel.Position = UDim2.new(0, 115, 0, 24)
                        pathLabel.BackgroundTransparency = 1
                        pathLabel.Text = result.path
                        pathLabel.TextColor3 = Color3.fromRGB(135, 135, 140)
                        pathLabel.TextSize = 10
                        pathLabel.Font = Enum.Font.Gotham
                        pathLabel.TextTruncate = Enum.TextTruncate.AtEnd
                        pathLabel.TextXAlignment = Enum.TextXAlignment.Left
                        pathLabel.Parent = item

                        local copy = Instance.new("TextButton")
                        copy.Size = UDim2.new(0, 78, 0, 30)
                        copy.Position = UDim2.new(1, -88, 1, -38)
                        copy.BackgroundColor3 = Color3.fromRGB(55, 55, 62)
                        copy.Text = "COPY"
                        copy.TextColor3 = Color3.fromRGB(255, 255, 255)
                        copy.TextSize = 11
                        copy.Font = Enum.Font.GothamBold
                        copy.Parent = item

                        local copyCorner = Instance.new("UICorner")
                        copyCorner.CornerRadius = UDim.new(0, 5)
                        copyCorner.Parent = copy

                        copy.MouseButton1Click:Connect(function()
                            if setclipboard then
                                pcall(function()
                                    setclipboard(result.code)
                                end)

                                copy.Text = "COPIED"
                                task.delay(1.2, function()
                                    if copy and copy.Parent then
                                        copy.Text = "COPY"
                                    end
                                end)
                            else
                                notifySafe(
                                    "Code Finder",
                                    "Clipboard is not supported by this executor."
                                )
                            end
                        end)
                    end
                end

                minimize.MouseButton1Click:Connect(function()
                    minimized = not minimized

                    if minimized then
                        scroll.Visible = false
                        info.Visible = false
                        frame.Size = UDim2.new(0, 430, 0, 48)
                        minimize.Text = "+"
                    else
                        scroll.Visible = true
                        info.Visible = true
                        frame.Size = normalFrameSize
                        minimize.Text = "−"
                    end
                end)

                -- Make the popup draggable on mouse/touch capable executors.
                pcall(function()
                    local UserInputService =
                        game:GetService("UserInputService")

                    local dragging = false
                    local dragStart
                    local startPos

                    title.InputBegan:Connect(function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton1
                            or input.UserInputType == Enum.UserInputType.Touch then

                            dragging = true
                            dragStart = input.Position
                            startPos = frame.Position

                            input.Changed:Connect(function()
                                if input.UserInputState ==
                                    Enum.UserInputState.End then
                                    dragging = false
                                end
                            end)
                        end
                    end)

                    UserInputService.InputChanged:Connect(function(input)
                        if not dragging then
                            return
                        end

                        if input.UserInputType ==
                            Enum.UserInputType.MouseMovement
                            or input.UserInputType ==
                            Enum.UserInputType.Touch then

                            local delta = input.Position - dragStart

                            frame.Position = UDim2.new(
                                startPos.X.Scale,
                                startPos.X.Offset + delta.X,
                                startPos.Y.Scale,
                                startPos.Y.Offset + delta.Y
                            )
                        end
                    end)
                end)

                notifySafe(
                    "Code Finder",
                    "Scan complete: " .. tostring(#results) .. " candidate(s)."
                )
            end
        }
    }
}

return Plugin
