local plugin = {
    ["PluginName"] = "Standard Noclip";
    ["PluginDescription"] = "Noclip standar yang langsung tembus semua objek tanpa syarat.";
    ["Commands"] = {
        ["noclip"] = {
            ["ListName"] = "noclip",
            ["Description"] = "Mengaktifkan Noclip standar.",
            ["Aliases"] = {"nc"},
            ["Function"] = function(args, speaker)
                local RunService = game:GetService("RunService")
                local Players = game:GetService("Players")
                local localPlayer = Players.LocalPlayer

                if _G.StandardNoclipActive then
                    return
                end

                _G.StandardNoclipActive = true

                if _G.StandardNoclipConnection then
                    _G.StandardNoclipConnection:Disconnect()
                    _G.StandardNoclipConnection = nil
                end

                _G.StandardNoclipConnection = RunService.Stepped:Connect(function()
                    if not _G.StandardNoclipActive then return end

                    local char = localPlayer.Character
                    if char then
                        for _, part in ipairs(char:GetDescendants()) do
                            if part:IsA("BasePart") then
                                part.CanCollide = false
                            end
                        end
                    end
                end)
                print("[Noclip] Diaktifkan!")
            end
        },
        ["unnoclip"] = {
            ["ListName"] = "unnoclip",
            ["Description"] = "Menonaktifkan Noclip.",
            ["Aliases"] = {"unnc"},
            ["Function"] = function(args, speaker)
                _G.StandardNoclipActive = false

                if _G.StandardNoclipConnection then
                    _G.StandardNoclipConnection:Disconnect()
                    _G.StandardNoclipConnection = nil
                end

                local char = speaker.Character
                if char then
                    for _, part in ipairs(char:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.CanCollide = true
                        end
                    end
                end
                print("[Noclip] Dimatikan.")
            end
        }
    }
}

return plugin
