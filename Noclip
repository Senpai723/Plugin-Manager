local plugin = {
    ["PluginName"] = "Smart Noclip";
    ["PluginDescription"] = "Noclip pintar yang tetap bisa naik tangga/bidang miring tanpa jatuh ke bawah.";
    ["Commands"] = {
        ["noclip"] = {
            ["ListName"] = "noclip",
            ["Description"] = "Mengaktifkan Smart Noclip (tembus tembok tapi aman di tangga).",
            ["Aliases"] = {"nc"},
            ["Function"] = function(args, speaker)
                local RunService = game:GetService("RunService")
                local Players = game:GetService("Players")
                local localPlayer = Players.LocalPlayer

                if _G.SmartNoclipActive then
                    print("[Smart Noclip] Sudah aktif!")
                    return
                end

                _G.SmartNoclipActive = true

                -- Menggunakan RunService.Stepped agar setiap frame status bagian tubuh difilter
                if _G.SmartNoclipConnection then
                    _G.SmartNoclipConnection:Disconnect()
                    _G.SmartNoclipConnection = nil
                end

                _G.SmartNoclipConnection = RunService.Stepped:Connect(function()
                    if not _G.SmartNoclipActive then return end

                    local char = localPlayer.Character
                    if char then
                        local hum = char:FindFirstChildOfClass("Humanoid")
                        local rootPart = char:FindFirstChild("HumanoidRootPart")

                        if hum and rootPart then
                            -- Cek apakah player sedang berpijak di lantai/tangga (FloorMaterial tidak udara)
                            local isStandingOnSomething = hum.FloorMaterial ~= Enum.Material.Air

                            for _, part in ipairs(char:GetDescendants()) do
                                if part:IsA("BasePart") then
                                    if isStandingOnSomething and part == rootPart then
                                        -- Jika sedang di atas tangga/lantai miring, biarkan RootPart memiliki tabrakan bawah
                                        -- agar tidak jatuh, tapi matikan kanannya/kirinya lewat logika part lain jika perlu.
                                        -- Tapi umumnya, membiarkan CanCollide true saat berdiri di lantai mencegah tembus ke bawah.
                                    else
                                        -- Tembus tembok (Matikan CanCollide untuk bagian tubuh selain saat berpijak)
                                        -- Kecuali jika sedang melompat/di udara, matikan total agar bisa tembus dinding
                                        if not isStandingOnSomething then
                                            part.CanCollide = false
                                        else
                                            -- Jika sedang di permukaan (tangga/lantai), biarkan part non-root tembus asal root aman
                                            if part.Name ~= "HumanoidRootPart" then
                                                part.CanCollide = false
                                            end
                                        end
                                    end
                                end
                            end

                            -- Logika tambahan: Jika sedang melayang/di udara bebas, matikan CanCollide semuanya
                            if not isStandingOnSomething then
                                for _, part in ipairs(char:GetDescendants()) do
                                    if part:IsA("BasePart") then
                                        part.CanCollide = false
                                    end
                                end
                            end
                        end
                    end
                end)
                print("[Smart Noclip] Diaktifkan! Aman di tangga.")
            end
        },
        ["unnoclip"] = {
            ["ListName"] = "unnoclip",
            ["Description"] = "Menonaktifkan Smart Noclip.",
            ["Aliases"] = {"unnc"},
            ["Function"] = function(args, speaker)
                _G.SmartNoclipActive = false

                if _G.SmartNoclipConnection then
                    _G.SmartNoclipConnection:Disconnect()
                    _G.SmartNoclipConnection = nil
                end

                local char = speaker.Character
                if char then
                    for _, part in ipairs(char:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.CanCollide = true
                        end
                    end
                end
                print("[Smart Noclip] Dimatikan. Tabrakan dinasionalkan kembali.")
            end
        }
    }
}

return plugin
