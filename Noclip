local plugin = {
    ["PluginName"] = "Smart Noclip";
    ["PluginDescription"] = "Noclip pintar yang langsung tembus tembok tanpa harus lompat.";
    ["Commands"] = {
        ["noclip"] = {
            ["ListName"] = "noclip",
            ["Description"] = "Mengaktifkan Smart Noclip murni.",
            ["Aliases"] = {"nc"},
            ["Function"] = function(args, speaker)
                local RunService = game:GetService("RunService")
                local Players = game:GetService("Players")
                local localPlayer = Players.LocalPlayer

                if _G.SmartNoclipActive then
                    return
                end

                _G.SmartNoclipActive = true

                if _G.SmartNoclipConnection then
                    _G.SmartNoclipConnection:Disconnect()
                    _G.SmartNoclipConnection = nil
                end

                _G.SmartNoclipConnection = RunService.Stepped:Connect(function()
                    if not _G.SmartNoclipActive then return end

                    local char = localPlayer.Character
                    if char then
                        local hum = char:FindFirstChildOfClass("Humanoid")
                        local rootPart = char:FindFirstChild("HumanoidRootPart")

                        if hum and rootPart then
                            -- Matikan CanCollide untuk seluruh bagian tubuh kecuali bagian bawah jika sedang menapak
                            for _, part in ipairs(char:GetDescendants()) do
                                if part:IsA("BasePart") then
                                    if part.Name == "HumanoidRootPart" then
                                        -- RootPart tetap punya kolisi bawah jika menyentuh lantai/tangga, 
                                        -- tapi kita buat non-kolisi jika menabrak dinding dari samping (opsional via physics)
                                        -- Biar aman di tangga, kita biarkan true HANYA jika arah gerak vertikal tidak tertahan tembok.
                                        part.CanCollide = hum.FloorMaterial ~= Enum.Material.Air
                                    else
                                        -- Bagian tubuh lain (tangan, kaki, kepala, torso) dimatikan total supaya langsung tembus tembok
                                        part.CanCollide = false
                                    end
                                end
                            end
                        end
                    end
                end)
                print("[Smart Noclip] Diaktifkan!")
            end
        },
        ["unnoclip"] = {
            ["ListName"] = "unnoclip",
            ["Description"] = "Menonaktifkan Smart Noclip.",
            ["Aliases"] = {"unnc"},
            ["Function"] = function(args, speaker)
                _G.SmartNoclipActive = false

                if _G.SmartNoclipConnection then
                    _G.SmartNoclipConnection:Disconnect()
                    _G.SmartNoclipConnection = nil
                end

                local char = speaker.Character
                if char then
                    for _, part in ipairs(char:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.CanCollide = true
                        end
                    end
                end
                print("[Smart Noclip] Dimatikan.")
            end
        }
    }
}

return plugin
