local smartrejoin = {
    ["PluginName"] = "Smart Auto-Rejoin & Retry",
    ["PluginDescription"] = "Otomatis Rejoin di map saat ini atau Retry Teleport jika gagal pindah map.",
    ["Commands"] = {}
}

--==================================================
-- SERVICES & VARIABLES
--==================================================
local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")
local LocalPlayer = Players.LocalPlayer

-- Status Default: Aktif
local autoRejoinActive = true

--==================================================
-- TELEPORT ERROR LISTENERS
--==================================================
pcall(function()
    TeleportService.TeleportFailed:Connect(function(player, teleportResult, errorMessage, targetPlaceId)
        if player == LocalPlayer and autoRejoinActive then
            
            -- Cek apakah Error karena Restrict / Restricted Place (Error Code 773 / Unauthorized)
            local isRestricted = false
            if teleportResult == Enum.TeleportResult.Unauthorized or teleportResult == Enum.TeleportResult.IsTeleportWithCodeAllowed then
                isRestricted = true
            end
            
            if errorMessage and (string.find(string.lower(errorMessage), "restricted") or string.find(errorMessage, "773")) then
                isRestricted = true
            end

            -- LOGIKA PINTAR:
            -- Jika gagal ke map tujuan TAPI bukannya dilarang/restricted -> Retry ke map tujuan
            if targetPlaceId and targetPlaceId > 0 and targetPlaceId ~= game.PlaceId and not isRestricted then
                pcall(function()
                    if notify then notify("Smart Rejoin", "Gagal masuk map tujuan! Mencoba RETRY...", 5) end
                end)
                task.wait(1.5)
                pcall(function()
                    TeleportService:Teleport(targetPlaceId, LocalPlayer)
                end)
            else
                -- Jika ternyata tempatnya DIBATASI (Error 773) atau kendala di map sekarang -> REJOIN Map Saat Ini
                pcall(function()
                    if notify then 
                        if isRestricted then
                            notify("Smart Rejoin", "Map tujuan dibatasi (773)! Mengalihkan Rejoin ke map ini...", 5)
                        else
                            notify("Smart Rejoin", "Kendala di map saat ini. Melakukan REJOIN...", 5)
                        end
                    end
                end)
                task.wait(1.5)
                pcall(function()
                    TeleportService:Teleport(game.PlaceId, LocalPlayer)
                end)
            end
        end
    end)
end)

pcall(function()
    if TeleportService.TeleportInitFailed then
        TeleportService.TeleportInitFailed:Connect(function(player, teleportResult, errorMessage)
            if player == LocalPlayer and autoRejoinActive then
                pcall(function()
                    if notify then notify("Smart Rejoin", "Inisialisasi teleport gagal. Melakukan REJOIN...", 5) end
                end)
                task.wait(1.5)
                pcall(function()
                    TeleportService:Teleport(game.PlaceId, LocalPlayer)
                end)
            end
        end)
    end
end)

--==================================================
-- COMMAND IMPLEMENTATION
--==================================================

smartrejoin.Commands["smartrj"] = {
    ["ListName"] = "smartrj / togglesr",
    ["Description"] = "Mengaktifkan atau mematikan fitur Smart Auto-Rejoin & Retry",
    ["Aliases"] = {"togglesr", "srjoin"},
    ["Function"] = function(args, speaker)
        autoRejoinActive = not autoRejoinActive
        pcall(function()
            if notify then
                if autoRejoinActive then
                    notify("Smart Rejoin", "Fitur Smart Rejoin: AKTIF", 4)
                else
                    notify("Smart Rejoin", "Fitur Smart Rejoin: NONAKTIF", 4)
                end
            end
        end)
    end
}

return smartrejoin
