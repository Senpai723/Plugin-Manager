local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local LocalPlayer = Players.LocalPlayer

-- GUNAKAN GLOBAL VARIABEL (_G) AGAR STATE TIDAK MUDAH HILANG SAAT WINDOW TUTUP-BUKA
_G.__VoiceSpyState = _G.__VoiceSpyState or {
    isSpying = false,
    spyTarget = nil,
    spyConnection = nil
}

local state = _G.__VoiceSpyState

local Plugin = {
    ["PluginName"] = "VoiceSpy & MuteManager",
    ["PluginDescription"] = "Menguping Voice Chat jarak jauh dan mengelola suara map secara total",
    ["Commands"] = {
        ["voicespy"] = {
            ["ListName"] = "voicespy [nama_player]",
            ["Description"] = "Mengarahkan pendengaran suara ke player target dari jauh",
            ["Aliases"] = {"vspy"},
            ["Function"] = function(args, speaker)
                local targetName = args[1]
                if not targetName or targetName == "" then
                    print("[VoiceSpy] Masukkan nama player target!")
                    return
                end

                local foundTarget = nil
                local targetLower = string.lower(targetName)

                -- PENCARIAN FLEKSIBEL (Bisa nama lengkap, display name, atau min 3 huruf awal)
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer then
                        local pName = string.lower(p.Name)
                        local pDisp = string.lower(p.DisplayName or "")
                        if pName == targetLower or pDisp == targetLower or string.find(pName, targetLower, 1, true) or string.find(pDisp, targetLower, 1, true) then
                            foundTarget = p
                            break
                        end
                    end
                end

                if not foundTarget then
                    print("[VoiceSpy] Player '" .. tostring(targetName) .. "' tidak ditemukan!")
                    return
                end

                state.spyTarget = foundTarget
                state.isSpying = true

                if state.spyConnection then state.spyConnection:Disconnect() end

                -- Sinkronisasi pendengaran Spatial Voice ke posisi Kepala Target secara real-time
                state.spyConnection = RunService.RenderStepped:Connect(function()
                    if state.isSpying and state.spyTarget and state.spyTarget.Character then
                        local targetHead = state.spyTarget.Character:FindFirstChild("Head") or state.spyTarget.Character:FindFirstChild("HumanoidRootPart")
                        local localChar = LocalPlayer.Character
                        
                        if targetHead and localChar then
                            local localHead = localChar:FindFirstChild("Head") or localChar:FindFirstChild("HumanoidRootPart")
                            if localHead then
                                -- Pindahkan posisi listener lokal ke posisi kepala target agar suara chat mereka terdengar jelas
                                localHead.CFrame = targetHead.CFrame
                            end
                        end
                    end
                end)

                print("[VoiceSpy] Berhasil menguping suara: " .. foundTarget.Name .. " (" .. foundTarget.DisplayName .. ")")
            end
        },
        ["unvoicespy"] = {
            ["ListName"] = "unvoicespy",
            ["Description"] = "Mengembalikan pendengaran suara ke karakter sendiri",
            ["Aliases"] = {"unvspy"},
            ["Function"] = function(args, speaker)
                state.isSpying = false
                state.spyTarget = nil
                
                if state.spyConnection then
                    state.spyConnection:Disconnect()
                    state.spyConnection = nil
                end
                
                -- Reset posisi listener kembali ke karakter lokal (respawn/reset posisi kepala player sendiri)
                pcall(function()
                    local char = LocalPlayer.Character
                    if char then
                        local hum = char:FindFirstChildOfClass("Humanoid")
                        if hum then
                            -- Sedikit trigger pemulihan posisi atau biarkan game merefresh
                            workspace.CurrentCamera.CameraSubject = hum
                        end
                    end
                end)

                print("[VoiceSpy] Pendengaran dikembalikan normal.")
            end
        },
        ["mutesound"] = {
            ["ListName"] = "mutesound",
            ["Description"] = "Mutes map sounds while preserving whitelisted sounds and blocking new jumpscares.",
            ["Aliases"] = {"mshutupm", "mutesound"},
            ["Function"] = function(args, speaker)
                _G.__VoiceSpyMuteState = _G.__VoiceSpyMuteState or {
                    enabled = false,
                    sounds = setmetatable({}, {__mode = "k"}),
                    connections = setmetatable({}, {__mode = "k"}),
                    addedConnection = nil
                }

                local muteState = _G.__VoiceSpyMuteState
                muteState.enabled = true

                local allowedSoundNames = {
                    "checkpoint", "respawn", "cp", "pos", "pos pemeriksaan", "pospemeriksaan", "uuhh", "oof", "OOF", "Oof",
                    "gettingup", "getting up",
                    "music", "radio", "boombox", "jukebox", "playlist",
                    "song", "songs", "soundtrack", "bgm", "backgroundmusic",
                    "background music", "musicplayer", "music player",
                    "audioplayer", "audio player"
                }

                local allowedSoundIds = {
                    "3060494212", "17685142849", "90647372", "18138578833",
                }

                local function normalizeSoundId(soundId)
                    local id = tostring(soundId or "")
                    return string.match(id, "(%d+)") or ""
                end

                local function isAllowedSound(sound)
                    if not sound or not sound:IsA("Sound") then return false end
                    local name = string.lower(sound.Name or "")
                    for _, keyword in ipairs(allowedSoundNames) do
                        keyword = string.lower(tostring(keyword))
                        if string.find(name, keyword, 1, true) then return true end
                    end
                    local soundId = normalizeSoundId(sound.SoundId)
                    if soundId ~= "" then
                        for _, allowedId in ipairs(allowedSoundIds) do
                            if soundId == normalizeSoundId(allowedId) then return true end
                        end
                    end
                    return false
                end

                local function muteSound(sound)
                    if not muteState.enabled or not sound or not sound:IsA("Sound") or not sound.Parent then return end
                    if isAllowedSound(sound) then return end

                    if muteState.sounds[sound] == nil then
                        muteState.sounds[sound] = sound.Volume
                    end

                    if not muteState.connections[sound] then
                        local volumeConnection = sound:GetPropertyChangedSignal("Volume"):Connect(function()
                            if muteState.enabled and sound.Parent and not isAllowedSound(sound) and sound.Volume ~= 0 then
                                sound.Volume = 0
                            end
                        end)
                        muteState.connections[sound] = { volume = volumeConnection }
                    end
                    sound.Volume = 0
                end

                if muteState.addedConnection then
                    muteState.addedConnection:Disconnect()
                    muteState.addedConnection = nil
                end

                for _, descendant in ipairs(game:GetDescendants()) do
                    if descendant:IsA("Sound") then muteSound(descendant) end
                end

                muteState.addedConnection = game.DescendantAdded:Connect(function(descendant)
                    if descendant:IsA("Sound") then
                        task.defer(function()
                            if muteState.enabled and descendant.Parent then muteSound(descendant) end
                        end)
                    end
                end)
            end
        },
        ["unmutesound"] = {
            ["ListName"] = "unmutesound",
            ["Description"] = "Restores sounds muted by mutesound to their original volumes.",
            ["Aliases"] = {"munmute", "unmute", "unmutesound"},
            ["Function"] = function(args, speaker)
                local muteState = _G.__VoiceSpyMuteState
                if not muteState then return end
                muteState.enabled = false

                if muteState.addedConnection then
                    muteState.addedConnection:Disconnect()
                    muteState.addedConnection = nil
                end

                for sound, originalVolume in pairs(muteState.sounds) do
                    if sound and sound.Parent and sound:IsA("Sound") and originalVolume ~= nil then
                        sound.Volume = originalVolume
                    end
                    let conns = muteState.connections[sound]
                    if conns then
                        for _, conn in pairs(conns) do if conn then conn:Disconnect() end end
                        muteState.connections[sound] = nil
                    end
                end

                muteState.sounds = setmetatable({}, {__mode = "k"})
                muteState.connections = setmetatable({}, {__mode = "k"})
            end
        }
    }
}

return Plugin
