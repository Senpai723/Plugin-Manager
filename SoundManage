local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local Workspace = game:GetService("Workspace")
local LocalPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera

-- GLOBAL STATE UNTUK SPECTATE & MUTE SOUND
_G.__SpectateState = _G.__SpectateState or {
    isSpectating = false,
    spectateTarget = nil,
    originalSubject = nil,
    originalCameraType = nil
}

_G.__VoiceSpyMuteState = _G.__VoiceSpyMuteState or {
    enabled = false,
    mutedSounds = {},
    connections = {},
    addedConn = nil
}

local state = _G.__SpectateState
local muteState = _G.__VoiceSpyMuteState

-- DAFTAR WHITELIST SUARA YANG BOLEH DIBUNYIKAN
local ALLOWED_KEYWORDS = {
    "checkpoint", "respawn", "cp", "pos", "pospemeriksaan", 
    "uuhh", "oof", "gettingup", "music", "radio", "boombox", 
    "jukebox", "song", "soundtrack", "bgm", "audio"
}

local function isAllowedSound(sound)
    if not sound or not sound:IsA("Sound") then return end
    local name = string.lower(sound.Name or "")
    for _, kw in ipairs(ALLOWED_KEYWORDS) do
        if string.find(name, kw, 1, true) then return true end
    end
    return false
end

local function applyMute(sound)
    if not muteState.enabled or not sound or not sound:IsA("Sound") then return end
    if isAllowedSound(sound) then return end

    if muteState.mutedSounds[sound] == nil then
        muteState.mutedSounds[sound] = sound.Volume
    end

    sound.Volume = 0

    if not muteState.connections[sound] then
        muteState.connections[sound] = sound:GetPropertyChangedSignal("Volume"):Connect(function()
            if muteState.enabled and sound.Parent and not isAllowedSound(sound) then
                sound.Volume = 0
            end
        end)
    end
end

local Plugin = {
    ["PluginName"] = "Spectate & MuteManager",
    ["PluginDescription"] = "Spectate player target untuk memantau & mendengar suara, serta kelola suara map",
    ["Commands"] = {
        ["spectate"] = {
            ["ListName"] = "spectate [nama_player]",
            ["Description"] = "Melihat dan mendengarkan player target dari kejauhan secara 3D bebas",
            ["Aliases"] = {"spec", "view"},
            ["Function"] = function(args, speaker)
                local targetName = args[1]
                if not targetName or targetName == "" then
                    print("[Spectate] Masukkan nama player target!")
                    return
                end

                local foundTarget = nil
                local targetLower = string.lower(targetName)

                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer then
                        local pName = string.lower(p.Name)
                        local pDisp = string.lower(p.DisplayName or "")
                        if pName == targetLower or pDisp == targetLower or string.find(pName, targetLower, 1, true) or string.find(pDisp, targetLower, 1, true) then
                            foundTarget = p
                            break
                        end
                    end
                end

                if not foundTarget then
                    print("[Spectate] Player '" .. tostring(targetName) .. "' tidak ditemukan!")
                    return
                end

                state.spectateTarget = foundTarget
                state.isSpectating = true
                state.originalCameraType = Camera.CameraType
                state.originalSubject = Camera.CameraSubject

                pcall(function()
                    if foundTarget.Character and foundTarget.Character:FindFirstChild("Humanoid") then
                        Camera.CameraSubject = foundTarget.Character.Humanoid
                        Camera.CameraType = Enum.CameraType.Custom
                        
                        -- Pindahkan karakter lokal mendekati target supaya bisa diklik/interaksi
                        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and foundTarget.Character:FindFirstChild("HumanoidRootPart") then
                            LocalPlayer.Character.HumanoidRootPart.CFrame = foundTarget.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 3)
                        end
                    end
                end)

                print("[Spectate] Sedang melihat player: " .. foundTarget.Name)
            end
        },
        ["unspectate"] = {
            ["ListName"] = "unspectate",
            ["Description"] = "Keluar dari mode spectate dan kembali ke karakter sendiri",
            ["Aliases"] = {"unspec", "backview"},
            ["Function"] = function(args, speaker)
                state.isSpectating = false
                state.spectateTarget = nil
                
                -- Kembalikan kamera ke karakter lokal
                pcall(function()
                    Camera.CameraType = Enum.CameraType.Custom
                    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
                        Camera.CameraSubject = LocalPlayer.Character.Humanoid
                    elseif state.originalSubject then
                        Camera.CameraSubject = state.originalSubject
                    end
                end)

                print("[Spectate] Kamera dikembalikan ke karakter sendiri.")
            end
        },
        ["mutesound"] = {
            ["ListName"] = "mutesound",
            ["Description"] = "Mutes map sounds while preserving whitelisted sounds.",
            ["Aliases"] = {"mutesound"},
            ["Function"] = function(args, speaker)
                muteState.enabled = true

                if muteState.addedConn then
                    muteState.addedConn:Disconnect()
                    muteState.addedConn = nil
                end

                for _, obj in ipairs(Workspace:GetDescendants()) do
                    if obj:IsA("Sound") then applyMute(obj) end
                end
                for _, obj in ipairs(SoundService:GetDescendants()) do
                    if obj:IsA("Sound") then applyMute(obj) end
                end

                muteState.addedConn = Workspace.DescendantAdded:Connect(function(obj)
                    if muteState.enabled and obj:IsA("Sound") then
                        task.defer(function() applyMute(obj) end)
                    end
                end)

                print("[MuteSound] Berhasil membisukan suara latar map.")
            end
        },
        ["unmutesound"] = {
            ["ListName"] = "unmutesound",
            ["Description"] = "Restores sounds muted by mutesound.",
            ["Aliases"] = {"unmutesound"},
            ["Function"] = function(args, speaker)
                muteState.enabled = false

                if muteState.addedConn then
                    muteState.addedConn:Disconnect()
                    muteState.addedConn = nil
                end

                for sound, origVol in pairs(muteState.mutedSounds) do
                    if sound and sound.Parent and sound:IsA("Sound") and origVol then
                        sound.Volume = origVol
                    end
                end

                for _, conn in pairs(muteState.connections) do
                    pcall(function() conn:Disconnect() end)
                end

                muteState.mutedSounds = {}
                muteState.connections = {}

                print("[MuteSound] Suara map dikembalikan normal.")
            end
        }
    }
}

return Plugin
