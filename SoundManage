local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local Workspace = game:GetService("Workspace")
local LocalPlayer = Players.LocalPlayer

-- GLOBAL STATE UNTUK VOICE SPY & MUTE SOUND
_G.__VoiceSpyState = _G.__VoiceSpyState or {
    isSpying = false,
    spyTarget = nil,
    spyConnection = nil
}

_G.__VoiceSpyMuteState = _G.__VoiceSpyMuteState or {
    enabled = false,
    mutedSounds = {},
    connections = {},
    addedConn = nil
}

local state = _G.__VoiceSpyState
local muteState = _G.__VoiceSpyMuteState

-- DAFTAR WHITELIST SUARA YANG BOLEH DIBUNYIKAN
local ALLOWED_KEYWORDS = {
    "checkpoint", "respawn", "cp", "pos", "pospemeriksaan", 
    "uuhh", "oof", "gettingup", "music", "radio", "boombox", 
    "jukebox", "song", "soundtrack", "bgm", "audio"
}

local function isAllowedSound(sound)
    if not sound or not sound:IsA("Sound") then return false end
    local name = string.lower(sound.Name or "")
    for _, kw in ipairs(ALLOWED_KEYWORDS) do
        if string.find(name, kw, 1, true) then return true end
    end
    return false
end

local function applyMute(sound)
    if not muteState.enabled or not sound or not sound:IsA("Sound") then return end
    if isAllowedSound(sound) then return end

    if muteState.mutedSounds[sound] == nil then
        muteState.mutedSounds[sound] = sound.Volume
    end

    sound.Volume = 0

    -- Cegah suara diubah volumenya kembali secara paksa oleh game/map
    if not muteState.connections[sound] then
        muteState.connections[sound] = sound:GetPropertyChangedSignal("Volume"):Connect(function()
            if muteState.enabled and sound.Parent and not isAllowedSound(sound) then
                sound.Volume = 0
            end
        end)
    end
end

local Plugin = {
    ["PluginName"] = "VoiceSpy & MuteManager",
    ["PluginDescription"] = "Menguping Voice Chat jarak jauh dan mengelola suara map secara total",
    ["Commands"] = {
        ["voicespy"] = {
            ["ListName"] = "voicespy [nama_player]",
            ["Description"] = "Mengarahkan pendengaran suara ke player target",
            ["Aliases"] = {"vspy"},
            ["Function"] = function(args, speaker)
                local targetName = args[1]
                if not targetName or targetName == "" then
                    print("[VoiceSpy] Masukkan nama player target!")
                    return
                end

                local foundTarget = nil
                local targetLower = string.lower(targetName)

                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer then
                        local pName = string.lower(p.Name)
                        local pDisp = string.lower(p.DisplayName or "")
                        if pName == targetLower or pDisp == targetLower or string.find(pName, targetLower, 1, true) or string.find(pDisp, targetLower, 1, true) then
                            foundTarget = p
                            break
                        end
                    end
                end

                if not foundTarget then
                    print("[VoiceSpy] Player '" .. tostring(targetName) .. "' tidak ditemukan!")
                    return
                end

                state.spyTarget = foundTarget
                state.isSpying = true

                if state.spyConnection then state.spyConnection:Disconnect() end

                -- METODE LISTENER AMAN: Memindahkan fokus pendengaran suara Roblox ke kepala target
                state.spyConnection = RunService.RenderStepped:Connect(function()
                    if state.isSpying and state.spyTarget and state.spyTarget.Character then
                        local head = state.spyTarget.Character:FindFirstChild("Head")
                        if head then
                            pcall(function()
                                SoundService:SetListener(Enum.ListenerType.CFrame, head.CFrame)
                            end)
                        end
                    end
                end)

                print("[VoiceSpy] Berhasil menguping suara: " .. foundTarget.Name)
            end
        },
        ["unvoicespy"] = {
            ["ListName"] = "unvoicespy",
            ["Description"] = "Mengembalikan pendengaran suara ke normal",
            ["Aliases"] = {"unvspy"},
            ["Function"] = function(args, speaker)
                state.isSpying = false
                state.spyTarget = nil
                
                if state.spyConnection then
                    state.spyConnection:Disconnect()
                    state.spyConnection = nil
                end
                
                -- Kembalikan pendengaran ke kamera/karakter sendiri
                pcall(function()
                    SoundService:SetListener(Enum.ListenerType.Camera, Workspace.CurrentCamera)
                end)

                print("[VoiceSpy] Pendengaran dikembalikan normal.")
            end
        },
        ["mutesound"] = {
            ["ListName"] = "mutesound",
            ["Description"] = "Mutes map sounds while preserving whitelisted sounds.",
            ["Aliases"] = {"mutesound"},
            ["Function"] = function(args, speaker)
                muteState.enabled = true

                -- Bersihkan koneksi lama jika ada
                if muteState.addedConn then
                    muteState.addedConn:Disconnect()
                    muteState.addedConn = nil
                end

                -- Mute semua suara yang sudah ada di dalam game saat ini
                for _, obj in ipairs(Workspace:GetDescendants()) do
                    if obj:IsA("Sound") then applyMute(obj) end
                end
                for _, obj in ipairs(SoundService:GetDescendants()) do
                    if obj:IsA("Sound") then applyMute(obj) end
                end

                -- Pantau suara baru secara real-time (mencegah jumpscare / suara map baru)
                muteState.addedConn = Workspace.DescendantAdded:Connect(function(obj)
                    if muteState.enabled and obj:IsA("Sound") then
                        task.defer(function() applyMute(obj) end)
                    end
                end)

                print("[MuteSound] Berhasil membisukan suara latar map.")
            end
        },
        ["unmutesound"] = {
            ["ListName"] = "unmutesound",
            ["Description"] = "Restores sounds muted by mutesound.",
            ["Aliases"] = {"unmutesound"},
            ["Function"] = function(args, speaker)
                muteState.enabled = false

                if muteState.addedConn then
                    muteState.addedConn:Disconnect()
                    muteState.addedConn = nil
                end

                -- Kembalikan volume suara ke semula
                for sound, origVol in pairs(muteState.mutedSounds) do
                    if sound and sound.Parent and sound:IsA("Sound") and origVol then
                        sound.Volume = origVol
                    end
                end

                -- Putuskan semua sinyal pemantau volume
                for _, conn in pairs(muteState.connections) do
                    pcall(function() conn:Disconnect() end)
                end

                muteState.mutedSounds = {}
                muteState.connections = {}

                print("[MuteSound] Suara map dikembalikan normal.")
            end
        }
    }
}

return Plugin
