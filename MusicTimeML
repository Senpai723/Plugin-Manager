local Plugin = {
    ["PluginName"] = getTranslation("PluginName", isru and "ru" or "en"),
    ["PluginDescription"] = getTranslation("PluginDescription", isru and "ru" or "en"),
    ["Commands"] = {
        ["playmusic"] = {
            ["ListName"] = getTranslation("playmusic", isru and "ru" or "en"),
            ["Description"] = getTranslation("playmusic_Description", isru and "ru" or "en"),
            ["Aliases"] = {"mplay", "playm"},
            ["Function"] = function(args, speaker)
                if activeSound then
                    activeSound:Stop()
                    activeSound:Destroy()
                    activeSound = nil
                end

                local g = Instance.new("Sound")
                local Content = game:GetService("ContentProvider")
                g.Parent = workspace

                g.SoundId = args[1] and ("rbxassetid://" .. args[1]) or "rbxassetid://6729922069"
                g.Volume = tonumber(args[3]) or 1
                g.Pitch = tonumber(args[2]) or 1

                Content:PreloadAsync({g})
                g:Play()

                activeSound = g

                wait(g.TimeLength + 1)
                if activeSound == g then
                    g:Destroy()
                    activeSound = nil
                end
            end
        },
        ["stopmusic"] = {
            ["ListName"] = getTranslation("stopmusic", isru and "ru" or "en"),
            ["Description"] = getTranslation("stopmusic_Description", isru and "ru" or "en"),
            ["Aliases"] = {"mstopm", "mstopmusic"},
            ["Function"] = function(args, speaker)
                if activeSound then
                    activeSound:Stop()
                    activeSound:Destroy()
                    activeSound = nil
                end
            end
        },
        ["pausemusic"] = {
            ["ListName"] = getTranslation("pausemusic", isru and "ru" or "en"),
            ["Description"] = getTranslation("pausemusic_Description", isru and "ru" or "en"),
            ["Aliases"] = {"mpausem", "mpausemusic"},
            ["Function"] = function(args, speaker)
                if activeSound then
                    activeSound:Pause()
                end
            end
        },
        ["setplaymusic"] = {
            ["ListName"] = getTranslation("setplaymusic", isru and "ru" or "en"),
            ["Description"] = getTranslation("pausemusic_Description", isru and "ru" or "en"),
            ["Aliases"] = {"msetplaym", "msetplaymusic"},
            ["Function"] = function(args, speaker)
                if activeSound then
                    local time = tonumber(args[1])
                    if time and time >= 0 and time <= activeSound.TimeLength then
                        activeSound.TimePosition = time
                        activeSound:Play()  -- Возобновить воспроизведение с указанной позиции
                    else
                        print("<SE MTML> Invalid time specified.")
                    end
                end
            end
        },
        ["mutesound"] = {
            ["ListName"] = getTranslation("mutesound", isru and "ru" or "en"),
            ["Description"] = "Mutes map sounds while preserving whitelisted music/checkpoint/respawn sounds. Use unmutesound to restore.",
            ["Aliases"] = {"mshutupm", "mutesound"},
            ["Function"] = function(args, speaker)
                -- Persistent, reversible sound mute.
                -- Volume is saved per Sound so unmutesound can restore the original value.
                _G.__MusicTimeMuteState = _G.__MusicTimeMuteState or {
                    enabled = false,
                    sounds = setmetatable({}, {__mode = "k"}),
                    connections = setmetatable({}, {__mode = "k"}),
                    addedConnection = nil
                }

                local state = _G.__MusicTimeMuteState
                state.enabled = true

                -- Whitelist berdasarkan NAMA Sound.
                -- Tambahkan keyword nama di sini kalau ingin Sound tertentu selalu lolos.
                local allowedSoundNames = {
                    "checkpoint", "respawn", "cp", "pos", "pos pemeriksaan", "pospemeriksaan", "uuhh", "oof", "OOF", "Oof",
                    "gettingup", "getting up",
                    "music", "radio", "boombox", "jukebox", "playlist",
                    "song", "songs", "soundtrack", "bgm", "backgroundmusic",
                    "background music", "musicplayer", "music player",
                    "audioplayer", "audio player"
                }

                -- Whitelist berdasarkan SOUND ID.
                -- Cukup masukkan angka ID, TANPA "rbxassetid://".
                -- Contoh: "3060494212"
                local allowedSoundIds = {
                    "3060494212", "17685142849", "90647372", "18138578833",
                }

                local function normalizeSoundId(soundId)
                    local id = tostring(soundId or "")
                    -- Ambil bagian angka dari SoundId, sehingga:
                    -- rbxassetid://123456789 -> 123456789
                    -- 123456789            -> 123456789
                    return string.match(id, "(%d+)") or ""
                end

                local function isAllowedSound(sound)
                    if not sound or not sound:IsA("Sound") then
                        return false
                    end

                    -- 1. Cek whitelist berdasarkan nama Sound.
                    local name = string.lower(sound.Name or "")
                    for _, keyword in ipairs(allowedSoundNames) do
                        keyword = string.lower(tostring(keyword))
                        if string.find(name, keyword, 1, true) then
                            return true
                        end
                    end

                    -- 2. Cek whitelist berdasarkan SoundId.
                    local soundId = normalizeSoundId(sound.SoundId)
                    if soundId ~= "" then
                        for _, allowedId in ipairs(allowedSoundIds) do
                            if soundId == normalizeSoundId(allowedId) then
                                return true
                            end
                        end
                    end

                    return false
                end

                local function disconnectSound(sound)
                    local conns = state.connections[sound]
                    if conns then
                        for _, connection in pairs(conns) do
                            if connection then
                                connection:Disconnect()
                            end
                        end
                        state.connections[sound] = nil
                    end
                end

                local function muteSound(sound)
                    if not state.enabled or not sound or not sound:IsA("Sound") or not sound.Parent then
                        return
                    end

                    if isAllowedSound(sound) then
                        return
                    end

                    -- Save the original volume only once.
                    if state.sounds[sound] == nil then
                        state.sounds[sound] = sound.Volume
                    end

                    -- Avoid duplicate listeners.
                    if not state.connections[sound] then
                        local volumeConnection = sound:GetPropertyChangedSignal("Volume"):Connect(function()
                            if state.enabled and sound.Parent and not isAllowedSound(sound) and sound.Volume ~= 0 then
                                sound.Volume = 0
                            end
                        end)

                        state.connections[sound] = {
                            volume = volumeConnection
                        }
                    end

                    sound.Volume = 0
                end

                -- Clean up an old listener before starting a fresh global watcher.
                if state.addedConnection then
                    state.addedConnection:Disconnect()
                    state.addedConnection = nil
                end

                for _, descendant in ipairs(game:GetDescendants()) do
                    if descendant:IsA("Sound") then
                        muteSound(descendant)
                    end
                end

                state.addedConnection = game.DescendantAdded:Connect(function(descendant)
                    if descendant:IsA("Sound") then
                        task.defer(function()
                            if state.enabled and descendant.Parent then
                                muteSound(descendant)
                            end
                        end)
                    end
                end)

                print("[MusicTime] Sound mute ON. Use 'unmutesound' to restore original volumes.")
            end
        },
        ["unmutesound"] = {
            ["ListName"] = "unmutesound",
            ["Description"] = "Restores sounds muted by mutesound to their original volumes.",
            ["Aliases"] = {"munmute", "unmute", "unmutesound"},
            ["Function"] = function(args, speaker)
                local state = _G.__MusicTimeMuteState
                if not state then
                    print("[MusicTime] No active sound mute state.")
                    return
                end

                state.enabled = false

                if state.addedConnection then
                    state.addedConnection:Disconnect()
                    state.addedConnection = nil
                end

                for sound, originalVolume in pairs(state.sounds) do
                    if sound and sound.Parent and sound:IsA("Sound") and originalVolume ~= nil then
                        -- Do not touch whitelisted sounds; they were never muted by us.
                        sound.Volume = originalVolume
                    end
                    disconnectSound(sound)
                end

                state.sounds = setmetatable({}, {__mode = "k"})
                state.connections = setmetatable({}, {__mode = "k"})

                print("[MusicTime] Sound mute OFF. Original volumes restored.")
            end
        }
    }
}

