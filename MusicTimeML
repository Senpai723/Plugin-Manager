local activeSound = nil

local Plugin = {
    ["PluginName"] = "MUSIC TIME",
    ["PluginDescription"] = "Plays audio by using ID from roblox store.",
    ["Commands"] = {
        ["playmusic"] = {
            ["ListName"] = "playmusic [id] (pitch) (volume)",
            ["Description"] = "Plays audio by using ID from roblox store",
            ["Aliases"] = {"mplay", "playm"},
            ["Function"] = function(args, speaker)
                if activeSound then
                    activeSound:Stop()
                    activeSound:Destroy()
                    activeSound = nil
                end

                local g = Instance.new("Sound")
                local Content = game:GetService("ContentProvider")
                g.Parent = workspace

                g.SoundId = args[1] and ("rbxassetid://" .. args[1]) or "rbxassetid://6729922069"
                g.Volume = tonumber(args[3]) or 1
                g.Pitch = tonumber(args[2]) or 1

                Content:PreloadAsync({g})
                g:Play()

                activeSound = g

                task.spawn(function()
                    task.wait(g.TimeLength + 1)
                    if activeSound == g then
                        g:Destroy()
                        activeSound = nil
                    end
                end)
            end
        },
        ["stopmusic"] = {
            ["ListName"] = "stopmusic",
            ["Description"] = "Stops audio immediately",
            ["Aliases"] = {"mstopm", "mstopmusic"},
            ["Function"] = function(args, speaker)
                if activeSound then
                    activeSound:Stop()
                    activeSound:Destroy()
                    activeSound = nil
                end
            end
        }
    }
}

return Plugin
