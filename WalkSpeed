local plugin = {
    ["PluginName"] = "walkspeed_persistent";
    ["PluginDescription"] = "Custom WalkSpeed berbasis Velocity (Tembus Anti-Cheat & Map Reset).";
    ["Commands"] = {
        ["ws"] = {
            ["ListName"] = "ws [number]",
            ["Description"] = "Memaksa kecepatan gerak player menggunakan CFrame velocity.",
            ["Aliases"] = {"speed", "walkspeed"},
            ["Function"] = function(args, speaker)
                local speedValue = tonumber(args[1])
                if not speedValue then
                    warn("[WalkSpeed] Masukkan angka kecepatan yang valid! Contoh: ws 50")
                    return
                end

                _G.CustomSpeedMultiplier = speedValue / 16 -- Normal Roblox speed adalah 16
                _G.ActiveSpeedBoost = true

                local RunService = game:GetService("RunService")
                local Players = game:GetService("Players")
                local localPlayer = Players.LocalPlayer

                if _G.SpeedConnection then
                    _G.SpeedConnection:Disconnect()
                    _G.SpeedConnection = nil
                end

                _G.SpeedConnection = RunService.RenderStepped:Connect(function(dt)
                    if not _G.ActiveSpeedBoost then return end

                    local char = localPlayer.Character
                    if char then
                        local hum = char:FindFirstChildOfClass("Humanoid")
                        local rootPart = char:FindFirstChild("HumanoidRootPart")

                        if hum and rootPart then
                            -- Pastikan humanoid walkspeed tetap diset tinggi juga
                            hum.WalkSpeed = 16 -- Biar animasi jalan normal tidak glitch
                            
                            local moveDir = hum.MoveDirection
                            if moveDir.Magnitude > 0 then
                                -- Dorong posisi rootPart secara manual sesuai arah jalan dan multiplier speed
                                rootPart.CFrame = rootPart.CFrame + (moveDir * (_G.CustomSpeedMultiplier * 16 - 16) * dt)
                            end
                        end
                    end
                end)
                print("[WalkSpeed] Mode CFrame Velocity diaktifkan dengan speed multiplier:", speedValue)
            end
        },
        ["unws"] = {
            ["ListName"] = "unws",
            ["Description"] = "Mematikan custom speed.",
            ["Aliases"] = {"unwalkspeed", "resetws"},
            ["Function"] = function(args, speaker)
                _G.ActiveSpeedBoost = false
                if _G.SpeedConnection then
                    _G.SpeedConnection:Disconnect()
                    _G.SpeedConnection = nil
                end
                
                local char = speaker.Character
                if char then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if hum then
                        hum.WalkSpeed = 16
                    end
                end
                print("[WalkSpeed] Dinonaktifkan!")
            end
        }
    }
}

return plugin
