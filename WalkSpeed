local plugin = {
    ["PluginName"] = "walkspeed_aggressive";
    ["PluginDescription"] = "WalkSpeed agresif yang mempertahankan animasi lari natural.";
    ["Commands"] = {
        ["ws"] = {
            ["ListName"] = "ws [number]",
            ["Description"] = "Mengubah WalkSpeed asli dengan animasi normal.",
            ["Aliases"] = {"speed", "walkspeed"},
            ["Function"] = function(args, speaker)
                local speedValue = tonumber(args[1])
                if not speedValue then
                    warn("[WalkSpeed] Masukkan angka kecepatan yang valid! Contoh: ws 50")
                    return
                end

                _G.TargetWalkSpeed = speedValue
                _G.ActiveAggressiveWS = true

                local RunService = game:GetService("RunService")
                local Players = game:GetService("Players")
                local localPlayer = Players.LocalPlayer

                if _G.AggressiveWSConnection then
                    _G.AggressiveWSConnection:Disconnect()
                    _G.AggressiveWSConnection = nil
                end

                _G.AggressiveWSConnection = RunService.RenderStepped:Connect(function()
                    if not _G.ActiveAggressiveWS then return end

                    local char = localPlayer.Character
                    if char then
                        local hum = char:FindFirstChildOfClass("Humanoid")
                        if hum and hum.WalkSpeed ~= _G.TargetWalkSpeed then
                            hum.WalkSpeed = _G.TargetWalkSpeed
                        end
                    end
                end)
                print("[WalkSpeed] Mode agresif diaktifkan dengan speed:", speedValue)
            end
        },
        ["unws"] = {
            ["ListName"] = "unws",
            ["Description"] = "Mematikan walkspeed agresif.",
            ["Aliases"] = {"unwalkspeed", "resetws"},
            ["Function"] = function(args, speaker)
                _G.ActiveAggressiveWS = false
                if _G.AggressiveWSConnection then
                    _G.AggressiveWSConnection:Disconnect()
                    _G.AggressiveWSConnection = nil
                end
                
                local char = speaker.Character
                if char then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if hum then
                        hum.WalkSpeed = 16
                    end
                end
                print("[WalkSpeed] Dinonaktifkan!")
            end
        }
    }
}

return plugin
