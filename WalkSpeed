local plugin = {
    ["PluginName"] = "walkspeed_persistent";
    ["PluginDescription"] = "Mengubah WalkSpeed player secara kontinu (Anti-Reset Map).";
    ["Commands"] = {
        ["ws"] = {
            ["ListName"] = "ws [number]",
            ["Description"] = "Mengunci WalkSpeed player agar tidak bisa direset oleh map.",
            ["Aliases"] = {"speed", "walkspeed"},
            ["Function"] = function(args, speaker)
                local speedValue = tonumber(args[1])
                if not speedValue then
                    warn("[WalkSpeed] Masukkan angka kecepatan yang valid! Contoh: ws 50")
                    return
                end

                -- Simpan nilai target speed
                _G.CustomWalkSpeed = speedValue
                _G.ActiveWalkSpeedLoop = true

                -- Hentikan loop lama jika sempat menyala
                if _G.WSConnection then
                    _G.WSConnection:Disconnect()
                    _G.WSConnection = nil
                end

                -- Jalankan loop menggunakan Heartbeat agar terus memaksa nilai speed setiap frame/detik
                local RunService = game:GetService("RunService")
                _G.WSConnection = RunService.Heartbeat:Connect(function()
                    if not _G.ActiveWalkSpeedLoop then return end
                    
                    local char = speaker.Character
                    if char then
                        local hum = char:FindFirstChildOfClass("Humanoid")
                        if hum and hum.WalkSpeed ~= _G.CustomWalkSpeed then
                            hum.WalkSpeed = _G.CustomWalkSpeed
                        end
                    end
                end)
            end
        },
        ["unws"] = {
            ["ListName"] = "unws",
            ["Description"] = "Mematikan pengunci WalkSpeed dan mengembalikan ke default (16).",
            ["Aliases"] = {"unwalkspeed", "resetws"},
            ["Function"] = function(args, speaker)
                _G.ActiveWalkSpeedLoop = false
                _G.CustomWalkSpeed = nil

                if _G.WSConnection then
                    _G.WSConnection:Disconnect()
                    _G.WSConnection = nil
                end

                -- Kembalikan ke default (16)
                local char = speaker.Character
                if char then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if hum then
                        hum.WalkSpeed = 16
                    end
                end
            end
        }
    }
}

return plugin
