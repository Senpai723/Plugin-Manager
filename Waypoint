--==================================================
-- FILE SYSTEM PERSISTENCE (MASTER JSON + AUTO-MIGRATE)
--==================================================
local function loadSavedCheckpoints()
    savedCheckpointsList = {}
    visitedKeys = {}

    if writefile and readfile and isfile and listfiles then
        pcall(function()
            local masterData = {}
            if isfile(MASTER_FILE_NAME) then
                local content = readfile(MASTER_FILE_NAME)
                local decoded = HttpService:JSONDecode(content)
                if type(decoded) == "table" then masterData = decoded end
            end

            -- Migrasi otomatis file JSON lama yang berserakan
            local files = listfiles("")
            for _, filePath in ipairs(files) do
                if string.match(filePath, "TeleportCP_.+_Saves%.json$") and not string.match(filePath, "Master") then
                    local oldContent = readfile(filePath)
                    local oldData = HttpService:JSONDecode(oldContent)
                    if type(oldData) == "table" and #oldData > 0 then
                        local extractedMap = string.match(filePath, "TeleportCP_(.+)%_Saves%.json$")
                        if extractedMap then
                            masterData[extractedMap] = oldData
                        end
                    end
                    pcall(function() delfile(filePath) end)
                end
            end

            writefile(MASTER_FILE_NAME, HttpService:JSONEncode(masterData))

            if masterData[CURRENT_MAP_KEY] then
                savedCheckpointsList = masterData[CURRENT_MAP_KEY]
                for _, item in ipairs(savedCheckpointsList) do
                    if item.desc then 
                        local uniqueVisitKey = tostring(item.key) .. "_" .. tostring(item.desc)
                        visitedKeys[uniqueVisitKey] = true 
                    end
                end
            end
        end)
    end
end

local function saveCheckpointsToFile()
    if writefile and readfile then
        pcall(function()
            local masterData = {}
            if isfile(MASTER_FILE_NAME) then
                local content = readfile(MASTER_FILE_NAME)
                local decoded = HttpService:JSONDecode(content)
                if type(decoded) == "table" then
                    masterData = decoded
                end
            end

            masterData[CURRENT_MAP_KEY] = savedCheckpointsList
            writefile(MASTER_FILE_NAME, HttpService:JSONEncode(masterData))
        end)
    end
end

loadSavedCheckpoints()

