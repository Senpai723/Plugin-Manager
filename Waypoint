local function getHRP()
    local char = LocalPlayer.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function safeTeleport(targetCF)
    local hrp = getHRP()
    if not hrp then return end
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
    hrp.CFrame = targetCF + Vector3.new(0, HEIGHT_OFFSET, 0)
end

local function isBlacklisted(name)
    local lower = string.lower(name)
    for _, kw in ipairs(IGNORE_KEYWORDS) do
        if string.find(lower, kw, 1, true) then return true end
    end
    return false
end

local function getInstancePath(obj)
    local path = obj.Name
    local current = obj.Parent
    local depth = 0
    while current and current ~= Workspace and depth < 5 do
        path = current.Name .. "." .. path
        current = current.Parent
        depth = depth + 1
    end
    return path
end

local function getValidCheckpointPart(obj)
    if not obj or not (obj:IsA("BasePart") or obj:IsA("MeshPart") or obj:IsA("UnionOperation") or obj:IsA("Model")) then return nil end
    if isBlacklisted(obj.Name) then return nil end

    -- Cek 1: Memiliki TouchInterest langsung
    local hasTouch = obj:FindFirstChild("TouchInterest") or obj:FindFirstChildOfClass("TouchTransmitter")
    if hasTouch then return obj end

    -- Cek 2: Memiliki ProximityPrompt langsung
    local hasPrompt = obj:FindFirstChildOfClass("ProximityPrompt") or obj:FindFirstChildWhichIsA("ProximityPrompt", true)
    if hasPrompt then
        if obj:IsA("Model") then
            return obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true) or obj
        end
        return obj
    end

    -- Cek 3: Cek anak-anak objek (Hanya terima jika ada TouchInterest atau ProximityPrompt)
    for _, desc in ipairs(obj:GetDescendants()) do
        if (desc:IsA("BasePart") or desc:IsA("MeshPart") or desc:IsA("UnionOperation")) and not isBlacklisted(desc.Name) then
            if desc:FindFirstChild("TouchInterest") or desc:FindFirstChildOfClass("TouchTransmitter") or desc:FindFirstChildOfClass("ProximityPrompt") then
                return desc
            end
        end
    end

    -- DIBUANG: Fallback BillboardGui/SurfaceGui tanpa Touch/Prompt ditiadakan agar papan dekorasi palsu tidak ter-scan!
    return nil
end


local function parseCPIdentity(obj)
    local validPart = getValidCheckpointPart(obj)
    if not validPart then return nil, nil, nil end

    local name = obj.Name
    local lowerName = string.lower(name)
    local parentName = obj.Parent and obj.Parent.Name or ""
    local lowerParent = string.lower(parentName)

    -- Filter awal
    if lowerName == "text" or lowerParent == "text" or isBlacklisted(lowerName) or isBlacklisted(lowerParent) then return nil, nil, nil end
    if string.find(lowerName, "teleport", 1, true) or string.find(lowerName, "tp", 1, true) or string.find(lowerName, "tele", 1, true) then return nil, nil, nil end

    -- ==================================================
    -- 1. DETEKSI SUMMIT STRICT (SUPER STERIL)
    -- ==================================================
    local summitKeywords = {"summit", "peak", "finish", "puncak", "winpad"}
    local summitBlacklist = {
        "board", "papan", "donat", "donation", "detik", "time", "sec", "sign", 
        "leaderboard", "stat", "total", "name", "top global", "global", "top", 
        "finishmodel", "model", "gui"
    }
    
    local function isSummitBlacklisted(str)
        local lowerStr = string.lower(str)
        for _, bkw in ipairs(summitBlacklist) do
            if string.find(lowerStr, bkw, 1, true) then return true end
        end
        return false
    end

    local isSummit = false
    local summitName = name

    -- Cek dari Nama Objek atau Parent
    if not isSummitBlacklisted(lowerName) and not isSummitBlacklisted(lowerParent) then
        for _, kw in ipairs(summitKeywords) do
            if string.find(lowerName, kw, 1, true) or string.find(lowerParent, kw, 1, true) then
                isSummit = true
                break
            end
        end
    end

    -- Cek dari BillboardGui / SurfaceGui jika belum ketemu
    if not isSummit then
        local hasGui = validPart:FindFirstChildOfClass("BillboardGui") or validPart:FindFirstChildOfClass("SurfaceGui")
        if not hasGui and validPart.Parent and validPart.Parent:IsA("Model") then
            hasGui = validPart.Parent:FindFirstChildOfClass("BillboardGui") or validPart.Parent:FindFirstChildOfClass("SurfaceGui")
        end

        if hasGui then
            local textLabel = hasGui:FindFirstChildOfClass("TextLabel")
            if textLabel and textLabel.Text ~= "" then
                local lowerTxt = string.lower(textLabel.Text)
                if not isSummitBlacklisted(lowerTxt) then
                    for _, kw in ipairs(summitKeywords) do
                        if string.find(lowerTxt, kw, 1, true) then
                            isSummit = true
                            summitName = textLabel.Text
                            break
                        end
                    end
                end
            end
        end
    end

    if isSummit then
        return "SUMMIT", summitName, validPart
    end

    -- ==================================================
    -- 2. DOKTRIN STRICT: CEK ATAU KATA KUNCI CHECKPOINT WAJIB ADA
    -- ==================================================
    local combined = lowerParent .. " " .. lowerName
    local hasCPKeyword = string.find(combined, "checkpoint") or 
                         string.find(combined, "cekpoin") or 
                         string.find(combined, "cp") or 
                         string.find(combined, "waypoint") or 
                         string.find(combined, "wp") or 
                         string.find(combined, "stage") or 
                         string.find(combined, "pos")

    -- Ambil teks dari BillboardGui jika ada
    local guiText = ""
    local hasGui = validPart:FindFirstChildOfClass("BillboardGui") or validPart:FindFirstChildOfClass("SurfaceGui")
    if not hasGui and validPart.Parent and validPart.Parent:IsA("Model") then
        hasGui = validPart.Parent:FindFirstChildOfClass("BillboardGui") or validPart.Parent:FindFirstChildOfClass("SurfaceGui")
    end

    if hasGui then
        local textLabel = hasGui:FindFirstChildOfClass("TextLabel")
        if textLabel and textLabel.Text ~= "" then
            guiText = string.lower(textLabel.Text)
            if string.find(guiText, "checkpoint") or string.find(guiText, "cekpoin") or string.find(guiText, "cp") or string.find(guiText, "waypoint") or string.find(guiText, "wp") or string.find(guiText, "stage") or string.find(guiText, "pos") then
                hasCPKeyword = true
            end
        end
    end

    -- JIKA TIDAK MEMILIKI KATA KUNCI CHECKPOINT SAH = BUANG / TOLAK MUTLAK!
    if not hasCPKeyword then
        return nil, nil, nil
    end

    -- 3. PARSING NOMOR CHECKPOINT (Hanya jika lolos verifikasi Kata Kunci di atas)
    local num = string.match(combined, "checkpoints?%s*(%d+)") or
                string.match(combined, "checkpoint%s*(%d+)") or
                string.match(combined, "cekpoin%s*[%s_]*(%d+)") or 
                string.match(combined, "cekpoin%s*(%d+)") or  
                string.match(combined, "cp%s*(%d+)") or
                string.match(combined, "cp(%d+)") or 
                string.match(combined, "stage%s*(%d+)") or
                string.match(combined, "pos%s*(%d+)") or
                string.match(combined, "waypoint%s*(%d+)") or
                string.match(combined, "wp%s*(%d+)")

    if not num and guiText ~= "" then
        num = string.match(guiText, "(%d+)")
    end

    if not num then
        num = string.match(lowerName, "(%d+)")
    end

    if num then
        local nVal = tonumber(num)
        if nVal and nVal >= 0 and nVal <= 500 then
            return nVal, (guiText ~= "" and guiText or name), validPart
        end
    end

    -- Fallback Label String jika valid CP tanpa angka
    return "CP", name, validPart
end

--==================================================
-- AUTO-SAVE SYSTEM & VISITED TRACKER
--==================================================
local function addOrUpdateSavedCP(key, desc, cf)
    local serializedCF = {cf:GetComponents()}
    
    local uniqueVisitKey = tostring(key) .. "_" .. tostring(desc)
    visitedKeys[uniqueVisitKey] = true

    for _, item in ipairs(savedCheckpointsList) do
        if tostring(item.key) == tostring(key) and tostring(item.desc) == tostring(desc) then
            item.cf = serializedCF
            saveCheckpointsToFile()
            if updateCpnGuiContent then updateCpnGuiContent() end
            if updateRadarGuiContent then updateRadarGuiContent() end
            return
        end
    end

    table.insert(savedCheckpointsList, {
        key = key,
        desc = desc,
        cf = serializedCF
    })
    
    table.sort(savedCheckpointsList, function(a, b)
        local na, nb = tonumber(a.key), tonumber(b.key)
        if na and nb then return na < nb end
        return tostring(a.key) < tostring(b.key)
    end)

    saveCheckpointsToFile()
    if updateCpnGuiContent then updateCpnGuiContent() end
    if updateRadarGuiContent then updateRadarGuiContent() end
    notify("Auto-Save CP", "Checkpoint tersimpan: " .. tostring(key) .. " (" .. tostring(desc) .. ")", 2)
end

--==================================================
-- PERBAIKAN 3: PURE EVENT-DRIVEN & ANTI-STUTTER (NO BACKGROUND LOOP)
--==================================================
local hookedParts = {}

local function processAndHookPart(obj)
    if not obj or not (obj:IsA("BasePart") or obj:IsA("MeshPart") or obj:IsA("UnionOperation") or obj:IsA("Model")) then return end
    if hookedParts[obj] then return end

    local cpKey, partDesc, realPart = parseCPIdentity(obj)
    
    if cpKey and realPart and not hookedParts[realPart] then
        hookedParts[realPart] = true
        
        local targetCFrame = realPart:IsA("Model") and (realPart.PrimaryPart and realPart.PrimaryPart.CFrame or realPart:GetAttribute("CFrame") or realPart:GetPivot()) or realPart.CFrame

        local uniqueKey = getInstancePath(realPart)
        streamingCache[uniqueKey] = {
            key = cpKey,
            desc = partDesc,
            part = realPart,
            cf = targetCFrame
        }

        if updateRadarGuiContent then updateRadarGuiContent() end

        local function triggerAutoSave()
            local uniqueVisitKey = tostring(cpKey) .. "_" .. tostring(partDesc)
            if not visitedKeys[uniqueVisitKey] then
                addOrUpdateSavedCP(cpKey, partDesc, targetCFrame)
                
                -- LOGIKA SUMMIT DENGAN FILTER JARAK (DISTANCE CHECK)
                if cpKey == "SUMMIT" or string.find(string.lower(tostring(partDesc)), "summit") then
                    for cacheKey, cacheData in pairs(streamingCache) do
                        if cacheData.key == "SUMMIT" or string.find(string.lower(tostring(cacheData.desc)), "summit") then
                            if cacheData.part and cacheData.part.Parent and realPart and realPart.Parent then
                                local dist = (cacheData.part.Position - realPart.Position).Magnitude
                                if dist <= 25 then
                                    local summitVisitKey = tostring(cacheData.key) .. "_" .. tostring(cacheData.desc)
                                    visitedKeys[summitVisitKey] = true
                                end
                            end
                        end
                    end
                    if updateRadarGuiContent then updateRadarGuiContent() end
                else
                    -- LOGIKA CP BIASA: Hilangkan duplikat key yang sama jika jaraknya dekat/satu tempat
                    for cacheKey, cacheData in pairs(streamingCache) do
                        if tostring(cacheData.key) == tostring(cpKey) then
                            if cacheData.part and cacheData.part.Parent and realPart and realPart.Parent then
                                local dist = (cacheData.part.Position - realPart.Position).Magnitude
                                if dist <= 25 then
                                    local sameVisitKey = tostring(cacheData.key) .. "_" .. tostring(cacheData.desc)
                                    visitedKeys[sameVisitKey] = true
                                end
                            end
                        end
                    end
                    if updateRadarGuiContent then updateRadarGuiContent() end
                end
            end
        end

        local touch = realPart:FindFirstChild("TouchInterest") or realPart:FindFirstChildOfClass("TouchTransmitter")
        if touch then
            realPart.Touched:Connect(function(hit)
                local char = LocalPlayer.Character
                if char and hit:IsDescendantOf(char) then
                    -- Pastikan bagian HumanoidRootPart atau tubuh player yang menyentuh
                    local humanoid = char:FindFirstChildOfClass("Humanoid")
                    if humanoid and humanoid.Health > 0 then
                        triggerAutoSave()
                    end
                end
            end)
        end

        local prompt = realPart:FindFirstChildOfClass("ProximityPrompt") or realPart:FindFirstChildWhichIsA("ProximityPrompt", true)
        if prompt then
            prompt.Triggered:Connect(function(playerWhoTriggered)
                if playerWhoTriggered == LocalPlayer then
                    triggerAutoSave()
                end
            end)
        end
    end
end

