-- 1. Scan Instan untuk Objek Baru yang Dimuat (Anti-Stutter & Anti-Lag)
Workspace.DescendantAdded:Connect(function(obj)
    task.delay(0.2, function()
        pcall(function()
            processAndHookPart(obj)
        end)
    end)
end)

-- 2. Smooth Background Batching Scanner (Mencegah Lag Setiap Detik)
task.spawn(function()
    while true do
        task.wait(5.0) -- Interval diperlonggar jadi 5 detik
        pcall(function()
            local allDescendants = Workspace:GetDescendants()
            for i, obj in ipairs(allDescendants) do
                processAndHookPart(obj)
                -- Tiap 50 objek, beri jeda 1 frame agar CPU tidak stutter/lag!
                if i % 50 == 0 then
                    task.wait()
                end
            end
        end)
    end
end)


return gotonext
