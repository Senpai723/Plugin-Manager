        local nearestName, nearestKey = nil, nil
        local nearestCF = nil
        local pos = hrp.Position
        
        for _, data in pairs(streamingCache) do
            if data.part and data.part.Parent then
                local dist = (data.part.Position - pos).Magnitude
                if dist <= 12 then
                    if data.key ~= nil and data.desc ~= nil then
                        nearestName = data.desc
                        nearestKey = data.key
                        nearestCF = data.part.CFrame
                        break
                    end
                end
            end
        end

        if not nearestName or nearestKey == nil then
            showCustomNamePrompt(function(customText)
                addOrUpdateSavedCP("", customText, hrp.CFrame)
            end)
        else
            addOrUpdateSavedCP(nearestKey, nearestName, nearestCF)
        end
    end)

