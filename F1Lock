local Plugin = {
	["PluginName"] = "F1 Lock & Uncam Mobile",
	["PluginDescription"] = "Bind Shift Lock to F1 and force unlock camera for mobile/FPP maps",
	["Commands"] = {
		["f1lock"] = {
			["ListName"] = "f1lock",
			["Description"] = "Bind Shift Lock to F1 Key with Force Enable Support",
			["Aliases"] = {"f1lock"},
			["Function"] = function(args, speaker)
				local Players = game:GetService("Players")
				local StarterGui = game:GetService("StarterGui")
				local player = Players.LocalPlayer
				
				-- Memaksa mengaktifkan opsi Shift Lock jika dimatikan oleh map
				pcall(function()
					StarterGui:SetCore("EnableMouseLockOption", true)
				end)
				
				local playerScripts = player:WaitForChild("PlayerScripts", 5)
				if not playerScripts then return end
				
				local cameraModule = playerScripts:FindFirstChild("PlayerModule") 
					and playerScripts.PlayerModule:FindFirstChild("CameraModule")
				
				if cameraModule then
					local mouseLockController = cameraModule:FindFirstChild("MouseLockController")
					if mouseLockController then
						local boundKeys = mouseLockController:FindFirstChild("BoundKeys")
						if boundKeys then
							boundKeys.Value = "F1"
						else
							boundKeys = Instance.new("StringValue")
							boundKeys.Name = "BoundKeys"
							boundKeys.Value = "F1"
							boundKeys.Parent = mouseLockController
						end
						print("F1 Lock berhasil diaktifkan!")
					end
				end
			end,
		},
		["unlockedcam"] = {
			["ListName"] = "unlockedcam / uncam",
			["Description"] = "Force camera back to Custom mode and unlock movement",
			["Aliases"] = {"uncam"},
			["Function"] = function(args, speaker)
				local Players = game:GetService("Players")
				local RunService = game:GetService("RunService")
				local player = Players.LocalPlayer
				
				-- Paksa ubah CameraMode player ke Classic
				player.CameraMode = Enum.CameraMode.Classic
				
				-- Melawan script map yang mengunci kamera secara terus-menerus
				local connection
				connection = RunService.RenderStepped:Connect(function()
					local cam = workspace.CurrentCamera
					if cam then
						if cam.CameraType ~= Enum.CameraType.Custom then
							cam.CameraType = Enum.CameraType.Custom
						end
					end
				end)
				
				-- Berjalan selama 15 detik untuk memutus cengkeraman script map
				task.delay(15, function()
					if connection then
						connection:Disconnect()
					end
				end)
				
				print("Kamera berhasil dipaksa unlock!")
			end,
		},
	},
}
return Plugin
