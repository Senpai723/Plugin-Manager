local Plugin = {
    ["PluginName"] = "instantprompts",
    ["PluginDescription"] = "Always instant ProximityPrompt with smart cleaning hold",
    ["Commands"] = {}
}

local Enabled = false
local Connections = {}
local KnownPrompts = {}
local VisiblePrompts = {}
local State = setmetatable({}, {__mode = "k"})

local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local PPS = game:GetService("ProximityPromptService")

local RETRY_GAP = 0.10
local SESSION_COOLDOWN = 0.15
local BUSY_TIMEOUT = 0.70

local CLEAN_HOLD_FALLBACK = 3.00
local CLEAN_COMPLETE_BUFFER = 0.20

local function isPrompt(obj)
    return obj ~= nil and obj:IsA("ProximityPrompt")
end

local function isValid(prompt)
    return isPrompt(prompt) and prompt.Parent ~= nil and prompt.Enabled
end

local function getState(prompt)
    if not isPrompt(prompt) then
        return nil
    end

    local state = State[prompt]
    if state == nil then
        state = {
            busy = false,
            busyUntil = 0,
            lastAttempt = 0,
            holding = false
        }
        State[prompt] = state
    end

    return state
end

local function remember(prompt)
    if isPrompt(prompt) then
        KnownPrompts[prompt] = true
        getState(prompt)
    end
end

local function getRoot()
    local player = Players.LocalPlayer
    if player == nil then
        return nil
    end

    local character = player.Character
    if character == nil then
        return nil
    end

    return character:FindFirstChild("HumanoidRootPart")
        or character:FindFirstChild("UpperTorso")
        or character:FindFirstChild("Torso")
end

local function getPromptPosition(prompt)
    if not isPrompt(prompt) or prompt.Parent == nil then
        return nil
    end

    local parent = prompt.Parent

    if parent:IsA("Attachment") then
        return parent.WorldPosition
    end

    if parent:IsA("BasePart") then
        return parent.Position
    end

    if parent:IsA("Model") then
        if parent.PrimaryPart then
            return parent.PrimaryPart.Position
        end

        local part = parent:FindFirstChildWhichIsA("BasePart", true)
        if part then
            return part.Position
        end
    end

    local current = parent
    while current and current ~= workspace do
        if current:IsA("BasePart") then
            return current.Position
        end

        if current:IsA("Model") then
            if current.PrimaryPart then
                return current.PrimaryPart.Position
            end

            local part = current:FindFirstChildWhichIsA("BasePart", true)
            if part then
                return part.Position
            end
        end

        current = current.Parent
    end

    return nil
end

local function getDistance(prompt, root)
    local position = getPromptPosition(prompt)
    if position == nil then
        return math.huge
    end

    return (root.Position - position).Magnitude
end

local function closestFrom(list)
    local root = getRoot()
    if root == nil then
        return nil
    end

    local best = nil
    local bestDistance = math.huge

    for prompt in pairs(list) do
        if isValid(prompt) then
            local maxDistance = tonumber(prompt.MaxActivationDistance) or 0
            local distance = getDistance(prompt, root)

            if distance <= maxDistance and distance < bestDistance then
                best = prompt
                bestDistance = distance
            end
        else
            list[prompt] = nil
            VisiblePrompts[prompt] = nil
        end
    end

    return best
end

local function findNearestPrompt()
    return closestFrom(VisiblePrompts)
        or closestFrom(KnownPrompts)
end

local function canStart(prompt)
    local state = getState(prompt)
    if state == nil then
        return false
    end

    local now = os.clock()

    if state.busy then
        if now < state.busyUntil then
            return false
        end
        state.busy = false
    end

    if now - state.lastAttempt < SESSION_COOLDOWN then
        return false
    end

    state.busy = true
    state.busyUntil = now + BUSY_TIMEOUT
    state.lastAttempt = now

    return true
end

local function finish(prompt)
    local state = getState(prompt)
    if state then
        state.busy = false
        state.busyUntil = 0
    end
end

local function firePrompt(prompt, holdTime, hidden)
    if not isValid(prompt) then
        return false
    end

    local fire = fireproximityprompt
    if type(fire) ~= "function" then
        return false
    end

    local ok

    if hidden then
        ok = pcall(fire, prompt, holdTime, true)
    elseif holdTime ~= nil then
        ok = pcall(fire, prompt, holdTime)
    else
        ok = pcall(fire, prompt)
    end

    return ok
end

local function isCleaningPrompt(prompt)
    if not isPrompt(prompt) then
        return false
    end

    local action = string.lower(tostring(prompt.ActionText or ""))
    local object = string.lower(tostring(prompt.ObjectText or ""))
    local text = action .. " " .. object

    local isToolAction = string.find(text, "ambil", 1, true) ~= nil
        or string.find(text, "taruh", 1, true) ~= nil
        or string.find(text, "kembalikan", 1, true) ~= nil
        or string.find(text, "take", 1, true) ~= nil
        or string.find(text, "put", 1, true) ~= nil
        or string.find(text, "return", 1, true) ~= nil
        or string.find(text, "drop", 1, true) ~= nil

    if isToolAction then
        return false
    end

    return string.find(text, "sapu", 1, true) ~= nil
        or string.find(text, "pel", 1, true) ~= nil
        or string.find(text, "bersih", 1, true) ~= nil
        or string.find(text, "clean", 1, true) ~= nil
        or string.find(text, "mop", 1, true) ~= nil
        or string.find(text, "broom", 1, true) ~= nil
        or string.find(text, "sweep", 1, true) ~= nil
end

-- FUNGSI AUTO-HOLD PAKSA: 1 klik langsung ditahan skrip sampai penuh tanpa user perlu nahan manual
local function fastCleaningHold(prompt)
    if not Enabled or not isValid(prompt) then
        return false
    end

    local begin = prompt.InputHoldBegin
    local finishHold = prompt.InputHoldEnd
    if type(begin) ~= "function" or type(finishHold) ~= "function" then
        return false
    end

    local state = getState(prompt)
    if state == nil then
        return false
    end

    local now = os.clock()
    if state.holding then
        return false
    end

    state.holding = true

    pcall(function()
        prompt:InputHoldBegin()
    end)

    local duration = tonumber(prompt.HoldDuration)
    if duration == nil or duration <= 0 then
        duration = CLEAN_HOLD_FALLBACK
    end

    task.wait(duration + 0.1)

    if isValid(prompt) then
        pcall(function()
            prompt:InputHoldEnd()
        end)
    end

    state.holding = false
    state.lastAttempt = now
    finish(prompt)
    return true
end

local function instantAttempt(prompt)
    if not Enabled or not isValid(prompt) then
        return false
    end

    if not canStart(prompt) then
        return false
    end

    -- JIKA INI PROMPT BERSIH-BERSIH: Langsung eksekusi auto-hold 3 detik dari skrip (1 klik beres)
    if isCleaningPrompt(prompt) then
        return fastCleaningHold(prompt)
    end

    -- JIKA INI AMBIL/TARUH ALAT: Jalankan instan murni (1 klik langsung ambil)
    local fired = firePrompt(prompt, 0, false)
    if fired then
        task.wait(RETRY_GAP)
        finish(prompt)
        return true
    end

    if isValid(prompt) then
        fired = firePrompt(prompt, 0, true)
        if fired then
            task.wait(RETRY_GAP)
            finish(prompt)
            return true
        end
    end

    if isValid(prompt) then
        fired = firePrompt(prompt, nil, false)
    end

    task.wait(RETRY_GAP)
    finish(prompt)
    return fired
end

local function activateNearest()
    if not Enabled then
        return false
    end

    local prompt = findNearestPrompt()
    if prompt == nil then
        return false
    end

    return instantAttempt(prompt)
end

local function disconnectAll()
    for i = #Connections, 1, -1 do
        local connection = Connections[i]
        if connection then
            pcall(function()
                connection:Disconnect()
            end)
        end
        Connections[i] = nil
    end
end

local function clearTable(list)
    for key in pairs(list) do
        list[key] = nil
    end
end

local function disableInstant()
    Enabled = false
    disconnectAll()
    clearTable(KnownPrompts)
    clearTable(VisiblePrompts)
    clearTable(State)
end

local function enableInstant()
    if Enabled then
        return
    end

    Enabled = true

    table.insert(Connections, PPS.PromptShown:Connect(function(prompt)
        if not Enabled or not isPrompt(prompt) then
            return
        end

        VisiblePrompts[prompt] = true
        remember(prompt)
    end))

    table.insert(Connections, PPS.PromptHidden:Connect(function(prompt)
        if isPrompt(prompt) then
            VisiblePrompts[prompt] = nil
        end
    end))

    table.insert(Connections, PPS.PromptButtonHoldBegan:Connect(function(prompt)
        if not Enabled or not isPrompt(prompt) then
            return
        end

        remember(prompt)

        task.defer(function()
            if not Enabled or not isValid(prompt) then
                return
            end

            instantAttempt(prompt)
        end)
    end))

    table.insert(Connections, UIS.InputBegan:Connect(function(input, processed)
        if not Enabled or processed then
            return
        end

        local key = input.KeyCode
        if key == Enum.KeyCode.E or key == Enum.KeyCode.F or key == Enum.KeyCode.G then
            task.defer(activateNearest)
        end
    end))

    table.insert(Connections, workspace.DescendantAdded:Connect(function(obj)
        if isPrompt(obj) then
            remember(obj)
        end
    end))

    table.insert(Connections, workspace.DescendantRemoving:Connect(function(obj)
        if isPrompt(obj) then
            KnownPrompts[obj] = nil
            VisiblePrompts[obj] = nil
            State[obj] = nil
        end
    end))

    for _, obj in ipairs(workspace:GetDescendants()) do
        if isPrompt(obj) then
            remember(obj)
        end
    end
end

Plugin["Commands"]["instantprompts"] = {
    ["ListName"] = "instantprompts / ipp",
    ["Description"] = "Enable always-instant ProximityPrompt interaction",
    ["Aliases"] = {"ipp"},
    ["Function"] = function(args, speaker)
        enableInstant()
    end
}

Plugin["Commands"]["uninstantprompts"] = {
    ["ListName"] = "uninstantprompts / unipp",
    ["Description"] = "Disable instant ProximityPrompt interaction",
    ["Aliases"] = {"unipp"},
    ["Function"] = function(args, speaker)
        disableInstant()
    end
}

return Plugin
