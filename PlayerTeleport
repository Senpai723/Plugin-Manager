-- Fungsi untuk memperbarui daftar player berdasarkan filter pencarian
local function refreshPlayerList()
    for _, child in ipairs(ScrollingFrame:GetChildren()) do
        if child:IsA("Frame") then
            child:Destroy()
        end
    end

    local searchText = string.lower(SearchBox.Text)

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local playerName = string.lower(player.Name)
            local playerDisplayName = string.lower(player.DisplayName)

            if searchText == "" or string.find(playerName, searchText) or string.find(playerDisplayName, searchText) then
                local PlayerRow = Instance.new("Frame")
                PlayerRow.Name = player.Name
                PlayerRow.Parent = ScrollingFrame
                PlayerRow.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
                PlayerRow.BorderSizePixel = 0
                PlayerRow.Size = UDim2.new(1, 0, 0, 35)

                local RowCorner = Instance.new("UICorner")
                RowCorner.CornerRadius = UDim.new(0, 4)
                RowCorner.Parent = PlayerRow

                local PlayerNameLabel = Instance.new("TextLabel")
                PlayerNameLabel.Name = "PlayerName"
                PlayerNameLabel.Parent = PlayerRow
                PlayerNameLabel.BackgroundTransparency = 1
                PlayerNameLabel.Position = UDim2.new(0, 10, 0, 0)
                PlayerNameLabel.Size = UDim2.new(0.6, 0, 1, 0)
                PlayerNameLabel.Font = Enum.Font.SourceSans
                PlayerNameLabel.Text = player.Name .. " (@" .. player.DisplayName .. ")"
                PlayerNameLabel.TextColor3 = Color3.fromRGB(240, 240, 240)
                PlayerNameLabel.TextSize = 13
                PlayerNameLabel.TextXAlignment = Enum.TextXAlignment.Left
                PlayerNameLabel.TextTruncate = Enum.TextTruncate.AtEnd

                local TPButton = Instance.new("TextButton")
                TPButton.Name = "TPButton"
                TPButton.Parent = PlayerRow
                TPButton.BackgroundColor3 = Color3.fromRGB(0, 160, 90)
                TPButton.BorderSizePixel = 0
                TPButton.Position = UDim2.new(1, -75, 0.5, -11)
                TPButton.Size = UDim2.new(0, 65, 0, 22)
                TPButton.Font = Enum.Font.SourceSansBold
                TPButton.Text = "TELEPORT"
                TPButton.TextColor3 = Color3.fromRGB(255, 255, 255)
                TPButton.TextSize = 11

                local BtnCorner = Instance.new("UICorner")
                BtnCorner.CornerRadius = UDim.new(0, 4)
                BtnCorner.Parent = TPButton

                TPButton.MouseButton1Click:Connect(function()
                    local char = LocalPlayer.Character
                    if char and char:FindFirstChild("HumanoidRootPart") then
                        local targetChar = player.Character
                        if targetChar and targetChar:FindFirstChild("HumanoidRootPart") then
                            char.HumanoidRootPart.CFrame = targetChar.HumanoidRootPart.CFrame + Vector3.new(0, 3, 0)
                        end
                    end
                end)
            end
        end
    end
    
    ScrollingFrame.CanvasSize = UDim2.new(0, 0, 0, UIListLayout.AbsoluteContentSize.Y + 10)
end

SearchBox:GetPropertyChangedSignal("Text"):Connect(refreshPlayerList)

Players.PlayerAdded:Connect(refreshPlayerList)
Players.PlayerRemoving:Connect(refreshPlayerList)

function ToggleTeleportWindow()
    ScreenGui.Enabled = not ScreenGui.Enabled
    if ScreenGui.Enabled then
        SearchBox.Text = ""
        isMinimized = false
        MainFrame.Size = UDim2.new(0, 300, 0, 290)
        SearchBox.Visible = true
        ScrollingFrame.Visible = true
        refreshPlayerList()
    end
end

return Plugin
