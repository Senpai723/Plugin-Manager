local function startColorESP(args, speaker, mode)
    local espMode = mode or "all"

    if espMode ~= "player"
        and espMode ~= "enemy"
        and espMode ~= "all"
    then
        espMode = "all"
    end

    local playerMode = espMode == "player" or espMode == "all"
    local enemyMode = espMode == "enemy" or espMode == "all"


    print("Loading ColorESP v3.0 (Original Clean & Infinite Range)...")


    ------------------------------------------------------------
    -- SERVICES
    ------------------------------------------------------------

    local Players = game:GetService("Players")
    local Workspace = game:GetService("Workspace")
    local Lighting = game:GetService("Lighting")
    local RunService = game:GetService("RunService")
    local CollectionService = game:GetService("CollectionService")
    local UserInputService = game:GetService("UserInputService")

    local LocalPlayer = Players.LocalPlayer

    if not LocalPlayer then
        warn("No LocalPlayer found.")
        return
    end


    ------------------------------------------------------------
    -- SETTINGS
    ------------------------------------------------------------

    local SCRIPT_TAG = "COLOR_ESP_PLUGIN_RUNNING_" .. tostring(espMode)
    local ESP_MODE_ATTRIBUTE = "COLOR_ESP_MODE"
    local HIGHLIGHT_TAG = "COLOR_ESP_HL"
    local NAME_TAG = "COLOR_ESP_NAME"


    ------------------------------------------------------------
    -- COLORS (SEMUA PLAYER HIJAU)
    ------------------------------------------------------------

    local PLAYER_COLOR = Color3.fromRGB(0, 255, 0)      -- Hijau (Player Biasa)
    local NPC_COLOR = Color3.fromRGB(255, 170, 0)        -- Oranye (NPC Candidate)
    local ENEMY_COLOR = Color3.fromRGB(255, 0, 0)        -- Merah (Confirmed Enemy)


    ------------------------------------------------------------
    -- ESP SETTINGS
    ------------------------------------------------------------

    local ENEMY_RENDER_DISTANCE = 180
    local ENEMY_RENDER_DISTANCE_SQUARED = ENEMY_RENDER_DISTANCE * ENEMY_RENDER_DISTANCE
    local ENEMY_RENDER_UPDATE = 0.50
    local MAX_ACTIVE_ENEMY_HIGHLIGHTS = 12
    local USE_MOBILE_FRIENDLY_DEPTHMODE = true
    local SHOW_NAMES = true
    local NAME_SIZE = 14


    ------------------------------------------------------------
    -- DAMAGE & THREAT DETECTION
    ------------------------------------------------------------

    local DAMAGE_SEARCH_RADIUS = 100
    local THREAT_SEARCH_RADIUS = 150
    local THREAT_COOLDOWN = 1.5
    local lastThreatTime = 0


    ------------------------------------------------------------
    -- SCANNER & AGGRESSIVE MODE
    ------------------------------------------------------------

    local aggressiveDetection = false
    if args and args[1] ~= nil then
        local value = tostring(args[1]):lower()
        if value == "true" then
            aggressiveDetection = true
        elseif value == "false" then
            aggressiveDetection = false
        end
    end


    ------------------------------------------------------------
    -- STOP PREVIOUS INSTANCE
    ------------------------------------------------------------

    local old = LocalPlayer:FindFirstChild(SCRIPT_TAG)
    if old and old:IsA("BindableEvent") then
        pcall(function() old:Fire() end)

        local stopDeadline = os.clock() + 2.5
        while old.Parent and os.clock() < stopDeadline do
            task.wait(0.05)
        end

        if old.Parent then
            pcall(function() old:Destroy() end)
            task.wait(0.05)
        end
    end


    ------------------------------------------------------------
    -- CONTROL & MAID
    ------------------------------------------------------------

    local control = Instance.new("BindableEvent")
    control.Name = SCRIPT_TAG
    control.Parent = LocalPlayer

    local maid = {}
    local running = true

    local function giveTask(object)
        maid[#maid + 1] = object
        return object
    end

    local function cleanup()
        for i = #maid, 1, -1 do
            local object = maid[i]
            maid[i] = nil
            local objectType = typeof(object)

            if objectType == "RBXScriptConnection" then
                pcall(function() object:Disconnect() end)
            elseif objectType == "Instance" then
                pcall(function() object:Destroy() end)
            elseif objectType == "function" then
                pcall(object)
            end
        end
    end


    ------------------------------------------------------------
    -- CONFIRMED ENEMY CACHE
    ------------------------------------------------------------

    local confirmedEnemies = {}


    ------------------------------------------------------------
    -- CACHES
    ------------------------------------------------------------

    local playerCharacters = {}
    local characterPlayers = {}
    local entityCache = {}
    local playerESPParts = {}
    local playerESPConnections = {}
    local pendingModels = {}
    local rootPartCache = {}


    ------------------------------------------------------------
    -- MODEL FINDER & PLAYER FINDER
    ------------------------------------------------------------

    local function getModelFromInstance(instance)
        if not instance then return nil end
        if instance:IsA("Model") then return instance end
        return instance:FindFirstAncestorOfClass("Model")
    end

    local function registerPlayerCharacter(player, character)
        if not player or not character then return end

        local previous = playerCharacters[player]
        if previous and characterPlayers[previous] == player then
            characterPlayers[previous] = nil
        end

        playerCharacters[player] = character
        characterPlayers[character] = player
    end

    local function getPlayerFromCharacter(model)
        if not model then return nil end

        local cached = characterPlayers[model]
        if cached then return cached end

        local player = Players:GetPlayerFromCharacter(model)
        if player then
            registerPlayerCharacter(player, model)
            return player
        end

        return nil
    end

    local function isLocalCharacter(model)
        return LocalPlayer.Character and LocalPlayer.Character == model
    end


    ------------------------------------------------------------
    -- ROOT PART
    ------------------------------------------------------------

    local function getRootPart(model)
        if not model then return nil end

        local cached = rootPartCache[model]
        if cached and cached.Parent and cached:IsDescendantOf(model) and cached:IsA("BasePart") then
            return cached
        end

        local names = {
            "HumanoidRootPart", "RootPart", "Root", "PrimaryPart",
            "UpperTorso", "Torso", "Body", "Head"
        }

        for _, name in ipairs(names) do
            local object = model:FindFirstChild(name, true)
            if object and object:IsA("BasePart") then
                rootPartCache[model] = object
                return object
            end
        end

        if model.PrimaryPart then
            rootPartCache[model] = model.PrimaryPart
            return model.PrimaryPart
        end

        rootPartCache[model] = nil
        return nil
    end


    ------------------------------------------------------------
    -- ENEMY / NPC DETECTION LOGIC
    ------------------------------------------------------------

    local hasExplicitEnemyMarker

    local function isPotentialEntity(model)
        if not model or not model:IsA("Model") then return false end
        if getPlayerFromCharacter(model) then return false end

        local humanoid = model:FindFirstChildOfClass("Humanoid")
        if humanoid then return getRootPart(model) ~= nil end

        local animatorController = model:FindFirstChildOfClass("AnimationController")
        if animatorController then return getRootPart(model) ~= nil end

        if hasExplicitEnemyMarker(model) then return getRootPart(model) ~= nil end

        return false
    end

    hasExplicitEnemyMarker = function(model)
        if not model then return false end

        local markerNames = {
            "Enemy", "IsEnemy", "Hostile", "IsHostile",
            "IsMonster", "Monster", "IsNPCEnemy", "NPCEnemy"
        }

        for _, name in ipairs(markerNames) do
            local value = model:GetAttribute(name)
            if value == true then return true end
            if typeof(value) == "number" and value > 0 then return true end
            if typeof(value) == "string" then
                local text = string.lower(value)
                if text == "enemy" or text == "hostile" or text == "monster" or text == "true" then
                    return true
                end
            end
        end

        for _, name in ipairs(markerNames) do
            local object = model:FindFirstChild(name, true)
            if object then
                if object:IsA("BoolValue") and object.Value == true then return true end
                if object:IsA("NumberValue") and object.Value > 0 then return true end
                if object:IsA("StringValue") then
                    local text = string.lower(tostring(object.Value))
                    if text == "enemy" or text == "hostile" or text == "monster" or text == "true" then
                        return true
                    end
                end
            end
        end

        local tags = { "Enemy", "Hostile", "Monster" }
        for _, tag in ipairs(tags) do
            if CollectionService:HasTag(model, tag) then return true end
        end

        return false
    end


    ------------------------------------------------------------
    -- DISPLAY NAME & GENERAL REMOVE ESP
    ------------------------------------------------------------

    local function getDisplayName(model)
        local player = getPlayerFromCharacter(model)
        if player then return player.DisplayName end
        return model.Name
    end

    local function removeESP(model)
        if not model then return end

        local highlight = model:FindFirstChild(HIGHLIGHT_TAG)
            or model:FindFirstChild("COLOR_ESP_PLAYER_HL")

        if highlight and highlight:IsA("Highlight") and highlight:GetAttribute(ESP_MODE_ATTRIBUTE) == espMode then
            pcall(function() highlight:Destroy() end)
        end

        local billboard = model:FindFirstChild(NAME_TAG)
        if billboard and billboard:GetAttribute(ESP_MODE_ATTRIBUTE) == espMode then
            pcall(function() billboard:Destroy() end)
        end

        if playerESPConnections[model] then
            pcall(function() playerESPConnections[model]:Disconnect() end)
            playerESPConnections[model] = nil
        end

        playerESPParts[model] = nil
    end


    ------------------------------------------------------------
    -- ENEMY ESP VISIBILITY & HIGHLIGHTS
    ------------------------------------------------------------

    local enemyRenderVisibility = {}
    local enemyRenderTimer = 0

    local function isEnemyWithinRenderDistance(model)
        if not model or not model.Parent then return false end

        local character = LocalPlayer.Character
        local localRoot = character and getRootPart(character)
        local enemyRoot = getRootPart(model)

        if not localRoot or not enemyRoot then return false end

        local offset = enemyRoot.Position - localRoot.Position
        return offset:Dot(offset) <= ENEMY_RENDER_DISTANCE_SQUARED
    end

    local function updateEnemyRenderVisibility()
        if not enemyMode or not running then return end

        local character = LocalPlayer.Character
        local localRoot = character and getRootPart(character)
        if not localRoot then return end

        local candidates = {}
        local origin = localRoot.Position

        for model in pairs(entityCache) do
            if model and model.Parent and not getPlayerFromCharacter(model) then
                local root = getRootPart(model)
                if root then
                    local offset = root.Position - origin
                    local distanceSquared = offset:Dot(offset)
                    if distanceSquared <= ENEMY_RENDER_DISTANCE_SQUARED then
                        candidates[#candidates + 1] = {
                            model = model,
                            distanceSquared = distanceSquared,
                            isConfirmed = confirmedEnemies[model] == true
                        }
                    end
                end
            end
        end

        table.sort(candidates, function(a, b)
            if a.isConfirmed ~= b.isConfirmed then
                return a.isConfirmed
            end
            return a.distanceSquared < b.distanceSquared
        end)

        local active = {}
        for i = 1, math.min(#candidates, MAX_ACTIVE_ENEMY_HIGHLIGHTS) do
            active[candidates[i].model] = true
        end

        for model in pairs(entityCache) do
            if model and model.Parent and not getPlayerFromCharacter(model) then
                local visible = active[model] == true
                enemyRenderVisibility[model] = visible

                local highlight = model:FindFirstChild(HIGHLIGHT_TAG)
                if highlight and highlight:IsA("Highlight") then
                    if highlight.Enabled ~= visible then highlight.Enabled = visible end
                end

                if SHOW_NAMES then
                    local billboard = model:FindFirstChild(NAME_TAG)
                    if billboard and billboard:IsA("BillboardGui") then
                        if billboard.Enabled ~= visible then billboard.Enabled = visible end
                    end
                end
            end
        end
    end

    local function createHighlight(model, color)
        if not model or not model.Parent then return end

        local highlight = model:FindFirstChild(HIGHLIGHT_TAG)
        if not highlight then
            highlight = Instance.new("Highlight")
            highlight.Name = HIGHLIGHT_TAG
            highlight:SetAttribute(ESP_MODE_ATTRIBUTE, espMode)
            highlight.DepthMode = Enum.HighlightDepthMode.Occluded
            highlight.FillTransparency = 0.65
            highlight.OutlineTransparency = 0
            highlight.Parent = model
        end

        highlight.Adornee = model

        local visible = true
        if enemyMode then
            visible = enemyRenderVisibility[model]
            if visible == nil then
                visible = isEnemyWithinRenderDistance(model)
                enemyRenderVisibility[model] = visible
            end
        end

        if USE_MOBILE_FRIENDLY_DEPTHMODE then
            local depthMode = confirmedEnemies[model]
                and Enum.HighlightDepthMode.AlwaysOnTop
                or Enum.HighlightDepthMode.Occluded

            if highlight.DepthMode ~= depthMode then
                highlight.DepthMode = depthMode
            end
        end

        if highlight.Enabled ~= visible then highlight.Enabled = visible end
        if highlight.FillColor ~= color then highlight.FillColor = color end
        if highlight.OutlineColor ~= color then highlight.OutlineColor = color end
    end


    ------------------------------------------------------------
    -- NAME ESP (LUAS / INFINITE DISTANCE)
    ------------------------------------------------------------

    local function createNameESP(model, color)
        if not SHOW_NAMES then return end

        local billboard = model:FindFirstChild(NAME_TAG)
        local adornee = billboard and billboard.Adornee

        if not adornee or not adornee.Parent then
            local head = model:FindFirstChild("Head", true)
            local root = getRootPart(model)
            adornee = head or root
        end

        if not adornee then return end

        if not billboard then
            billboard = Instance.new("BillboardGui")
            billboard.Name = NAME_TAG
            billboard:SetAttribute(ESP_MODE_ATTRIBUTE, espMode)
            billboard.Size = UDim2.new(0, 220, 0, 35)
            billboard.StudsOffset = Vector3.new(0, 3, 0)
            billboard.AlwaysOnTop = true
            billboard.MaxDistance = math.huge
            billboard.Parent = model
        end

        local visible = true
        if enemyMode then
            visible = enemyRenderVisibility[model]
            if visible == nil then
                visible = isEnemyWithinRenderDistance(model)
                enemyRenderVisibility[model] = visible
            end
        end

        billboard.Enabled = visible
        billboard.Adornee = adornee
        billboard.MaxDistance = math.huge

        local label = billboard:FindFirstChild("NameLabel")
        if not label then
            label = Instance.new("TextLabel")
            label.Name = "NameLabel"
            label.BackgroundTransparency = 1
            label.Size = UDim2.new(1, 0, 1, 0)
            label.Font = Enum.Font.SourceSansBold
            label.TextSize = NAME_SIZE
            label.TextStrokeTransparency = 0
            label.TextStrokeColor3 = Color3.new(0, 0, 0)
            label.Parent = billboard
        end

        label.Text = getDisplayName(model)
        label.TextColor3 = color
    end


    ------------------------------------------------------------
    -- PLAYER ESP (SELALU HIJAU)
    ------------------------------------------------------------

    local function createPlayerHighlight(model, color)
        if not model or not model.Parent then return end

        local humanoid = model:FindFirstChildOfClass("Humanoid")
        if humanoid and humanoid.Health <= 0 then
            removeESP(model)
            return
        end

        local highlight = model:FindFirstChild("COLOR_ESP_PLAYER_HL")
        if not highlight then
            highlight = Instance.new("Highlight")
            highlight.Name = "COLOR_ESP_PLAYER_HL"
            highlight:SetAttribute(ESP_MODE_ATTRIBUTE, espMode)
            highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            highlight.FillTransparency = 0.65
            highlight.OutlineTransparency = 0
            highlight.Parent = model
        end

        highlight.Adornee = model
        highlight.Enabled = true
        highlight.FillColor = color
        highlight.OutlineColor = color
    end

    local function applyPlayerESP(model, player)
        if not playerMode or not model or not player then return end

        if player == LocalPlayer then
            removeESP(model)
            return
        end

        local humanoid = model:FindFirstChildOfClass("Humanoid")
        if humanoid and humanoid.Health <= 0 then
            removeESP(model)
            return
        end

        -- Semua player di-set Hijau
        local activeColor = PLAYER_COLOR

        createPlayerHighlight(model, activeColor)
        createNameESP(model, activeColor)

        if not playerESPConnections[model] then
            playerESPConnections[model] = model.AncestryChanged:Connect(function(_, parent)
                if not parent then
                    removeESP(model)
                end
            end)
        end
    end

    local function refreshPlayerESP(player, character)
        if not playerMode or not running or not player or player == LocalPlayer then
            return
        end

        character = character or player.Character
        if not character or not character.Parent then return end

        registerPlayerCharacter(player, character)
        applyPlayerESP(character, player)
    end

    local function schedulePlayerRefresh(player, character)
        task.spawn(function()
            local delays = { 0.05, 0.20, 0.50, 1.00, 2.00 }
            for _, delayTime in ipairs(delays) do
                if not running then break end
                task.wait(delayTime)
                if not running then break end

                if player.Character == character then
                    refreshPlayerESP(player, character)
                else
                    break
                end
            end
        end)
    end


    ------------------------------------------------------------
    -- APPLY ENEMY ESP
    ------------------------------------------------------------

    local function applyEnemyESP(model)
        if not enemyMode or not model or not model.Parent then return end

        if getPlayerFromCharacter(model) then
            removeESP(model)
            return
        end

        if not isPotentialEntity(model) then
            confirmedEnemies[model] = nil
            entityCache[model] = nil
            removeESP(model)
            return
        end

        entityCache[model] = true

        local color = confirmedEnemies[model] and ENEMY_COLOR or NPC_COLOR
        createHighlight(model, color)
        createNameESP(model, color)
    end

    local confirmEnemy

    local function applyESP(model)
        if not running then return end

        if playerMode then
            local player = getPlayerFromCharacter(model)
            if player and player ~= LocalPlayer then
                applyPlayerESP(model, player)
            end
            return
        end

        if not enemyMode or not model or not model.Parent or not model:IsA("Model") then
            return
        end

        if isLocalCharacter(model) then
            removeESP(model)
            return
        end

        if getPlayerFromCharacter(model) then return end

        if isPotentialEntity(model) then
            entityCache[model] = true
            applyEnemyESP(model)
        else
            if not confirmedEnemies[model] then
                entityCache[model] = nil
                removeESP(model)
            end
        end
    end

    confirmEnemy = function(model, reason)
        if not enemyMode or not model or not model.Parent then return end
        if getPlayerFromCharacter(model) or isLocalCharacter(model) then return end
        if not isPotentialEntity(model) then return end

        entityCache[model] = true

        if not confirmedEnemies[model] then
            confirmedEnemies[model] = true
            print("[ColorESP] Hostile confirmed:", model.Name, "| Reason:", reason)
        end

        applyEnemyESP(model)
    end


    ------------------------------------------------------------
    -- FIND NEAREST ENTITY
    ------------------------------------------------------------

    local function findNearestEntity(origin, radius)
        if not enemyMode or not origin then return nil end

        local nearest = nil
        local nearestDistanceSquared = radius * radius

        for model in pairs(entityCache) do
            if model and model.Parent and not getPlayerFromCharacter(model) and not isLocalCharacter(model) then
                local root = getRootPart(model)
                if root then
                    local offset = root.Position - origin
                    local distanceSquared = offset:Dot(offset)
                    if distanceSquared <= nearestDistanceSquared then
                        nearest = model
                        nearestDistanceSquared = distanceSquared
                    end
                end
            end
        end

        if nearest then return nearest end

        local overlapParams = OverlapParams.new()
        overlapParams.FilterType = Enum.RaycastFilterType.Exclude
        if LocalPlayer.Character then
            overlapParams.FilterDescendantsInstances = { LocalPlayer.Character }
        end

        local parts = Workspace:GetPartBoundsInRadius(origin, radius, overlapParams)
        for _, part in ipairs(parts) do
            local model = part:FindFirstAncestorOfClass("Model")
            if model and model.Parent and not getPlayerFromCharacter(model) and not isLocalCharacter(model) then
                if isPotentialEntity(model) then
                    local root = getRootPart(model)
                    if root then
                        local offset = root.Position - origin
                        local distanceSquared = offset:Dot(offset)
                        if distanceSquared <= nearestDistanceSquared then
                            nearest = model
                            nearestDistanceSquared = distanceSquared
                        end
                    end
                end
            end
        end

        return nearest
    end

    local function confirmFromDamage()
        if not enemyMode or not LocalPlayer.Character then return end
        local root = getRootPart(LocalPlayer.Character)
        if not root then return end

        local enemy = findNearestEntity(root.Position, DAMAGE_SEARCH_RADIUS)
        if enemy then confirmEnemy(enemy, "PLAYER_DAMAGE") end
    end

    local function triggerThreat(reason)
        if not enemyMode or not running then return end
        local now = os.clock()
        if now - lastThreatTime < THREAT_COOLDOWN then return end
        lastThreatTime = now

        print("[ColorESP] Threat detected:", reason)

        if LocalPlayer.Character then
            local root = getRootPart(LocalPlayer.Character)
            if root then
                local enemy = findNearestEntity(root.Position, THREAT_SEARCH_RADIUS)
                if enemy then confirmEnemy(enemy, "THREAT_" .. tostring(reason)) end
            end
        end
    end

    local function setupHealthMonitor(character)
        local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 5)
        if not humanoid then return end

        local previousHealth = humanoid.Health
        giveTask(humanoid.HealthChanged:Connect(function(newHealth)
            if not running then return end
            if newHealth < previousHealth then
                triggerThreat("DAMAGE")
                confirmFromDamage()
            end
            previousHealth = newHealth
        end))
    end

    local function setupLocalCharacter(character)
        task.spawn(function()
            local humanoid = character:WaitForChild("Humanoid", 5)
            if humanoid and running and enemyMode then setupHealthMonitor(character) end
            if running then removeESP(character) end
        end)
    end

------------------------------------------------------------
    -- LIGHTING & CAMERA EFFECTS
    ------------------------------------------------------------

    local effectSnapshot = {}

    local function getEffectKey(object)
        if object:IsA("BlurEffect") then return "Blur:" .. object:GetFullName() end
        if object:IsA("ColorCorrectionEffect") then return "Color:" .. object:GetFullName() end
        if object:IsA("DepthOfFieldEffect") then return "DOF:" .. object:GetFullName() end
        return nil
    end

    local function getEffectState(object)
        if object:IsA("BlurEffect") then return tostring(object.Size) end
        if object:IsA("ColorCorrectionEffect") then
            return table.concat({ tostring(object.Brightness), tostring(object.Contrast), tostring(object.Saturation), tostring(object.TintColor) }, "|")
        end
        if object:IsA("DepthOfFieldEffect") then
            return table.concat({ tostring(object.FarIntensity), tostring(object.FocusDistance), tostring(object.InFocusRadius), tostring(object.NearIntensity) }, "|")
        end
        return ""
    end

    local function scanPostEffects()
        if not enemyMode then return end
        for _, object in ipairs(Lighting:GetChildren()) do
            local key = getEffectKey(object)
            if key then
                local state = getEffectState(object)
                local previous = effectSnapshot[key]
                if previous == nil then effectSnapshot[key] = state
                elseif previous ~= state then
                    effectSnapshot[key] = state
                    triggerThreat(object.ClassName)
                end
            end
        end

        local camera = Workspace.CurrentCamera
        if camera then
            for _, object in ipairs(camera:GetChildren()) do
                local key = getEffectKey(object)
                if key then
                    local state = getEffectState(object)
                    local previous = effectSnapshot[key]
                    if previous == nil then effectSnapshot[key] = state
                    elseif previous ~= state then
                        effectSnapshot[key] = state
                        triggerThreat(object.ClassName)
                    end
                end
            end
        end
    end

    giveTask(Lighting.ChildAdded:Connect(function(object)
        if object:IsA("BlurEffect") or object:IsA("ColorCorrectionEffect") or object:IsA("DepthOfFieldEffect") then
            task.wait(0.05)
            if running then triggerThreat("NEW_" .. object.ClassName) end
        end
    end))

    local function watchCamera(camera)
        if not camera then return end
        giveTask(camera.ChildAdded:Connect(function(object)
            if object:IsA("BlurEffect") or object:IsA("ColorCorrectionEffect") or object:IsA("DepthOfFieldEffect") then
                task.wait(0.05)
                if running then triggerThreat("CAMERA_" .. object.ClassName) end
            end
        end))
    end

    watchCamera(Workspace.CurrentCamera)

------------------------------------------------------------
    -- CAMERA SHAKE & FOV LISTENERS
    ------------------------------------------------------------

    local previousCameraCFrame = Workspace.CurrentCamera and Workspace.CurrentCamera.CFrame
    local shakeWindowStart = 0
    local shakeSamples = 0
    local SHAKE_WINDOW = 0.22
    local SHAKE_REQUIRED_SAMPLES = 3
    local SHAKE_RADIUS = 35
    local SHAKE_ANGLE = math.rad(7)
    local shakeLastSample = 0

    local lastManualCameraInput = -math.huge
    local MANUAL_CAMERA_GRACE = 0.40

    if UserInputService.TouchEnabled then
        giveTask(UserInputService.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch then lastManualCameraInput = os.clock() end
        end))
        giveTask(UserInputService.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch then lastManualCameraInput = os.clock() end
        end))
    end

    giveTask(RunService.Heartbeat:Connect(function()
        if not running then return end
        local now = os.clock()
        if now - (shakeLastSample or 0) < 0.10 then return end
        shakeLastSample = now

        local camera = Workspace.CurrentCamera
        if not camera then return end
        local current = camera.CFrame

        if UserInputService.TouchEnabled and now - lastManualCameraInput < MANUAL_CAMERA_GRACE then
            previousCameraCFrame = current
            shakeSamples = 0
            shakeWindowStart = now
            return
        end

        if previousCameraCFrame then
            local relative = previousCameraCFrame:ToObjectSpace(current)
            local rx, ry, rz = relative:ToOrientation()
            local angle = math.max(math.abs(rx), math.abs(ry), math.abs(rz))

            if angle >= SHAKE_ANGLE then
                if now - shakeWindowStart > SHAKE_WINDOW then
                    shakeWindowStart = now
                    shakeSamples = 1
                else
                    shakeSamples = shakeSamples + 1
                end

                if shakeSamples >= SHAKE_REQUIRED_SAMPLES then
                    local character = LocalPlayer.Character
                    local root = character and getRootPart(character)
                    if root then
                        local enemy = findNearestEntity(root.Position, SHAKE_RADIUS)
                        if enemy then confirmEnemy(enemy, "CAMERA_SHAKE") end
                    end
                    shakeSamples = 0
                    shakeWindowStart = now
                end
            end
        end

        previousCameraCFrame = current
    end))

    local previousFOV = Workspace.CurrentCamera and Workspace.CurrentCamera.FieldOfView or 70
    local fovLastSample = 0

    giveTask(RunService.Heartbeat:Connect(function()
        if not running then return end
        local now = os.clock()
        if now - (fovLastSample or 0) < 0.10 then return end
        fovLastSample = now

        local currentCamera = Workspace.CurrentCamera
        if not currentCamera then return end

        local currentFOV = currentCamera.FieldOfView
        if math.abs(currentFOV - previousFOV) >= 4 then
            triggerThreat("FOV_CHANGE")
        end
        previousFOV = currentFOV
    end))

------------------------------------------------------------
    -- HEARTBEAT LOOPS & REPAIR SCANS
    ------------------------------------------------------------

    local effectTimer = 0
    giveTask(RunService.Heartbeat:Connect(function(deltaTime)
        if not running then return end
        effectTimer = effectTimer + deltaTime
        if effectTimer >= 0.15 then
            effectTimer = 0
            scanPostEffects()
        end
    end))

    giveTask(RunService.Heartbeat:Connect(function(deltaTime)
        if not running or not enemyMode then return end
        enemyRenderTimer = enemyRenderTimer + deltaTime
        if enemyRenderTimer < ENEMY_RENDER_UPDATE then return end
        enemyRenderTimer = 0
        updateEnemyRenderVisibility()
    end))

    local repairTimer = 0
    local REPAIR_INTERVAL = 1.0

    giveTask(RunService.Heartbeat:Connect(function(deltaTime)
        if not running then return end
        repairTimer = repairTimer + deltaTime
        if repairTimer < REPAIR_INTERVAL then return end
        repairTimer = 0

        if playerMode then
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer then
                    local character = player.Character
                    if character and character.Parent then
                        registerPlayerCharacter(player, character)
                        applyPlayerESP(character, player)
                    end
                end
            end
        end

        if enemyMode then
            for model, confirmed in pairs(confirmedEnemies) do
                if confirmed and model and model.Parent then
                    local highlight = model:FindFirstChild(HIGHLIGHT_TAG)
                    local nameTag = SHOW_NAMES and model:FindFirstChild(NAME_TAG) or true
                    if not highlight or not nameTag then applyEnemyESP(model) end
                else
                    confirmedEnemies[model] = nil
                    entityCache[model] = nil
                end
            end
        end
    end))


    ------------------------------------------------------------
    -- LISTENERS & INITIAL SCANS
    ------------------------------------------------------------

    local function processInstance(instance)
        if not enemyMode or not running then return end
        local model = getModelFromInstance(instance)
        if not model or not model.Parent then return end
        if pendingModels[model] then return end

        pendingModels[model] = true
        task.delay(0.05, function()
            pendingModels[model] = nil
            if running and model.Parent then applyESP(model) end
        end)
    end

    if playerMode then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                if player.Character then registerPlayerCharacter(player, player.Character) end

                giveTask(player.CharacterAdded:Connect(function(character)
                    registerPlayerCharacter(player, character)
                    schedulePlayerRefresh(player, character)
                end))

                if player.Character then
                    refreshPlayerESP(player, player.Character)
                    schedulePlayerRefresh(player, character)
                end
            end
        end

        giveTask(Players.PlayerAdded:Connect(function(player)
            if player == LocalPlayer then return end
            giveTask(player.CharacterAdded:Connect(function(character)
                registerPlayerCharacter(player, character)
                task.spawn(function()
                    task.wait(0.15)
                    if running and character.Parent then
                        applyPlayerESP(character, player)
                    end
                end)
            end))
        end))

        giveTask(Players.PlayerRemoving:Connect(function(player)
            local character = player.Character
            if character then removeESP(character) end
            playerCharacters[player] = nil
            if character then
                characterPlayers[character] = nil
                playerESPParts[character] = nil
                if playerESPConnections[character] then
                    pcall(function() playerESPConnections[character]:Disconnect() end)
                    playerESPConnections[character] = nil
                end
            end
        end))
    end

    if enemyMode then
        task.spawn(function()
            local descendants = Workspace:GetDescendants()
            local processed = 0
            for _, instance in ipairs(descendants) do
                if not running then break end
                if instance:IsA("Model") then
                    applyESP(instance)
                    processed = processed + 1
                    if processed % 40 == 0 then task.wait() end
                end
            end
        end)

        giveTask(Workspace.DescendantAdded:Connect(function(instance)
            processInstance(instance)
        end))
    end

    if enemyMode and LocalPlayer.Character then
        setupLocalCharacter(LocalPlayer.Character)
    end

    giveTask(LocalPlayer.CharacterAdded:Connect(function(character)
        task.wait(0.15)
        if running then
            removeESP(character)
            if enemyMode then setupLocalCharacter(character) end
        end
    end))

    if enemyMode then
        giveTask(Workspace.DescendantRemoving:Connect(function(instance)
            if confirmedEnemies[instance] then confirmedEnemies[instance] = nil end
            entityCache[instance] = nil
            enemyRenderVisibility[instance] = nil
            rootPartCache[instance] = nil
            pendingModels[instance] = nil

            if playerESPConnections[instance] then
                pcall(function() playerESPConnections[instance]:Disconnect() end)
                playerESPConnections[instance] = nil
            end
            playerESPParts[instance] = nil
        end))
    end

------------------------------------------------------------
    -- UNLOAD & CONTROL
    ------------------------------------------------------------

    local function unload()
        if not running then return end
        running = false

        for _, instance in ipairs(Workspace:GetDescendants()) do
            local belongsToThisMode = instance:GetAttribute(ESP_MODE_ATTRIBUTE) == espMode
            if belongsToThisMode and instance:IsA("Highlight") and (instance.Name == HIGHLIGHT_TAG or instance.Name == "COLOR_ESP_PLAYER_HL") then
                pcall(function() instance:Destroy() end)
            elseif belongsToThisMode and instance:IsA("BillboardGui") and instance.Name == NAME_TAG then
                pcall(function() instance:Destroy() end)
            end
        end

        confirmedEnemies = {}
        playerCharacters = {}
        characterPlayers = {}
        entityCache = {}
        pendingModels = {}
        playerESPParts = {}
        rootPartCache = {}

        for character, connection in pairs(playerESPConnections) do
            pcall(function() connection:Disconnect() end)
            playerESPConnections[character] = nil
        end

        cleanup()

        if control then pcall(function() control:Destroy() end) end
        print("ColorESP v3.0 unloaded.")
    end

    giveTask(control.Event:Connect(unload))

    print("--------------------------------")
    print("ColorESP v3.0 Original Clean Loaded.")
    print("Mode            :", string.upper(espMode))
    print("Player Color    : GREEN (All)")
    print("Name Distance   : INFINITE")
    print("--------------------------------")
end

local Plugin = {
    ["PluginName"] = "ColorESP v3.0",
    ["PluginDescription"] = "Original Clean Player ESP and Enemy/NPC ESP.",
    ["Commands"] = {
        ["pesp"] = {
            ["ListName"] = "pesp",
            ["Description"] = "Player ESP (All Green, Infinite Range).",
            ["Aliases"] = {"pesp"},
            ["Function"] = function(args, speaker) startColorESP(args, speaker, "player") end
        },
        ["eesp"] = {
            ["ListName"] = "eesp",
            ["Description"] = "Enemy/NPC ESP only.",
            ["Aliases"] = {"eesp"},
            ["Function"] = function(args, speaker) startColorESP(args, speaker, "enemy") end
        },
        ["unloadColorESP"] = {
            ["ListName"] = "unloadColorESP",
            ["Description"] = "Unloads the active PESP/EESP mode.",
            ["Aliases"] = {"un", "unloadesp", "stopcoloresp", "stopesp", "uncesp"},
            ["Function"] = function(args, speaker)
                local Players = game:GetService("Players")
                local LocalPlayer = Players.LocalPlayer
                if not LocalPlayer then warn("No LocalPlayer found.") return end

                local unloaded = false
                for _, mode in ipairs({"player", "enemy"}) do
                    local event = LocalPlayer:FindFirstChild("COLOR_ESP_PLUGIN_RUNNING_" .. mode)
                    if event and event:IsA("BindableEvent") then
                        unloaded = true
                        pcall(function() event:Fire() end)
                    end
                end

                if unloaded then
                    print("ColorESP PESP/EESP unload signal sent.")
                else
                    print("No running ColorESP instance found.")
                end
            end
        }
    }
}

return Plugin

