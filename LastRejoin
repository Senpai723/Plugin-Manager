local Plugin = {
    ["PluginName"] = "Rejoin Target Server",
    ["PluginDescription"] = "Simpan JobId server game saat ini dan rejoin kembali walaupun sudah di lobby.",
    ["Commands"] = {
        ["saveserver"] = {
            ["ListName"] = "saveserver / saveplace",
            ["Description"] = "Menyimpan JobId & PlaceId server tempat mabar saat ini.",
            ["Aliases"] = {"sserver", "savegame"},
            ["Function"] = function(args, speaker)
                if game.JobId ~= "" then
                    _G.SavedPlaceId = game.PlaceId
                    _G.SavedJobId = game.JobId
                    
                    notify("Save Server", "Berhasil menyimpan Server!\nPlaceId: " .. tostring(game.PlaceId))
                    print("[RejoinScript] Server Saved: " .. game.JobId)
                else
                    notify("Save Server", "Gagal! Lu lagi ga ada di dalam match / JobId kosong.")
                end
            end
        },
        ["rejoinlast"] = {
            ["ListName"] = "rejoinlast / rjlast",
            ["Description"] = "Teleport kembali ke server game tempat mabar tadi dari lobby.",
            ["Aliases"] = {"rjlast", "backtogame", "rejointarget"},
            ["Function"] = function(args, speaker)
                if not _G.SavedJobId or _G.SavedJobId == "" then
                    notify("Rejoin Error", "Belum ada server yang disimpan! Gunakan ;saveserver dulu pas di ingame.")
                    return
                end

                notify("Rejoining...", "Sedang mencoba masuk balik ke server mabar...")
                
                local TeleportService = game:GetService("TeleportService")
                local Players = game:GetService("Players")

                pcall(function()
                    TeleportService:TeleportToPlaceInstance(_G.SavedPlaceId, _G.SavedJobId, Players.LocalPlayer)
                end)
            end
        },
        ["autosaveserver"] = {
            ["ListName"] = "autosaveserver / autosave",
            ["Description"] = "Otomatis merekam PlaceId & JobId saat lu masuk ke dalam server match.",
            ["Aliases"] = {"autosave"},
            ["Function"] = function(args, speaker)
                if game.JobId ~= "" then
                    _G.SavedPlaceId = game.PlaceId
                    _G.SavedJobId = game.JobId
                    notify("AutoSave Active", "Server saat ini otomatis tersimpan!")
                else
                    notify("AutoSave", "Gagal! Harus diaktifkan pas udah di dalam server game.")
                end
            end
        }
    }
}

-- Otomatis simpan server jika ditaruh/dieksekusi saat sudah di dalam match
if game.JobId ~= "" then
    _G.SavedPlaceId = game.PlaceId
    _G.SavedJobId = game.JobId
end

return Plugin
