local Plugin = {
    ["PluginName"] = "Anti-AFK",
    ["PluginDescription"] = "Cegah idle 20 menit agar tidak ter-kick dari game.",
    ["Commands"] = {
        ["antiafk"] = {
            ["ListName"] = "antiafk / idle",
            ["Description"] = "Mengaktifkan Anti-AFK",
            ["Aliases"] = {"idle", "afk"},
            ["Function"] = function(args, speaker)
                if _G.AntiAfkConnection then
                    notify("Anti-AFK", "Anti-AFK sudah aktif!")
                    return
                end

                local VirtualUser = game:GetService("VirtualUser")
                local Players = game:GetService("Players")

                -- Event Idled dipanggil Roblox saat pemain diam mendekati limit waktu
                _G.AntiAfkConnection = Players.LocalPlayer.Idled:Connect(function()
                    VirtualUser:CaptureController()
                    VirtualUser:ClickButton2(Vector2.new(0, 0))
                    print("[Anti-AFK] Berhasil mencegah kick AFK!")
                end)

                notify("Anti-AFK", "Anti-AFK BERHASIL DIAKTIFKAN!")
            end
        },
        ["unantiafk"] = {
            ["ListName"] = "unantiafk / unidle",
            ["Description"] = "Mematikan Anti-AFK",
            ["Aliases"] = {"unidle", "unafk"},
            ["Function"] = function(args, speaker)
                if _G.AntiAfkConnection then
                    _G.AntiAfkConnection:Disconnect()
                    _G.AntiAfkConnection = nil
                    notify("Anti-AFK", "Anti-AFK DIMATIKAN!")
                else
                    notify("Anti-AFK", "Anti-AFK belum aktif.")
                end
            end
        }
    }
}

return Plugin
