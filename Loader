                -- 1. Sub-Menu Interactable
                local function openInteractableSubMenu()
                    local list = {
                        { Name = "PPESP", Desc = "Proximity Prompt ESP", Action = function(state)
                            pcall(function()
                                if not loadedInteractableModule then loadedInteractableModule = loadstring(game:HttpGet(RAW_INTERACTABLE))() end
                                local cmd = loadedInteractableModule.Commands[state and "proximityesp" or "unproximityesp"]
                                if cmd then task.spawn(function() cmd.Function({}, speaker) end) end
                            end)
                        end},
                        { Name = "ITP", Desc = "Item Teleport Window", Action = function(state)
                            pcall(function()
                                if not loadedInteractableModule then loadedInteractableModule = loadstring(game:HttpGet(RAW_INTERACTABLE))() end
